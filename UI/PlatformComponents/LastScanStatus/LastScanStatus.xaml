<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MostaqlK.UI.PlatformComponents.LastScanStatus.LastScanStatus"
             x:Name="Root">

    <!-- One row: the wording, then an optional refresh affordance. The footer shows the glyph, the
         pipeline dashboard's discovery card does not - everything else about the two is identical,
         which is exactly why this is one unit instead of two hand-written labels. -->
    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
        <Label x:Name="TextLabel"
               FontFamily="Tajawal"
               LineBreakMode="TailTruncation"
               MaxLines="1"
               VerticalOptions="Center"
               FontSize="{Binding FontSize, Source={x:Reference Root}}"
               TextColor="{Binding TextColor, Source={x:Reference Root}}" />

        <!-- Transparent Button over the glyph: a Label + TapGestureRecognizer never surfaces an
             AutomationId to the Windows UIA tree (dotnet/maui#4715). -->
        <Grid x:Name="RefreshHost" WidthRequest="20" HeightRequest="20" IsVisible="False">
            <Label x:Name="RefreshGlyph"
                   Text="↻"
                   FontFamily="Tajawal"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   FontSize="{Binding FontSize, Source={x:Reference Root}}"
                   TextColor="{Binding TextColor, Source={x:Reference Root}}" />
            <Button x:Name="RefreshButton"
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    Text=""
                    Padding="0"
                    Margin="0"
                    Clicked="OnRefreshClicked" />
        </Grid>
    </HorizontalStackLayout>

</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:MostaqlK.UI.PlatformComponents"
             xmlns:ds="clr-namespace:MostaqlK.UI.DesignSystem"
             x:Class="MostaqlK.UI.PlatformComponents.SourceLinkButton"
             FlowDirection="RightToLeft">

    <ds:PressableBorder Style="{StaticResource OutlineChipButtonStyle}">
        <ds:PressableBorder.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Command, Source={RelativeSource AncestorType={x:Type components:SourceLinkButton}}}" />
        </ds:PressableBorder.GestureRecognizers>
        <HorizontalStackLayout Spacing="6" InputTransparent="True">
            <components:AppIcon x:Name="LinkIcon"
                                Icon="Link"
                                FontSize="12"
                                TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}"
                                VerticalOptions="Center" />
            <Label x:Name="LinkLabel"
                   Text="عرض في المصدر"
                   FontSize="12"
                   FontFamily="TajawalBold"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" />
        </HorizontalStackLayout>
    </ds:PressableBorder>
</ContentView>

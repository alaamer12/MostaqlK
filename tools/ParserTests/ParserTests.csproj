<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>ParserTests</RootNamespace>
		<AssemblyName>ParserTests</AssemblyName>
		<InvariantGlobalization>false</InvariantGlobalization>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="HtmlAgilityPack" Version="1.11.65" />
	</ItemGroup>

	<!-- The parser is a pure, MAUI-free part of the app, so it is linked in from source rather
	     than referenced through MostaqlK.csproj: that project targets net10.0-windows and pulls
	     in the whole MAUI stack, which would make this harness slow to build and impossible to
	     run headlessly. Only the files the parser actually needs are linked. -->
	<ItemGroup>
		<Compile Include="..\..\Core\Formatting\ArabicNameFormatter.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Formatting\ArabicProposalParser.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Formatting\ArabicRelativeTime.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Formatting\BudgetFormatter.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Formatting\PipelineTelemetryFormatter.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Formatting\TextTruncator.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Utilities\StringNormalization.cs" LinkBase="Core" />
		<!-- Models gained a SourceId field in the composite-identity step; the value object is
		     dependency-free, so it is linked here for the same reason the models are. -->
		<Compile Include="..\..\Core\Sources\SourceId.cs" LinkBase="Core" />
		<Compile Include="..\..\Sources\Mostaql\Parsing\DetailParser.cs" LinkBase="Parsers" />
		<Compile Include="..\..\Sources\Mostaql\Parsing\ListingParser.cs" LinkBase="Parsers" />
		<Compile Include="..\..\Sources\Mostaql\Parsing\StructuralExtractor.cs" LinkBase="Parsers" />
		<Compile Include="..\..\Sources\Mostaql\Parsing\InferenceEngine.cs" LinkBase="Parsers" />
		<Compile Include="..\..\Sources\Mostaql\Parsing\ParseErrors.cs" LinkBase="Parsers" />
		<Compile Include="..\..\Sources\Mostaql\Parsing\ParseException.cs" LinkBase="Parsers" />
		<Compile Include="..\..\Infrastructure\Http\CookieParser.cs" LinkBase="Http" />
		<Compile Include="..\..\Models\ProjectDetails.cs" LinkBase="Models" />
		<Compile Include="..\..\Models\ProjectSummary.cs" LinkBase="Models" />
		<Compile Include="..\..\Models\Owner.cs" LinkBase="Models" />
		<Compile Include="..\..\Models\ProjectSkill.cs" LinkBase="Models" />
		<Compile Include="..\..\Models\Asset.cs" LinkBase="Models" />
		<Compile Include="..\..\Models\EnrichmentStatus.cs" LinkBase="Models" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>

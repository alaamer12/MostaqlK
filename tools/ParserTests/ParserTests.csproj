<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>ParserTests</RootNamespace>
		<AssemblyName>ParserTests</AssemblyName>
		<InvariantGlobalization>false</InvariantGlobalization>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="HtmlAgilityPack" Version="1.11.65" />
	</ItemGroup>

	<!-- The parser is a pure, MAUI-free part of the app, so it is linked in from source rather
	     than referenced through MostaqlK.csproj: that project targets net10.0-windows and pulls
	     in the whole MAUI stack, which would make this harness slow to build and impossible to
	     run headlessly. Only the files the parser actually needs are linked. -->
	<ItemGroup>
		<Compile Include="..\..\Core\Formatting\ArabicNameFormatter.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Formatting\ArabicProposalParser.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Formatting\ArabicRelativeTime.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Formatting\BudgetFormatter.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Formatting\PipelineTelemetryFormatter.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Formatting\TextTruncator.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Utilities\StringNormalization.cs" LinkBase="Core" />
		<!-- The generalized analysis engines + vocabulary data types (A1): the parsers are only
		     usable together with these, so they are linked like the rest of the parser stack. -->
		<Compile Include="..\..\Core\Parsing\ParseProfile.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Parsing\SelectorMap.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Parsing\HtmlStructureEngine.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Parsing\FieldInferenceEngine.cs" LinkBase="Core" />
		<!-- Models gained a SourceId field in the composite-identity step; the value object is
		     dependency-free, so it is linked here for the same reason the models are. -->
		<Compile Include="..\..\Core\Sources\SourceId.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Sources\SourceProjectId.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Sources\BrandTokenSet.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Sources\SourceCapabilities.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Sources\ISourceDescriptor.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Sources\FieldSpec.cs" LinkBase="Core" />
		<!-- B3: the descriptor now exposes the typed facet vocabulary, so the pure spec record links
		     alongside it (the nafezly/mostaql facet tests below drive it). -->
		<Compile Include="..\..\Core\Sources\FilterFacetSpec.cs" LinkBase="Core" />
		<!-- Layered-isolability Step 0: the resolver is pure logic; it links with the channel
		     identity it reads (stable variant — the harness never builds canary). -->
		<Compile Include="..\..\Core\Layers\LayerAxis.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Layers\LayerKey.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Layers\LayerRegistration.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Layers\LayerExceptions.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Layers\LayerResolver.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Layers\LayerContext.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Platform\ChannelIdentity.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Platform\ChannelIdentity.Stable.cs" LinkBase="Core" />
		<!-- Step 2: the settings descriptor contract + catalog composition. Pure data + the
		     resolver, so the merge/override/visibility rules are proven offline against the REAL
		     source descriptors (DetailSchemaRenderer precedent). -->
		<Compile Include="..\..\Core\Sources\SettingsDescriptor.cs" LinkBase="Core" />
		<Compile Include="..\..\Features\Settings\SettingsCatalog.cs" LinkBase="Features" />
		<Compile Include="..\..\Features\Settings\SettingsCatalog.Builtin.cs" LinkBase="Features" />
		<!-- Step 4: the centralized validator is pure descriptor-over-data logic, so the bounds
		     and Arabic message templates the settings screen enforces are checked offline. -->
		<Compile Include="..\..\Features\Settings\SettingsValidator.cs" LinkBase="Features" />
		<!-- B4: the schema-driven details renderer is MAUI-free (descriptor + models + Core/Formatting
		     only), so it links here and its ordering / null-omission / capability gating / money flags
		     are verified offline against the real descriptors. -->
		<Compile Include="..\..\Features\Projects\ViewModels\DetailSchemaRenderer.cs" LinkBase="Features" />
		<!-- ISourceDescriptor now exposes SchemaMap/Profile/Selectors, so the Mostaql data the
		     descriptor returns must link alongside it. -->
		<Compile Include="..\..\Sources\Mostaql\MostaqlParseProfile.cs" LinkBase="Sources" />
		<Compile Include="..\..\Sources\Mostaql\MostaqlSelectors.cs" LinkBase="Sources" />
		<Compile Include="..\..\Sources\Mostaql\MostaqlSource.cs" LinkBase="Sources" />
		<Compile Include="..\..\Sources\Mostaql\Parsing\DetailParser.cs" LinkBase="Parsers" />
		<Compile Include="..\..\Sources\Mostaql\Parsing\ListingParser.cs" LinkBase="Parsers" />
		<Compile Include="..\..\Sources\Mostaql\Parsing\StructuralExtractor.cs" LinkBase="Parsers" />
		<Compile Include="..\..\Sources\Mostaql\Parsing\ParseErrors.cs" LinkBase="Parsers" />
		<Compile Include="..\..\Sources\Mostaql\Parsing\ParseException.cs" LinkBase="Parsers" />
		<!-- Nafezly source module (A3): the descriptor + its parse-profile/selector data, the thin
		     nafezly parsers (which drive the same shared Core/Parsing engines), and the JSON-LD + query/
		     state vocabulary. Fetched/DI/MAUI-bound files (NafezlyFetcher, services, module) stay out —
		     only the offline-parsable parts are linked, exactly like Mostaql's parser subset. -->
		<Compile Include="..\..\Sources\Nafezly\NafezlySource.cs" LinkBase="Sources" />
		<Compile Include="..\..\Sources\Nafezly\NafezlyParseProfile.cs" LinkBase="Sources" />
		<Compile Include="..\..\Sources\Nafezly\NafezlySelectors.cs" LinkBase="Sources" />
		<Compile Include="..\..\Sources\Nafezly\NafezlyQueryVocabulary.cs" LinkBase="Sources" />
		<Compile Include="..\..\Sources\Nafezly\NafezlyStates.cs" LinkBase="Sources" />
		<Compile Include="..\..\Sources\Nafezly\Parsing\NafezlyJsonLd.cs" LinkBase="Parsers" />
		<Compile Include="..\..\Sources\Nafezly\Parsing\NafezlyListingParser.cs" LinkBase="Parsers" />
		<Compile Include="..\..\Sources\Nafezly\Parsing\NafezlyDetailParser.cs" LinkBase="Parsers" />
		<Compile Include="..\..\Sources\Nafezly\Parsing\NafezlyParseErrors.cs" LinkBase="Parsers" />
		<Compile Include="..\..\Sources\Nafezly\Parsing\NafezlyParseException.cs" LinkBase="Parsers" />
		<!-- Contribution seam (contract §10): the registry + the ONE real nafezly settings-section
		     contribution are linkable with only SourceId/ISettingsRepository, proving per-source growth
		     without pulling in DI or the MAUI stack. -->
		<Compile Include="..\..\Core\Sources\ISettingsRepository.cs" LinkBase="Core" />
		<!-- System/Platform split step 0: the scope→container seam is pure interface-over-interface
		     logic, so routing a read/write through it is proven offline (FakeSettingsRepository) and
		     the call-site lint can compare every SettingsKeys use against the catalog's scope. -->
		<Compile Include="..\..\Core\Sources\ScopedSettings.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Sources\SourceContributions.cs" LinkBase="Core" />
		<Compile Include="..\..\Sources\Nafezly\Contributions\NafezlySettingsContribution.cs" LinkBase="Sources" />
		<Compile Include="..\..\Infrastructure\Http\CookieParser.cs" LinkBase="Http" />
		<!-- v3 Step 1 read model: SourceFeedStore is MAUI-free (its DB seam is the linkable
		     IProjectRepository interface + delegates), so the pure coalescing / generation-cancel /
		     state-machine / warm-peer-prefetch logic links and is verified headlessly, exactly like
		     the DetailSchemaRenderer precedent. -->
		<Compile Include="..\..\Core\Result.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\DomainError.cs" LinkBase="Core" />
		<Compile Include="..\..\Infrastructure\Database\IProjectRepository.cs" LinkBase="Infrastructure" />
		<Compile Include="..\..\Services\SourceFeedStore.cs" LinkBase="Services" />
		<Compile Include="..\..\Models\ProjectDetails.cs" LinkBase="Models" />
		<Compile Include="..\..\Models\ProjectSummary.cs" LinkBase="Models" />
		<Compile Include="..\..\Models\Owner.cs" LinkBase="Models" />
		<Compile Include="..\..\Models\ProjectSkill.cs" LinkBase="Models" />
		<Compile Include="..\..\Models\Asset.cs" LinkBase="Models" />
		<Compile Include="..\..\Models\EnrichmentStatus.cs" LinkBase="Models" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>

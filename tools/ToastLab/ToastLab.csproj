<Project Sdk="Microsoft.NET.Sdk">

	<!--
		ToastLab: fires real Windows toasts without starting MostaqlK, so the notification's
		appearance can be iterated in seconds instead of by waiting for a scan to discover a new
		project while the app sits in the tray.

		It links the production code it is testing (the toast seam, the brand PNG writer and the
		source descriptors) the same way tools/ParserTests links Core — no reference to
		MostaqlK.csproj, which would drag in the whole MAUI stack. So what you see on screen is
		generated by the same methods the app runs, not by a reimplementation of them.

		It registers its OWN app-user-model-id (ToastLab.App) and its own Start Menu shortcut, and
		never touches MostaqlK's: a harness that borrowed the app's identity would overwrite the
		user's shortcut and silently break the app's real notifications.
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>ToastLab</RootNamespace>
		<AssemblyName>ToastLab</AssemblyName>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
	</PropertyGroup>

	<!-- The descriptors expose their parse profiles, and a profile references the shared parsing
	     engines, which are written against HtmlAgilityPack. Same package tools/ParserTests takes. -->
	<ItemGroup>
		<PackageReference Include="HtmlAgilityPack" Version="1.11.65" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\..\Core\Notifications\ToastBranding.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Notifications\BrandImageEncoder.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Notifications\BrandImageDecoder.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Notifications\BrandBadge.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Notifications\ToastAssets.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Sources\SourceId.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Sources\BrandTokenSet.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Sources\SourceCapabilities.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Sources\ISourceDescriptor.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Sources\FieldSpec.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Sources\FilterFacetSpec.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Parsing\ParseProfile.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Parsing\SelectorMap.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Parsing\HtmlStructureEngine.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Parsing\FieldInferenceEngine.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Utilities\StringNormalization.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Result.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\DomainError.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Formatting\ArabicNameFormatter.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Formatting\ArabicProposalParser.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Formatting\ArabicRelativeTime.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Formatting\BudgetFormatter.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Formatting\PipelineTelemetryFormatter.cs" LinkBase="Core" />
		<Compile Include="..\..\Core\Formatting\TextTruncator.cs" LinkBase="Core" />
		<Compile Include="..\..\Infrastructure\Http\CookieParser.cs" LinkBase="Core" />
		<Compile Include="..\..\Sources\Mostaql\MostaqlSource.cs" LinkBase="Sources" />
		<Compile Include="..\..\Sources\Mostaql\MostaqlParseProfile.cs" LinkBase="Sources" />
		<Compile Include="..\..\Sources\Mostaql\MostaqlSelectors.cs" LinkBase="Sources" />
		<Compile Include="..\..\Sources\Nafezly\NafezlySource.cs" LinkBase="Sources" />
		<Compile Include="..\..\Sources\Nafezly\NafezlyParseProfile.cs" LinkBase="Sources" />
		<Compile Include="..\..\Sources\Nafezly\NafezlySelectors.cs" LinkBase="Sources" />
		<Compile Include="..\..\Sources\Nafezly\NafezlyQueryVocabulary.cs" LinkBase="Sources" />
		<Compile Include="..\..\Sources\Nafezly\NafezlyStates.cs" LinkBase="Sources" />
	</ItemGroup>

</Project>

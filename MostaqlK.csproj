<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
		<SatelliteResourceLanguages>ar</SatelliteResourceLanguages>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>MostaqlK</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>MostaqlK</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.mostaqlk</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<EnableDefaultWinUICustomMain Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">false</EnableDefaultWinUICustomMain>
		<DefineConstants Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
	</PropertyGroup>

	<!-- Windows App SDK single-file EXE validation requires extra flags for unpackaged apps. -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' AND '$(PublishSingleFile)' == 'true'">
		<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
		<EnableMsixTooling>true</EnableMsixTooling>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<WindowsAppSdkUndockedRegFreeWinRTInitialize>true</WindowsAppSdkUndockedRegFreeWinRTInitialize>
	</PropertyGroup>



	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\Images\logo.png" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Images\logo.png" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\**\*.png;Resources\Images\**\*.jpg;Resources\Images\**\*.jpeg;Resources\Images\**\*.svg" Exclude="Resources\Images\logo.png" />
		<None Include="Resources\Images\logo.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		
		<!-- Additional Assets to preserve directory structure -->
		<Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- Target to clean up unwanted localization folders in Windows publish -->
	<Target Name="CleanupUnwantedLocales" AfterTargets="Publish" Condition="'$(RuntimeIdentifier.StartsWith(&quot;win&quot;))' == 'true'">
		<ItemGroup>
			<_UnwantedLocaleFolders Include="$([System.IO.Directory]::GetDirectories('$(PublishDir)'))" />
			<UnwantedLocaleFolders Include="@(_UnwantedLocaleFolders)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$([System.IO.Path]::GetFileName(&quot;%(Identity)&quot;))', '^[a-z]{2,3}(-[a-zA-Z0-9-]+)?$')) and '$([System.IO.Path]::GetFileName(&quot;%(Identity)&quot;))' != 'ar' and !$([System.String]::new('$([System.IO.Path]::GetFileName(&quot;%(Identity)&quot;))').StartsWith('ar-'))" />
		</ItemGroup>
		<Message Text="Removing unwanted locale folder: %(UnwantedLocaleFolders.Identity)" Importance="high" />
		<RemoveDir Directories="@(UnwantedLocaleFolders)" />
	</Target>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
		<!-- Microsoft.Data.Sqlite 10.0.10 transitively pulls in SQLitePCLRaw.bundle_e_sqlite3 2.1.11,
		     which bundles a pre-3.50.2 SQLite affected by a known high-severity vulnerability
		     (NU1903, GHSA-2m69-gcr7-jv3q / CVE-2025-6965). Pin a newer bundle directly to override
		     the transitive version until Microsoft.Data.Sqlite itself upgrades its dependency. -->
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<!-- DPAPI (ProtectedData) for the encrypted `app_secrets` store: the session cookie the
		     user uploads in Settings is protected with a key the OS derives from the current
		     Windows account, so the blob in mostaqlk.db is useless on another machine/user. -->
		<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" Condition="'$(Configuration)' == 'Debug'" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" Condition="'$(Configuration)' == 'Debug'" />
	</ItemGroup>

	<!-- Platforms\Windows\*.xaml would otherwise be auto-globbed as a native WinUI Page by the
	     WindowsAppSDK build tooling. There are currently no MAUI XAML resource files under
	     Platforms\Windows, but this exclusion is kept in place defensively in case one is added
	     later (see cross-platform-ui-conventions.md, Mechanism 1) - such a file must be applied via
	     compiled/merged XAML (e.g. referenced from App.xaml) or built in code, NOT via a
	     dynamically-loaded `ResourceDictionary.Source` Uri at runtime, since that is not supported
	     under this project's SourceGen XAML inflator and previously caused a native startup crash. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<Page Remove="Platforms\Windows\Styles\**\*.xaml" />
	</ItemGroup>

	<!-- Filename-based multi-targeting (see cross-platform-ui-conventions.md, Mechanism 1): a file
	     named MyType.Windows.cs / MyType.Android.cs / MyType.iOS.cs is only meant to compile for
	     its own platform. Contrary to some other SDK-style multi-target project setups, this is
	     NOT automatic for a MAUI single-project app - it must be configured explicitly, per
	     https://learn.microsoft.com/dotnet/maui/platform-integration/configure-multi-targeting.
	     Without this, e.g. PressableEffect.Android.cs and PressableEffect.iOS.cs would both be
	     compiled into the Windows build and collide as duplicate partial-method implementations. -->
	<ItemGroup Condition="$(TargetFramework.Contains('-android')) != true">
		<Compile Remove="**\*.Android.cs" />
		<Compile Remove="**\Android\**\*.cs" />
	</ItemGroup>
	<ItemGroup Condition="$(TargetFramework.Contains('-ios')) != true AND $(TargetFramework.Contains('-maccatalyst')) != true">
		<Compile Remove="**\*.MaciOS.cs" />
	</ItemGroup>
	<ItemGroup Condition="$(TargetFramework.Contains('-ios')) != true">
		<Compile Remove="**\*.iOS.cs" />
	</ItemGroup>
	<ItemGroup Condition="$(TargetFramework.Contains('-maccatalyst')) != true">
		<Compile Remove="**\*.MacCatalyst.cs" />
	</ItemGroup>
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'">
		<Compile Remove="**\*.Windows.cs" />
	</ItemGroup>

	<!-- tools\* holds standalone dev-utility console projects (each with its own .csproj, e.g.
	     tools\ErrorHandlingAudit\ErrorHandlingAudit.csproj) that are built independently, not as
	     part of the app. Without this exclusion their source files get swept into this project's
	     default Compile glob and fail to build here (they reference packages, like
	     Microsoft.CodeAnalysis.CSharp, that this app project does not and should not depend on). -->
	<ItemGroup>
		<Compile Remove="MostaqlK.UITests\**" />
		<EmbeddedResource Remove="MostaqlK.UITests\**" />
		<None Remove="MostaqlK.UITests\**" />
		<Compile Remove="tools\**" />
		<EmbeddedResource Remove="tools\**" />
		<None Remove="tools\**" />
	</ItemGroup>

	<!-- Dotnet watch exclusions to prevent FileSystemWatcher buffer overflow during multi-target builds -->
	<ItemGroup>
		<Watch Remove="bin\**" />
		<Watch Remove="obj\**" />
		<Watch Remove="scratch\**" />
		<Watch Remove="tools\**" />
		<Watch Remove=".repertoire\**" />
	</ItemGroup>

	<ItemGroup>
	</ItemGroup>

	<Target Name="BuildWin">
		<Exec Command="dotnet build MostaqlK.csproj -f net10.0-windows10.0.19041.0" StandardOutputImportance="High" StandardErrorImportance="High" />
	</Target>

	<Target Name="RunWin">
		<Exec Command="dotnet run -f net10.0-windows10.0.19041.0" StandardOutputImportance="High" StandardErrorImportance="High" />
	</Target>

	<Target Name="TestWin">
		<Exec Command="dotnet test MostaqlK.UITests/MostaqlK.UITests.csproj" StandardOutputImportance="High" StandardErrorImportance="High" />
	</Target>

	<Target Name="DeployWin">
		<Exec Command="dotnet publish MostaqlK.csproj -f net10.0-windows10.0.19041.0 -c Release -p:PublishReadyToRun=true" StandardOutputImportance="High" StandardErrorImportance="High" />
	</Target>

</Project>
<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ds="clr-namespace:MostaqlK.UI.DesignSystem">

    <!--
        Shared base style for AppButton (UI/PlatformComponents/AppButton), following Mechanism 1
        in cross-platform-ui-conventions.md: same shape everywhere, per-OS tweaks via
        Platforms/Windows/Styles/AppButtonStyle.Windows.xaml using Style.BasedOn.
    -->
    <Style x:Key="AppButtonBase" TargetType="Button">
        <Setter Property="TextColor" Value="{DynamicResource TextOnAccent}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
        <!-- The mockups' buttons are `font-medium` in Tajawal (design/mvp/*.html). -->
        <Setter Property="FontFamily" Value="TajawalMedium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource ControlTextDisabled}" />
                            <Setter Property="BackgroundColor" Value="{DynamicResource ControlFillDisabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
        <Style.Behaviors>
            <ds:PressableEffect ApplyHoverHighlight="False" />
        </Style.Behaviors>
    </Style>

    <!--
        Compact "outline chip" secondary-action button used where a full AppButtonBase would be
        too heavy (e.g. ProjectCard's "عرض في مستقل" link-out button): a Border (not a Button) so
        it can carry an icon + label pair, styled as a light accent-tinted pill with a hairline
        border. Targets ds:PressableBorder (not the plain Border) so every consumer gets its own,
        dedicated PressableEffect instance instead of one shared via Style.Behaviors - MAUI's docs
        warn stateful Style behaviors are shared across every control using the style, which broke
        hover/press for all but the last card when this style is repeated once per feed item.
    -->
    <Style x:Key="OutlineChipButtonStyle" TargetType="ds:PressableBorder">
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{DynamicResource AccentSoftStrokeBrush}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource AccentSoft}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="8" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Transparent button with accent text, used for secondary or auxiliary actions. -->
    <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonBase}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource Accent}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BorderColor" Value="{DynamicResource Accent}" />
    </Style>

</ResourceDictionary>

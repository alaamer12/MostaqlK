    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{DynamicResource ShellBackground}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{DynamicResource ShellBackground}" />
        <Setter Property="Shell.ForegroundColor" Value="{DynamicResource ShellInk}" />
        <Setter Property="Shell.TitleColor" Value="{DynamicResource ShellInk}" />
        <Setter Property="Shell.DisabledColor" Value="{DynamicResource ShellDisabled}" />
        <Setter Property="Shell.UnselectedColor" Value="{DynamicResource ShellUnselected}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{DynamicResource ShellTabBar}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{DynamicResource ShellTabAccent}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{DynamicResource ShellTabAccent}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{DynamicResource ControlInkAlt}" />
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{DynamicResource ShellBackground}" />
        <Setter Property="BarTextColor" Value="{DynamicResource NavigationBarInk}" />
        <Setter Property="IconColor" Value="{DynamicResource NavigationBarInk}" />
    </Style>

    <Style TargetType="TabbedPage">
        <Setter Property="BarBackgroundColor" Value="{DynamicResource TabBarBackground}" />
        <Setter Property="BarTextColor" Value="{DynamicResource ShellTabAccent}" />
        <Setter Property="UnselectedTabColor" Value="{DynamicResource ShellDisabled}" />
        <Setter Property="SelectedTabColor" Value="{DynamicResource ControlChromeDeep}" />
    </Style>

</ResourceDictionary>

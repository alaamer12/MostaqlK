<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MostaqlK"
             x:Class="MostaqlK.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />

                <!-- Design system component base styles (Mechanism 1, cross-platform-ui-conventions.md).
                     Platform-specific overrides (e.g. Platforms/Windows/Styles/AppButtonStyle.Windows.xaml)
                     are merged at runtime in App.xaml.cs, not here. -->
                <ResourceDictionary Source="Resources/Styles/AppButtonStyle.xaml" />
                <ResourceDictionary Source="Resources/Styles/AppCardStyle.xaml" />
                <ResourceDictionary Source="Resources/Styles/AppEntryStyle.xaml" />
                <ResourceDictionary Source="Resources/Styles/AppToggleStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

 <!-- Invisible full-size Button overlaid on each nav row's Border: a plain
             Border+TapGestureRecognizer never surfaces an AutomationId to the Windows UI
             Automation tree (dotnet/maui#4715), so the actual hit target/AutomationId now lives
             on this transparent Button instead, leaving the Border purely for visuals. -->
        <Style x:Key="SidebarNavRowHitTargetStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="Text" Value="" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
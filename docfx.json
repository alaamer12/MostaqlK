{
  "schema": 2,
  "build": {
    "content": [
      { "files": ["api/**.yml", "api/index.md"] },
      { "files": ["docs/**.md", "docs/**/toc.yml", "toc.yml", "*.md"], "exclude": ["AGENTS.md", "docfx.json"] }
    ],
    "globalMetadata": {
      "_appTitle": "MostaqlK Documentation",
      "_appFooter": "MostaqlK",
      "_enableSearch": true
    },
    "output": "_site",
    "template": ["default", "modern"],
    "postProcessors": ["ExtractSearchIndex"]
  },
  "metadata": [
    {
      "name": "MostaqlK",
      "src": [
        { "files": ["MostaqlK.csproj"] }
      ],
      "dest": "api",
      "globalProperties": {
        "TargetFramework": "net10.0-windows10.0.19041.0"
      }
    }
  ]
}

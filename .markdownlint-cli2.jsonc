{
  // Docs linting for markdownlint-cli2 (run: bunx markdownlint-cli2)
  "globs": ["*.md", "docs/**/*.md"],
  "ignores": ["_site/**", "api/**", "node_modules/**"],
  "config": {
    // Docs contain long tables, URLs and diff blocks — line length is not meaningful here
    "MD013": false,
    // Allow inline HTML (badges, <details> collapsibles)
    "MD033": false,
    // Allow duplicate section headings across different pages (e.g. "Context" in ADRs/postmortems)
    "MD024": { "siblings_only": true },
    // Mixed fence styles exist in older docs; enforce consistency only on new fixes
    "MD046": false,
    // Table pipes alignment churn is not worth the diff noise
    "MD055": false,
    "MD056": false,
    "MD058": false,
    // MD060 forces uniform pipe alignment in every table column — rewrites wide doc tables wholesale
    "MD060": false
  }
}

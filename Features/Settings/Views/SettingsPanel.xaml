<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MostaqlK.Features.Settings.ViewModels"
             xmlns:platform="clr-namespace:MostaqlK.UI.PlatformComponents"
             xmlns:sidebar="clr-namespace:MostaqlK.UI.PlatformComponents.AppSidebar"
             xmlns:ds="clr-namespace:MostaqlK.UI.DesignSystem"
             xmlns:services="clr-namespace:MostaqlK.Services"
             x:Class="MostaqlK.Features.Settings.Views.SettingsPanel"
             x:DataType="vm:SettingsViewModel"
             Title="الإعدادات"
             Shell.NavBarIsVisible="False"
             FlowDirection="RightToLeft"
             BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#020617}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Mockup input styling: rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-3 py-2.5 text-sm -->
            <Style x:Key="SettingsInputBorderStyle" TargetType="Border">
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Stroke" Value="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F8FAFC, Dark=#1E293B}" />
                <Setter Property="Padding" Value="12,2" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="8" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SettingsInputStyle" TargetType="InputView">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontFamily" Value="Tajawal" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#94A3B8, Dark=#64748B}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>

            <Style x:Key="SettingsPickerStyle" TargetType="Picker">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontFamily" Value="Tajawal" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>

            <!-- Card Specific Styles for Focus/Accent borders if we want to simulate them, 
                 but for now we'll stick to the base mockup state -->
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Layout mirrors settings.html: shared sidebar (AppSidebar) + a header bar + a single
         settings card. Rows mirror the app's actual configurable settings (poll interval,
         request rate, grouping mode/threshold, dark-mode toggle, and the "مشاريع مضافة اليوم"
         stat card, which also appears in the sidebar per the mockup). -->
    <!-- Colours follow the mockup's light/dark class pairs (bg-slate-100 dark:bg-slate-950 for the
         page, bg-white dark:bg-slate-900 for panels, border-slate-200 dark:border-slate-800). -->
    <Grid BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#020617}" ColumnDefinitions="Auto,*">

        <sidebar:AppSidebar Grid.Column="0"
                             ActivePage="Settings"
                             StatValue="{Binding GlobalStatus.ProjectsAddedTodayText}"
                             ProjectsClicked="OnProjectsNavClicked"
                             AdvancedSearchClicked="OnAdvancedSearchNavClicked"
                             SettingsClicked="OnSettingsNavClicked"
                             AboutClicked="OnAboutNavClicked" />

        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Padding="28,24,28,28" RowSpacing="18"
              BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#020617}">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <platform:AppIcon Icon="Gear" WidthRequest="24" HeightRequest="24" TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="الإعدادات" FontSize="24" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                    <Label Text="إدارة إعدادات التطبيق وسلوك المراقبة" FontSize="13" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontFamily="Tajawal" />
                </VerticalStackLayout>
            </Grid>
            <!-- MVP note: bg-blue-50 dark:bg-blue-500/10 with text-blue-700 dark:text-blue-300. -->
            <Border Grid.Row="1" BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#132239}" StrokeThickness="0" Padding="16,12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label Text="ملاحظة MVP: بعض الإعدادات المتقدمة ستُضاف في إصدارات لاحقة." FontSize="13" TextColor="{AppThemeBinding Light=#1D4ED8, Dark=#93C5FD}" FontFamily="Tajawal" />
            </Border>

            <ScrollView Grid.Row="2">
                <VerticalStackLayout Spacing="24">

                    <!-- v1/v2 note: bg-blue-50 dark:bg-blue-500/10 with text-blue-700 dark:text-blue-300. -->
                    <Border BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#132239}" StrokeThickness="0" Padding="16,12">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <HorizontalStackLayout Spacing="12">
                            <platform:AppIcon Icon="Info" WidthRequest="18" HeightRequest="18" TextColor="{AppThemeBinding Light=#1D4ED8, Dark=#93C5FD}" VerticalOptions="Start" />
                            <Label Text="الإعدادات الموسّعة في v1 و v2 — تحكّم بالفاصل الزمني للفحص، حد الطلبات، معدل التوازي، خيارات الأمان، استعلام الفحص، تنزيل المرفقات، وتجميع التنبيهات. التغييرات تُطبَّق من دورة الفحص التالية."
                                   FontSize="13" TextColor="{AppThemeBinding Light=#1D4ED8, Dark=#93C5FD}" FontFamily="Tajawal" LineBreakMode="WordWrap" />
                        </HorizontalStackLayout>
                    </Border>

                    <Label Text="{Binding ValidationMessage}"
                           TextColor="{AppThemeBinding Light=#DC2626, Dark=#F87171}"
                           FontSize="13"
                           IsVisible="{Binding HasValidationError}"
                           FontFamily="Tajawal" />

                    <!-- poll_interval card (Indigo) -->
                    <Border Padding="0" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <VerticalStackLayout>
                            <VerticalStackLayout Padding="24,16" Spacing="4">
                                <HorizontalStackLayout Spacing="8">
                                    <platform:AppIcon Icon="Stopwatch" TextColor="#6366F1" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                    <Label Text="الفاصل الزمني للفحص" FontSize="16" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                                </HorizontalStackLayout>
                                <Label Text="كل كم مدة يفحص التطبيق قائمة المشاريع بحثًا عن الجديد" FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontFamily="Tajawal" />
                            </VerticalStackLayout>
                            
                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F1F5F9, Dark=#1E293B}" />

                            <VerticalStackLayout Padding="24,20" Spacing="16">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="الفاصل الزمني للفحص (فترة التحديث)" FontSize="14" TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" FontFamily="Tajawal" />
                                    <Border Style="{StaticResource SettingsInputBorderStyle}">
                                        <ds:PressablePicker SelectedItem="{Binding PollIntervalSeconds}"
                                                Style="{StaticResource SettingsPickerStyle}">
                                            <ds:PressablePicker.ItemsSource>
                                                <x:Array Type="{x:Type x:Int32}">
                                                    <x:Int32>15</x:Int32>
                                                    <x:Int32>30</x:Int32>
                                                    <x:Int32>60</x:Int32>
                                                    <x:Int32>120</x:Int32>
                                                    <x:Int32>300</x:Int32>
                                                </x:Array>
                                            </ds:PressablePicker.ItemsSource>
                                        </ds:PressablePicker>
                                    </Border>
                                </VerticalStackLayout>
                                <HorizontalStackLayout Spacing="6">
                                    <platform:AppIcon Icon="CircleQuestion" TextColor="#94A3B8" WidthRequest="12" HeightRequest="12" VerticalOptions="Start" Margin="0,2,0,0" />
                                    <Label Text="فاصل أقصر يعني اكتشافًا أسرع للمشاريع الجديدة، لكنه يستهلك حصة الطلبات أسرع." 
                                           FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontFamily="Tajawal" LineBreakMode="WordWrap" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#151F34}" StrokeThickness="0" Padding="24,16">
                                <Border.StrokeShape><RoundRectangle CornerRadius="0,0,12,12" /></Border.StrokeShape>
                                <Grid ColumnDefinitions="*,Auto">
                                    <ds:PressableButton Grid.Column="1" Text="حفظ" Command="{Binding SaveCommand}" BackgroundColor="#6366F1" TextColor="White" Padding="20,8" FontSize="13" CornerRadius="8" FontFamily="Tajawal" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- query_params card (Violet) -->
                    <Border Padding="0" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <VerticalStackLayout>
                            <VerticalStackLayout Padding="24,16" Spacing="4">
                                <HorizontalStackLayout Spacing="8">
                                    <platform:AppIcon Icon="Filter" TextColor="#8B5CF6" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                    <Label Text="استعلام الفحص" FontSize="16" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                                </HorizontalStackLayout>
                                <Label Text="وجّه فحص القائمة نحو رابط تصفية محدد في Mostaql" FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontFamily="Tajawal" />
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F1F5F9, Dark=#1E293B}" />

                            <VerticalStackLayout Padding="24,20" Spacing="16">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="معاملات استعلام الفحص" FontSize="14" TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" FontFamily="Tajawal" />
                                    <Border Style="{StaticResource SettingsInputBorderStyle}" Padding="0" FlowDirection="LeftToRight">
                                        <Grid ColumnDefinitions="Auto,1,*">
                                            <Label Grid.Column="0" Text="mostaql.com/projects" Padding="12,10" FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}" FontFamily="Consolas" VerticalTextAlignment="Center" />
                                            <BoxView Grid.Column="1" WidthRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" VerticalOptions="Fill" />
                                            <platform:AppEntry Grid.Column="2" Text="{Binding QueryParams}" Placeholder="category=development&amp;sort=latest" 
                                                               Style="{StaticResource SettingsInputStyle}" FontFamily="Consolas" VerticalOptions="Center" Margin="12,0" />
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>
                                <HorizontalStackLayout Spacing="6">
                                    <platform:AppIcon Icon="CircleQuestion" TextColor="#94A3B8" WidthRequest="12" HeightRequest="12" VerticalOptions="Start" Margin="0,2,0,0" />
                                    <Label Text="اتركه فارغًا لفحص كل المشاريع. القيمة الجديدة تُطبَّق على الفحص التالي فقط." 
                                           FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontFamily="Tajawal" LineBreakMode="WordWrap" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#151F34}" StrokeThickness="0" Padding="24,16">
                                <Border.StrokeShape><RoundRectangle CornerRadius="0,0,12,12" /></Border.StrokeShape>
                                <Grid ColumnDefinitions="*,Auto">
                                    <ds:PressableButton Grid.Column="1" Text="حفظ" Command="{Binding SaveCommand}" BackgroundColor="#8B5CF6" TextColor="White" Padding="20,8" FontSize="13" CornerRadius="8" FontFamily="Tajawal" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- include_assets card (Orange) -->
                    <Border Padding="0" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <VerticalStackLayout>
                            <Grid Padding="24,16" ColumnDefinitions="*,Auto" BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}">
                                <VerticalStackLayout Spacing="4">
                                    <HorizontalStackLayout Spacing="8">
                                        <platform:AppIcon Icon="Paperclip" TextColor="#F97316" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                        <Label Text="تنزيل المرفقات" FontSize="16" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                                    </HorizontalStackLayout>
                                    <Label Text="احفظ صور وملفات المشروع محليًا أثناء الإثراء" FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontFamily="Tajawal" />
                                </VerticalStackLayout>
                                <platform:AppToggle Grid.Column="1" IsToggled="{Binding IncludeAssets}" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F1F5F9, Dark=#1E293B}" />

                            <VerticalStackLayout Padding="24,20">
                                <HorizontalStackLayout Spacing="6">
                                    <platform:AppIcon Icon="CircleQuestion" TextColor="#94A3B8" WidthRequest="12" HeightRequest="12" VerticalOptions="Start" Margin="0,2,0,0" />
                                    <Label Text="عند التفعيل، تُحفظ المرفقات على القرص لكل مشروع جديد يُثرى. يزيد هذا من استهلاك القرص والوقت." 
                                           FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontFamily="Tajawal" LineBreakMode="WordWrap" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- notification_grouping card (Teal) -->
                    <Border Padding="0" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <VerticalStackLayout>
                            <Grid Padding="24,16" ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="4">
                                    <HorizontalStackLayout Spacing="8">
                                        <platform:AppIcon Icon="LayerGroup" TextColor="#14B8A6" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                        <Label Text="تجميع التنبيهات" FontSize="16" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                                    </HorizontalStackLayout>
                                    <Label Text="اجمع الاكتشافات المتقاربة في تنبيه واحد بدل تنبيه منفصل لكل مشروع" FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontFamily="Tajawal" />
                                </VerticalStackLayout>
                                <platform:AppToggle Grid.Column="1" IsToggled="{Binding NotificationGroupingEnabled}" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F1F5F9, Dark=#1E293B}" />

                            <VerticalStackLayout Padding="24,20" Spacing="16">
                                <HorizontalStackLayout Spacing="6">
                                    <platform:AppIcon Icon="CircleQuestion" TextColor="#94A3B8" WidthRequest="12" HeightRequest="12" VerticalOptions="Start" Margin="0,2,0,0" />
                                    <Label Text="مفيد بشكل خاص عند تراكم عدد كبير من المشاريع — يظهر ملخص واحد أثناء تفريغ الطابور." 
                                           FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontFamily="Tajawal" LineBreakMode="WordWrap" />
                                </HorizontalStackLayout>

                                <VerticalStackLayout Spacing="8">
                                    <Label Text="طريقة تجميع الإشعارات" FontSize="14" TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" FontFamily="Tajawal" />
                                    <Border Style="{StaticResource SettingsInputBorderStyle}">
                                        <ds:PressablePicker SelectedItem="{Binding GroupingMode}"
                                                Style="{StaticResource SettingsPickerStyle}">
                                            <ds:PressablePicker.ItemsSource>
                                                <x:Array Type="{x:Type services:NotificationGroupingMode}">
                                                    <services:NotificationGroupingMode>EndOfMinute</services:NotificationGroupingMode>
                                                    <services:NotificationGroupingMode>AfterMinutes</services:NotificationGroupingMode>
                                                    <services:NotificationGroupingMode>AfterCount</services:NotificationGroupingMode>
                                                </x:Array>
                                            </ds:PressablePicker.ItemsSource>
                                        </ds:PressablePicker>
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="8">
                                    <Label Text="معامل تجميع الإشعارات" FontSize="14" TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" FontFamily="Tajawal" />
                                    <Border Style="{StaticResource SettingsInputBorderStyle}">
                                        <platform:AppEntry Text="{Binding GroupingThreshold}" Keyboard="Numeric"
                                                           Style="{StaticResource SettingsInputStyle}" />
                                    </Border>
                                    <Label Text="القيمة الرقمية المطلوبة لـ after_minutes أو after_count." FontSize="11" TextColor="#94A3B8" FontFamily="Tajawal" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#151F34}" StrokeThickness="0" Padding="24,16">
                                <Border.StrokeShape><RoundRectangle CornerRadius="0,0,12,12" /></Border.StrokeShape>
                                <Grid ColumnDefinitions="*,Auto">
                                    <ds:PressableButton Grid.Column="1" Text="حفظ" Command="{Binding SaveCommand}" BackgroundColor="#14B8A6" TextColor="White" Padding="20,8" FontSize="13" CornerRadius="8" FontFamily="Tajawal" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- rate_limiting card (Pink) -->
                    <Border Padding="0" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <VerticalStackLayout>
                            <VerticalStackLayout Padding="24,16" Spacing="4">
                                <HorizontalStackLayout Spacing="8">
                                    <platform:AppIcon Icon="Gauge" TextColor="#EC4899" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                    <Label Text="حدود الطلبات ومعدل التوازي" FontSize="16" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                                </HorizontalStackLayout>
                                <Label Text="ضبط حد الطلبات في الدقيقة، توازي إثراء التفاصيل، وخيارات الأمان" FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontFamily="Tajawal" />
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F1F5F9, Dark=#1E293B}" />

                            <VerticalStackLayout Padding="24,20" Spacing="20">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="الحد الأقصى للطلبات في الدقيقة" FontSize="14" TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" FontFamily="Tajawal" />
                                    <HorizontalStackLayout Spacing="12">
                                        <Border Style="{StaticResource SettingsInputBorderStyle}" WidthRequest="100">
                                            <platform:AppEntry Text="{Binding RequestsPerMinute}" Keyboard="Numeric"
                                                               Style="{StaticResource SettingsInputStyle}" />
                                        </Border>
                                        <Label Text="طلب / دقيقة (الافتراضي: 2)" VerticalOptions="Center" FontSize="12" TextColor="#94A3B8" FontFamily="Tajawal" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="8">
                                    <Label Text="الحد الأقصى للتوازي في جلب التفاصيل" FontSize="14" TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" FontFamily="Tajawal" />
                                    <Border Style="{StaticResource SettingsInputBorderStyle}">
                                        <ds:PressablePicker SelectedItem="{Binding MaxConcurrentDetailFetches}"
                                                Style="{StaticResource SettingsPickerStyle}">
                                            <ds:PressablePicker.ItemsSource>
                                                <x:Array Type="{x:Type x:Int32}">
                                                    <x:Int32>1</x:Int32>
                                                    <x:Int32>2</x:Int32>
                                                    <x:Int32>3</x:Int32>
                                                    <x:Int32>5</x:Int32>
                                                </x:Array>
                                            </ds:PressablePicker.ItemsSource>
                                        </ds:PressablePicker>
                                    </Border>
                                </VerticalStackLayout>

                                <Grid ColumnDefinitions="*,Auto" Padding="0,10,0,0">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="الطلبات الآمنة (الحد الأدنى للفواصل الزمنية)" FontSize="14" TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" FontFamily="Tajawal" />
                                        <Label Text="فرض الحد الأدنى للفواصل الزمنية (ثانية واحدة بين الطلبات) لتفادي الحظر." 
                                               FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontFamily="Tajawal" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <platform:AppToggle Grid.Column="1" IsToggled="{Binding SafeRequests}" VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>

                            <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#151F34}" StrokeThickness="0" Padding="24,16">
                                <Border.StrokeShape><RoundRectangle CornerRadius="0,0,12,12" /></Border.StrokeShape>
                                <Grid ColumnDefinitions="*,Auto">
                                    <ds:PressableButton Grid.Column="1" Text="حفظ إعدادات الأداء والأمان" Command="{Binding SaveCommand}" BackgroundColor="#EC4899" TextColor="White" Padding="20,8" FontSize="13" CornerRadius="8" FontFamily="Tajawal" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Session cookie card -->
                    <Border Padding="16" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <Label Text="ملف الجلسة (الكوكيز)" FontSize="18" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                            <Label Text="ارفع ملف الكوكيز المُصدَّر من المتصفح لتفعيل تنزيل مرفقات المشاريع."
                                   FontSize="12" LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontFamily="Tajawal" />

                            <ds:PressableBorder AutomationId="Settings_CookieDropZone" Padding="20" StrokeThickness="2" StrokeDashArray="6,4"
                                                Stroke="{AppThemeBinding Light=#94A3B8, Dark=#475569}" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0B1220}">
                                <ds:PressableBorder.StrokeShape><RoundRectangle CornerRadius="14" /></ds:PressableBorder.StrokeShape>
                                <ds:PressableBorder.GestureRecognizers><TapGestureRecognizer Command="{Binding UploadSessionCookieCommand}" /></ds:PressableBorder.GestureRecognizers>
                                <ds:PressableBorder.Triggers>
                                    <DataTrigger TargetType="ds:PressableBorder" Binding="{Binding IsCookieSuccess}" Value="True">
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light=#16A34A, Dark=#4ADE80}" /><Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F0FDF4, Dark=#0B1E14}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="ds:PressableBorder" Binding="{Binding IsCookieError}" Value="True">
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light=#DC2626, Dark=#F87171}" /><Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FEF2F2, Dark=#210F10}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="ds:PressableBorder" Binding="{Binding IsCookieBusy}" Value="True"><Setter Property="Stroke" Value="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" /></DataTrigger>
                                </ds:PressableBorder.Triggers>
                                <VerticalStackLayout Spacing="6" HorizontalOptions="Center" InputTransparent="True">
                                    <platform:AppIcon Icon="Upload" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" IsVisible="{Binding IsCookieIdle}" TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" />
                                    <ActivityIndicator IsVisible="{Binding IsCookieBusy}" IsRunning="{Binding IsCookieBusy}" HeightRequest="28" HorizontalOptions="Center" Color="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" />
                                    <Label Text="اسحب ملف الكوكيز هنا أو اضغط للاختيار" FontSize="14" HorizontalOptions="Center" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                                    <Label Text="{Binding SessionCookieStatusText}" FontSize="12" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontFamily="Tajawal" />
                                </VerticalStackLayout>
                            </ds:PressableBorder>

                            <Label Text="{Binding CookieFeedbackText}" FontSize="13" LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontFamily="Tajawal">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsCookieSuccess}" Value="True"><Setter Property="TextColor" Value="{AppThemeBinding Light=#16A34A, Dark=#4ADE80}" /></DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsCookieError}" Value="True"><Setter Property="TextColor" Value="{AppThemeBinding Light=#DC2626, Dark=#F87171}" /></DataTrigger>
                                </Label.Triggers>
                            </Label>

                            <HorizontalStackLayout Spacing="8" HorizontalOptions="End">
                                <ds:PressableButton Text="حذف الجلسة" Command="{Binding ClearSessionCookieCommand}" IsVisible="{Binding HasSessionCookie}" BackgroundColor="Transparent" BorderWidth="1" BorderColor="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" TextColor="{AppThemeBinding Light=#DC2626, Dark=#F87171}" FontFamily="Tajawal" />
                                <ds:PressableButton Text="رفع ملف الجلسة" Command="{Binding UploadSessionCookieCommand}" BackgroundColor="{AppThemeBinding Light=#2563EB, Dark=#3B82F6}" TextColor="White" FontFamily="Tajawal" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Close-to-tray confirmation card (CloseBehaviorService) -->
                    <Border Padding="0" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <VerticalStackLayout>
                            <Grid Padding="20,16" ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="4">
                                    <HorizontalStackLayout Spacing="8">
                                        <platform:AppIcon Icon="Close" TextColor="#0EA5E9" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                        <Label Text="سلوك إغلاق التطبيق" FontSize="16" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                                    </HorizontalStackLayout>
                                    <Label Text="تذكر خيارك عند الضغط على X لعدم السؤال مرة أخرى" FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontFamily="Tajawal" />
                                </VerticalStackLayout>
                                <platform:AppToggle Grid.Column="1" IsToggled="{Binding RememberCloseBehavior}" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F1F5F9, Dark=#1E293B}" />

                            <VerticalStackLayout Padding="20">
                                <HorizontalStackLayout Spacing="6">
                                    <platform:AppIcon Icon="CircleQuestion" TextColor="#94A3B8" WidthRequest="12" HeightRequest="12" VerticalOptions="Start" Margin="0,2,0,0" />
                                    <Label Text="{Binding CloseBehaviorStatusText}"
                                           FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontFamily="Tajawal" LineBreakMode="WordWrap" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Dark Mode footer -->
                    <Border Padding="16" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="الوضع الليلي" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" FontFamily="Tajawal" />
                            <platform:AppToggle Grid.Column="1" IsToggled="{Binding IsDarkMode}" />
                        </Grid>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>

</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MostaqlK.Features.Settings.ViewModels"
             xmlns:platform="clr-namespace:MostaqlK.UI.PlatformComponents"
             xmlns:sidebar="clr-namespace:MostaqlK.UI.PlatformComponents.AppSidebar"
             xmlns:ds="clr-namespace:MostaqlK.UI.DesignSystem"
             xmlns:services="clr-namespace:MostaqlK.Services"
             x:Class="MostaqlK.Features.Settings.Views.SettingsPanel"
             x:DataType="vm:SettingsViewModel"
             Title="الإعدادات"
             Shell.NavBarIsVisible="False"
             FlowDirection="RightToLeft"
             BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#020617}">

    <!-- Layout mirrors settings.html: shared sidebar (AppSidebar) + a header bar + a single
         settings card. Rows mirror the app's actual configurable settings (poll interval,
         request rate, grouping mode/threshold, dark-mode toggle, and the "مشاريع مضافة اليوم"
         stat card, which also appears in the sidebar per the mockup). -->
    <!-- Colours follow the mockup's light/dark class pairs (bg-slate-100 dark:bg-slate-950 for the
         page, bg-white dark:bg-slate-900 for panels, border-slate-200 dark:border-slate-800). -->
    <Grid BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#020617}" ColumnDefinitions="Auto,*">

        <sidebar:AppSidebar Grid.Column="0"
                             ActivePage="Settings"
                             StatValue="{Binding GlobalStatus.ProjectsAddedTodayText}"
                             ProjectsClicked="OnProjectsNavClicked"
                             AdvancedSearchClicked="OnAdvancedSearchNavClicked"
                             SettingsClicked="OnSettingsNavClicked"
                             AboutClicked="OnAboutNavClicked" />

        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Padding="28,24,28,28" RowSpacing="18"
              BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#020617}">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Label Text="⚙" FontSize="24" TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" FontFamily="Tajawal" />
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="الإعدادات" FontSize="24" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                    <Label Text="إدارة إعدادات التطبيق وسلوك المراقبة" FontSize="13" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontFamily="Tajawal" />
                </VerticalStackLayout>
            </Grid>
            <!-- MVP note: bg-blue-50 dark:bg-blue-500/10 with text-blue-700 dark:text-blue-300. -->
            <Border Grid.Row="1" BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#132239}" StrokeThickness="0" Padding="16,12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label Text="ملاحظة MVP: بعض الإعدادات المتقدمة ستُضاف في إصدارات لاحقة." FontSize="13" TextColor="{AppThemeBinding Light=#1D4ED8, Dark=#93C5FD}" FontFamily="Tajawal" />
            </Border>

            <ScrollView Grid.Row="2">
                <VerticalStackLayout Spacing="16">

                    <Border Padding="20" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="مشاريع مضافة اليوم" FontSize="14" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontFamily="Tajawal" />
                            <Label Text="{Binding GlobalStatus.ProjectsAddedTodayCount}" FontSize="28" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="{Binding ValidationMessage}"
                           TextColor="{AppThemeBinding Light=#DC2626, Dark=#F87171}"
                           FontSize="13"
                           IsVisible="{Binding HasValidationError}"
                           FontFamily="Tajawal" />

                    <Border Padding="16" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="16">

                            <Label Text="إعدادات المراقبة" FontSize="18" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                            <!-- Input rows: border-slate-200 dark:border-slate-700 over bg-slate-50 dark:bg-slate-800. -->
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="فترة الفحص (ثانية)" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" FontFamily="Tajawal" />
                                <Border Grid.Column="1" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}" Padding="12,8" WidthRequest="100">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <platform:AppEntry Text="{Binding PollIntervalSeconds}" Keyboard="Numeric"
                                                       AutomationId="Settings_PollIntervalInput"
                                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}"
                                                       BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}"
                                                       FontFamily="Tajawal" />
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="الحد الأقصى للطلبات في الدقيقة" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" FontFamily="Tajawal" />
                                <Border Grid.Column="1" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}" Padding="12,8" WidthRequest="100">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <platform:AppEntry Text="{Binding RequestsPerMinute}" Keyboard="Numeric"
                                                       AutomationId="Settings_RequestsPerMinuteInput"
                                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}"
                                                       BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}"
                                                       FontFamily="Tajawal" />
                                </Border>
                            </Grid>

                            <!-- "الطلبات الآمنة": on (default) the shared token bucket enforces
                                 max_requests_per_minute exactly as worker-pool-and-rate-limiter.md
                                 specifies (capacity = rpm, refill = rpm/60 per second, 1s spacing);
                                 off restores the older 10-request burst behaviour. The (i) glyph
                                 carries the explanation as a native tooltip, and the same text is
                                 repeated as a sub-label so it is readable without hovering. -->
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="الطلبات الآمنة" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" FontFamily="Tajawal" />
                                    <!-- FIX: the (i) glyph used to be a bare Label with FontFamily="Tajawal" (an
                                         Arabic-only face with no ⓘ glyph), so it rendered with a near-zero
                                         measured width and the native ToolTip's hover hit-test never triggered.
                                         Wrapping it in an explicitly-sized, background-transparent Border (with no
                                         Arabic FontFamily override, so the system's symbol fallback font actually
                                         has the glyph) gives WinUI a real hoverable area to attach the tooltip to. -->
                                    <Border Grid.Column="1"
                                            WidthRequest="22"
                                            HeightRequest="22"
                                            Padding="0"
                                            StrokeThickness="0"
                                            BackgroundColor="Transparent"
                                            VerticalOptions="Center"
                                            AutomationId="Settings_SafeRequestsInfo"
                                            ToolTipProperties.Text="{Binding SafeRequestsHintText}">
                                        <Label Text="ⓘ"
                                               FontSize="15"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               InputTransparent="True"
                                               TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" />
                                    </Border>
                                    <ds:PressableCheckBox Grid.Column="3"
                                              AutomationId="Settings_SafeRequestsCheckbox"
                                              IsChecked="{Binding SafeRequests}"
                                              VerticalOptions="Center"
                                              Color="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" />
                                </Grid>
                                <Label Text="{Binding SafeRequestsHintText}"
                                       FontSize="12"
                                       LineBreakMode="WordWrap"
                                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                                       FontFamily="Tajawal" />
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="طريقة تجميع الإشعارات" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" FontFamily="Tajawal" />
                                <Border Grid.Column="1" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}" Padding="12,4" WidthRequest="160">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <ds:PressablePicker SelectedItem="{Binding GroupingMode}"
                                            AutomationId="Settings_GroupingModePicker"
                                            TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}"
                                            TitleColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}"
                                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}"
                                            FontFamily="Tajawal">
                                        <ds:PressablePicker.ItemsSource>
                                            <x:Array Type="{x:Type services:NotificationGroupingMode}">
                                                <services:NotificationGroupingMode>EndOfMinute</services:NotificationGroupingMode>
                                                <services:NotificationGroupingMode>AfterMinutes</services:NotificationGroupingMode>
                                                <services:NotificationGroupingMode>AfterCount</services:NotificationGroupingMode>
                                            </x:Array>
                                        </ds:PressablePicker.ItemsSource>
                                    </ds:PressablePicker>
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="حد التجميع" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" FontFamily="Tajawal" />
                                <Border Grid.Column="1" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}" Padding="12,8" WidthRequest="100">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <platform:AppEntry Text="{Binding GroupingThreshold}" Keyboard="Numeric"
                                                       AutomationId="Settings_GroupingThresholdInput"
                                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}"
                                                       BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}"
                                                       FontFamily="Tajawal" />
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="الوضع الليلي" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" FontFamily="Tajawal" />
                                <platform:AppToggle x:Name="DarkModeToggle" Grid.Column="1" AutomationId="Settings_DarkModeToggle" IsToggled="{Binding IsDarkMode}" />
                            </Grid>

                            <ds:PressableButton Text="حفظ" AutomationId="Settings_SaveButton" Command="{Binding SaveCommand}" HorizontalOptions="End" BackgroundColor="{AppThemeBinding Light=#2563EB, Dark=#3B82F6}" TextColor="White" FontFamily="Tajawal" />

                        </VerticalStackLayout>
                    </Border>

                    <!-- Session cookie: Mostaql only exposes real attachment URLs to a logged-in
                         session, so the user uploads their browser cookie export here. The file is
                         parsed into a Cookie header and stored encrypted (DPAPI, current Windows
                         user) in the local database - never as plaintext on disk. -->
                    <Border Padding="16" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">

                            <Label Text="ملف الجلسة (الكوكيز)" FontSize="18" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                            <Label Text="ارفع ملف الكوكيز المُصدَّر من المتصفح لتفعيل تنزيل مرفقات المشاريع. يُخزَّن الملف مُشفَّرًا داخل قاعدة البيانات المحلية ولا يُحفظ كنص صريح."
                                   FontSize="12"
                                   LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                                   FontFamily="Tajawal" />

                            <!-- Dashed drop zone. PressableBorder (Design System) gives it the
                                 per-instance hover highlight + press scale/opacity animation and
                                 the hand cursor for free; the dashed stroke and the state colours
                                 (idle / saved / rejected) are driven by DataTriggers so no
                                 code-behind or converter is needed. -->
                            <ds:PressableBorder AutomationId="Settings_CookieDropZone"
                                                Padding="20"
                                                StrokeThickness="2"
                                                StrokeDashArray="6,4"
                                                StrokeDashOffset="0"
                                                Stroke="{AppThemeBinding Light=#94A3B8, Dark=#475569}"
                                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0B1220}">
                                <ds:PressableBorder.StrokeShape><RoundRectangle CornerRadius="14" /></ds:PressableBorder.StrokeShape>
                                <ds:PressableBorder.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding UploadSessionCookieCommand}" />
                                </ds:PressableBorder.GestureRecognizers>
                                <ds:PressableBorder.Triggers>
                                    <DataTrigger TargetType="ds:PressableBorder" Binding="{Binding IsCookieSuccess}" Value="True">
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light=#16A34A, Dark=#4ADE80}" />
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F0FDF4, Dark=#0B1E14}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="ds:PressableBorder" Binding="{Binding IsCookieError}" Value="True">
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light=#DC2626, Dark=#F87171}" />
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FEF2F2, Dark=#210F10}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="ds:PressableBorder" Binding="{Binding IsCookieBusy}" Value="True">
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" />
                                    </DataTrigger>
                                </ds:PressableBorder.Triggers>

                                <VerticalStackLayout Spacing="6" HorizontalOptions="Center" InputTransparent="True">
                                    <!-- Idle/finished glyph swaps for the spinner while encrypting. -->
                                    <Label Text="⬆"
                                           FontSize="28"
                                           HorizontalOptions="Center"
                                           IsVisible="{Binding IsCookieIdle}"
                                           TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" />
                                    <ActivityIndicator AutomationId="Settings_CookieSpinner"
                                                       IsVisible="{Binding IsCookieBusy}"
                                                       IsRunning="{Binding IsCookieBusy}"
                                                       HeightRequest="28"
                                                       HorizontalOptions="Center"
                                                       Color="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" />
                                    <Label Text="اسحب ملف الكوكيز هنا أو اضغط للاختيار"
                                           FontSize="14"
                                           HorizontalOptions="Center"
                                           FontFamily="TajawalBold"
                                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                                    <Label Text="{Binding SessionCookieStatusText}"
                                           AutomationId="Settings_CookieStatusLabel"
                                           FontSize="12"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="WordWrap"
                                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                                           FontFamily="Tajawal" />
                                </VerticalStackLayout>
                            </ds:PressableBorder>

                            <!-- Result line: green on success, red on rejection, muted while busy. -->
                            <Label Text="{Binding CookieFeedbackText}"
                                   AutomationId="Settings_CookieFeedbackLabel"
                                   FontSize="13"
                                   LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                                   FontFamily="Tajawal">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsCookieSuccess}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#16A34A, Dark=#4ADE80}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsCookieError}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#DC2626, Dark=#F87171}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>

                            <!-- Development-only note: Release builds ignore any cookies.txt on
                                 disk, so this row is hidden there (see CookieJar.DevelopmentFallbacksEnabled). -->
                            <Label Text="وضع التطوير: يمكن أيضًا استخدام ملف cookies.txt الموجود في مجلد المشروع أو متغيّر البيئة MOSTAQL_COOKIE. هذه الوسائل معطّلة تمامًا في نسخة الإصدار."
                                   IsVisible="{Binding ShowDevelopmentCookieNote}"
                                   FontSize="12"
                                   LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light=#B45309, Dark=#FCD34D}"
                                   FontFamily="Tajawal" />

                            <HorizontalStackLayout Spacing="8" HorizontalOptions="End">
                                <ds:PressableButton Text="حذف الجلسة"
                                        AutomationId="Settings_ClearCookieButton"
                                        Command="{Binding ClearSessionCookieCommand}"
                                        IsVisible="{Binding HasSessionCookie}"
                                        BackgroundColor="Transparent"
                                        BorderWidth="1"
                                        BorderColor="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                                        TextColor="{AppThemeBinding Light=#DC2626, Dark=#F87171}"
                                        FontFamily="Tajawal" />
                                <ds:PressableButton Text="رفع ملف الجلسة"
                                        AutomationId="Settings_UploadCookieButton"
                                        Command="{Binding UploadSessionCookieCommand}"
                                        BackgroundColor="{AppThemeBinding Light=#2563EB, Dark=#3B82F6}"
                                        TextColor="White"
                                        FontFamily="Tajawal" />
                            </HorizontalStackLayout>

                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>

</ContentPage>

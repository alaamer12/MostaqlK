<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MostaqlK.Features.Settings.ViewModels"
             xmlns:platform="clr-namespace:MostaqlK.UI.PlatformComponents"
             xmlns:settingsrow="clr-namespace:MostaqlK.UI.PlatformComponents.SettingsRow"
             xmlns:sources="clr-namespace:MostaqlK.Core.Sources"
             xmlns:ds="clr-namespace:MostaqlK.UI.DesignSystem"
             xmlns:converters="clr-namespace:MostaqlK.UI.DesignSystem.Converters"
             x:Class="MostaqlK.Features.Settings.Views.Layouts.SettingsPanelMobileLayout"
             x:DataType="vm:SettingsViewModel"
             FlowDirection="RightToLeft">

    <ContentView.Resources>
        <ResourceDictionary>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />

            <Style x:Key="SettingsInputBorderStyle" TargetType="Border">
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Stroke" Value="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F8FAFC, Dark=#1E293B}" />
                <Setter Property="Padding" Value="12,2" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="8" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SettingsInputStyle" TargetType="InputView">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontFamily" Value="Tajawal" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#94A3B8, Dark=#64748B}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>

            <Style x:Key="SettingsPickerStyle" TargetType="Picker">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontFamily" Value="Tajawal" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid RowDefinitions="Auto,*" BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#020617}">
        <!-- Top App Bar with back button -->
        <Grid Grid.Row="0" Padding="16,12" ColumnDefinitions="Auto,*,Auto" BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}">
            <ds:PressableButton Grid.Column="0" Text="← رجوع" AutomationId="Settings_Mobile_BackButton" Clicked="OnBackClicked"
                                BackgroundColor="Transparent" TextColor="{DynamicResource BrandLink}" Padding="0"
                                FontFamily="TajawalBold" FontSize="14" />
            <Label Grid.Column="1" Text="الإعدادات" FontSize="18" FontFamily="TajawalBold"
                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" HorizontalOptions="Center" VerticalOptions="Center" />
            <BoxView Grid.Column="2" WidthRequest="40" Color="Transparent" />
        </Grid>

        <ScrollView Grid.Row="1" AutomationId="Settings_Mobile_ScrollView">
            <VerticalStackLayout Spacing="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}">

                <Label Text="{Binding ValidationMessage}"
                       TextColor="{AppThemeBinding Light=#DC2626, Dark=#F87171}"
                       FontSize="13"
                       IsVisible="{Binding HasValidationError}"
                       FontFamily="Tajawal"
                       Padding="16,12" />

                <!-- Same composed rows as the desktop layout: one SettingsRow per descriptor, so a
                     setting added to the catalog appears on both platforms with no per-platform row
                     markup. Mobile's own field ids come from the descriptor's AutomationIdMobile. -->
                <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Groups}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:SettingsGroupViewModel">
                            <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Rows}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="settingsrow:SettingsRowViewModel">
                                        <settingsrow:SettingsRow Row="{Binding .}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <BoxView HeightRequest="32" Color="Transparent" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MostaqlK.Features.Settings.ViewModels"
             xmlns:platform="clr-namespace:MostaqlK.UI.PlatformComponents"
             xmlns:rail="clr-namespace:MostaqlK.UI.PlatformComponents.SourceRail"
             xmlns:lastscan="clr-namespace:MostaqlK.UI.PlatformComponents.LastScanStatus"
             xmlns:sources="clr-namespace:MostaqlK.Core.Sources"
             xmlns:converters="clr-namespace:MostaqlK.UI.DesignSystem.Converters"
             x:Class="MostaqlK.Features.Settings.Views.Layouts.SettingsPanelWindowsLayout"
             x:DataType="vm:SettingsViewModel"
             FlowDirection="RightToLeft">

    <!-- v3 continuous-page settings surface (design/postmvp/v3-multisource/settings.html).
         Row vocabulary: .set-row = label(+ .set-sub hint) on the START, value(+ optional تغيير
         inline edit link, or a pill toggle) on the END, a 1px divider between rows. Section heads
         use the .section-head pattern (AppIcon + extrabold title + optional caption). Platform
         section rows are descriptor-driven (capabilities / currency), never source-id branches.
         No animations (animation-safety.md). Brand colors only via {DynamicResource Brand*}. -->

    <ContentView.Resources>
        <ResourceDictionary>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />

            <!-- .set-label: text-sm bold ink-1 -->
            <Style x:Key="SetLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="TajawalBold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <!-- .set-sub: text-xs ink-3 -->
            <Style x:Key="SetHint" TargetType="Label">
                <Setter Property="FontFamily" Value="Tajawal" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                <Setter Property="LineBreakMode" Value="WordWrap" />
                <Setter Property="Margin" Value="0,2,0,0" />
            </Style>

            <!-- .set-value: ink-1 bold -->
            <Style x:Key="SetValue" TargetType="Label">
                <Setter Property="FontFamily" Value="TajawalBold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <!-- small unit suffix beside a numeric editor -->
            <Style x:Key="SetUnit" TargetType="Label">
                <Setter Property="FontFamily" Value="Tajawal" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <!-- .set-edit: inline brand-ink text link -->
            <Style x:Key="SetEdit" TargetType="Button">
                <Setter Property="FontFamily" Value="TajawalBold" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="{DynamicResource BrandInk}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="Padding" Value="2,0" />
                <Setter Property="MinimumHeightRequest" Value="0" />
                <Setter Property="MinimumWidthRequest" Value="0" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <!-- 1px row divider (existing ink-divider token) -->
            <Style x:Key="SetDivider" TargetType="BoxView">
                <Setter Property="HeightRequest" Value="1" />
                <Setter Property="Color" Value="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" />
            </Style>

            <!-- numeric inline editor (reused AppEntry unit) -->
            <Style x:Key="SetEditor" TargetType="platform:AppEntry">
                <Setter Property="FontFamily" Value="Tajawal" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="WidthRequest" Value="72" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>

    <!-- v3 shell (contract §3): every page now hosts the 64px SourceRail, physical LEFT — identical
         to MainWindowWindowsLayout. The root Grid is RTL, so the rail rides the LAST column (col 1)
         to land on the physical left and the settings content (col 0, *) renders to its right,
         exactly mirroring the mockup's `<div style="direction:ltr">` [rail | main(rtl)] split.
         RailWidths.Width (64px) replaces the old 256px AppSidebar column, reclaiming 192px. -->
    <Grid BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#0F172A}" ColumnDefinitions="*,Auto">

        <!-- Shared v3 shell rail (contract §3). Same switching/nav semantics as the projects page:
             ActivePage marks the الإعدادات row, the bell (no flyout host on this page) navigates to
             the projects feed which owns the notifications flyout, source tiles morph the app via
             the unit's own SourceMorph.ApplyOptimistic path, and the settings surface re-points its
             descriptor-driven rows on SourceChanged. Sidebar_* AutomationIds live inside this rail. -->
        <rail:SourceRail Grid.Column="1"
                         x:Name="Rail"
                         ActivePage="Settings"
                         UnreadCount="{Binding GlobalStatus.UnreadNotificationCount}"
                         ProjectsClicked="OnProjectsNavClicked"
                         AdvancedSearchClicked="OnAdvancedSearchNavClicked"
                         SettingsClicked="OnSettingsNavClicked"
                         AboutClicked="OnAboutNavClicked"
                         NotificationsClicked="OnRailNotificationsClicked"
                         SourceChanged="OnRailSourceChanged" />

        <Grid Grid.Column="0" RowDefinitions="Auto,*" BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#0F172A}">

            <!-- Header band (mockup <header>): centered title + "إعدادات المنصة الحالية: {tile} {name}" -->
            <VerticalStackLayout Grid.Row="0"
                                 Spacing="6"
                                 Padding="24,20"
                                 BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}">
                <BoxView BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}" HeightRequest="0" />
                <Label Text="الإعدادات"
                       FontFamily="TajawalBold"
                       FontSize="30"
                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}"
                       HorizontalOptions="Center" />
                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Label Text="إعدادات المنصة الحالية:"
                           FontFamily="Tajawal"
                           FontSize="12"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                    <!-- dev33 shell-unify: the header stays the mockup's COMPACT single active-source
                         tile + name (settings.html `<p …><span class="w-5 h-5 src-tile">…<span id=set-src-name>`).
                         The interactive IconOnly SourceSwitchTiles switcher is wired into THIS page via the
                         SourceRail above (its own IconOnly SourceSwitchTiles + SourceChanged → refresh);
                         a full two-tile switcher here inflated the header height and vertically ghosted
                         every content row in the parity matrix, so the compact display form is kept.
                         The tile/name repaint on a rail source switch through RefreshForActiveSource. -->
                    <Border BackgroundColor="{DynamicResource Brand}"
                            StrokeThickness="0"
                            WidthRequest="20"
                            HeightRequest="20"
                            VerticalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                        <Label Text="{Binding ActiveSourceGlyph}"
                               FontFamily="TajawalBold"
                               FontSize="10"
                               TextColor="{DynamicResource OnBrand}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <Label Text="{Binding ActiveSourceName}"
                           FontFamily="TajawalBold"
                           FontSize="12"
                           VerticalOptions="Center"
                           TextColor="{DynamicResource BrandInk}" />
                </HorizontalStackLayout>
                <BoxView Style="{StaticResource SetDivider}" />
            </VerticalStackLayout>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}" Spacing="0">

                    <!-- Inline validation message (existing VM surface, kept reachable) -->
                    <Label Text="{Binding ValidationMessage}"
                           TextColor="{AppThemeBinding Light=#DC2626, Dark=#F87171}"
                           FontSize="13"
                           FontFamily="Tajawal"
                           Padding="24,12"
                           IsVisible="{Binding HasValidationError}" />

                    <!-- ================= Section المنصة ================= -->
                    <VerticalStackLayout Spacing="2" Padding="24,16" BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}">
                        <HorizontalStackLayout Spacing="8">
                            <platform:AppIcon Icon="Windows" WidthRequest="18" HeightRequest="18"
                                              TextColor="{DynamicResource BrandInk}" VerticalOptions="Center" />
                            <Label Text="المنصة" FontFamily="TajawalBold" FontSize="16"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Text="المصادر يحددها المطوّر — كل منصة تعرض إعداداتها الخاصة بها، وقد تختلف الإعدادات والصفحات وحقول البطاقات من منصة لأخرى."
                               FontFamily="Tajawal" FontSize="12"
                               TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <!-- فاصل الفحص -->
                    <Grid ColumnDefinitions="*,Auto" Padding="24,12" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                            <Label Text="فاصل الفحص" Style="{StaticResource SetLabel}" />
                            <Label Text="كل كم ثانية يُفحص البحث عن مشاريع جديدة" Style="{StaticResource SetHint}" />
                        </VerticalStackLayout>
                        <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <platform:AppEntry AutomationId="Settings_PollIntervalInput"
                                               Style="{StaticResource SetEditor}"
                                               Keyboard="Numeric"
                                               Text="{Binding PollIntervalSeconds, Mode=TwoWay}" />
                            <Label Text="ثانية" Style="{StaticResource SetUnit}" />
                        </HorizontalStackLayout>
                    </Grid>
                    <BoxView Style="{StaticResource SetDivider}" Margin="24,0" />

                    <!-- حد الطلبات -->
                    <Grid ColumnDefinitions="*,Auto" Padding="24,12" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                            <Label Text="حد الطلبات" Style="{StaticResource SetLabel}" />
                            <Label Text="سقف لبق يحمي الحساب والموقع" Style="{StaticResource SetHint}" />
                        </VerticalStackLayout>
                        <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <platform:AppEntry AutomationId="Settings_RequestsPerMinuteInput"
                                               Style="{StaticResource SetEditor}"
                                               Keyboard="Numeric"
                                               Text="{Binding RequestsPerMinute, Mode=TwoWay}" />
                            <Label Text="طلب/دقيقة" Style="{StaticResource SetUnit}" />
                        </HorizontalStackLayout>
                    </Grid>
                    <BoxView Style="{StaticResource SetDivider}" Margin="24,0" />

                    <!-- تنبيهات هذه المنصة -->
                    <Grid ColumnDefinitions="*,Auto" Padding="24,12" ColumnSpacing="16">
                        <Label Text="تنبيهات هذه المنصة" Style="{StaticResource SetLabel}" />
                        <platform:AppToggle Grid.Column="1"
                                            AutomationId="Settings_SourceNotificationsToggle"
                                            IsToggled="{Binding SourceNotificationsEnabled, Mode=TwoWay}"
                                            OnColor="{DynamicResource Brand}"
                                            ThumbColor="White"
                                            VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource SetDivider}" Margin="24,0" />

                    <!-- أنواع المشاريع المتابَعة — only when the source has supervised projects -->
                    <Grid ColumnDefinitions="*,Auto" Padding="24,12" ColumnSpacing="16"
                          IsVisible="{Binding ShowSupervisedTypesRow}">
                        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                            <Label Text="أنواع المشاريع المتابَعة" Style="{StaticResource SetLabel}" />
                            <Label Text="هذه المنصة تتميز بمشاريع مراقبة وعادية" Style="{StaticResource SetHint}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="عادية + مراقبة" Style="{StaticResource SetValue}" VerticalOptions="Center" />
                    </Grid>

                    <!-- جلسة الإثراء — only when the descriptor marks session-gated enrichment -->
                    <VerticalStackLayout IsVisible="{Binding ShowSessionEnrichmentRow}">
                        <Grid ColumnDefinitions="*,Auto" Padding="24,12" ColumnSpacing="16"
                              IsVisible="{Binding IsCookieEditorClosed}">
                            <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                <Label Text="جلسة الإثراء" Style="{StaticResource SetLabel}" />
                                <Label Text="{Binding SessionEnrichmentHint}" Style="{StaticResource SetHint}" />
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                <Label Text="{Binding SessionValueText}"
                                       FontFamily="Tajawal"
                                       FontSize="14"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource AccentPositive}, Dark={StaticResource AccentPositiveDark}}" />
                                <Button Text="إلغاء الربط"
                                        Style="{StaticResource SetEdit}"
                                        Command="{Binding ClearSessionCookieCommand}"
                                        IsVisible="{Binding HasSessionCookie}" />
                                <Button Text="ربط كوكيز"
                                        AutomationId="Settings_OpenCookieEditorButton"
                                        Style="{StaticResource SetEdit}"
                                        Command="{Binding OpenCookieEditorCommand}"
                                        IsVisible="{Binding HasSessionCookie, Converter={StaticResource InvertedBoolConverter}}" />
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- revealed editor: existing single mutation path (paste + save/clear) -->
                        <VerticalStackLayout Spacing="10" Padding="24,0,24,12" IsVisible="{Binding IsCookieEditorOpen}">
                            <Border StrokeThickness="1" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                                    BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1E293B}" Padding="12,2">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                <platform:AppEntry AutomationId="Settings_SessionCookieEntry"
                                                   Text="{Binding SessionCookieInput, Mode=TwoWay}"
                                                   Placeholder="{Binding CookiePastePlaceholder}"
                                                   IsPassword="True"
                                                   FlowDirection="LeftToRight"
                                                   FontFamily="Tajawal" FontSize="14"
                                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}"
                                                   BackgroundColor="Transparent" />
                            </Border>
                            <HorizontalStackLayout Spacing="10">
                                <Button AutomationId="Settings_SaveCookieButton"
                                        Text="حفظ الكوكي"
                                        Command="{Binding SaveSessionCookieCommand}"
                                        BackgroundColor="{DynamicResource Brand}"
                                        TextColor="{DynamicResource OnBrand}"
                                        FontFamily="TajawalBold" FontSize="13" Padding="14,8" CornerRadius="8" />
                                <Button AutomationId="Settings_ClearCookieButton"
                                        Text="مسح الكوكي"
                                        Command="{Binding ClearSessionCookieCommand}"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light=#DC2626, Dark=#F87171}"
                                        FontFamily="Tajawal" FontSize="13" Padding="14,8"
                                        IsVisible="{Binding HasSessionCookie}" />
                                <Button Text="إغلاق"
                                        Style="{StaticResource SetEdit}"
                                        Command="{Binding CloseCookieEditorCommand}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- عملة الميزانية — display row, only when non-default currency -->
                    <Grid ColumnDefinitions="*,Auto" Padding="24,12" ColumnSpacing="16"
                          IsVisible="{Binding ShowBudgetCurrencyRow}">
                        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                            <Label Text="عملة الميزانية" Style="{StaticResource SetLabel}" />
                            <Label Text="تُعرض ميزانيات هذه المنصة بالعملة الموضّحة في الموقع" Style="{StaticResource SetHint}" />
                        </VerticalStackLayout>
                        <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                            <Label Text="{Binding BudgetCurrencyDisplayText}" Style="{StaticResource SetValue}" />
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- آخر فحص — reused LastScanStatus unit (code-setter AutomationId form) -->
                    <Grid ColumnDefinitions="*,Auto" Padding="24,12" ColumnSpacing="16">
                        <Label Text="آخر فحص" Style="{StaticResource SetLabel}" />
                        <lastscan:LastScanStatus Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 FontSize="14"
                                                 TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}"
                                                 LabelAutomationId="Settings_LastScanLabel"
                                                 LastScanAt="{Binding GlobalStatus.LastScanCompletedAt}" />
                    </Grid>
                    <BoxView Style="{StaticResource SetDivider}" Margin="24,0" />

                    <!-- الأرشيف — count + عرض -->
                    <Grid ColumnDefinitions="*,Auto" Padding="24,12" ColumnSpacing="16">
                        <Label Text="الأرشيف" Style="{StaticResource SetLabel}" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                            <Label Text="{Binding ArchiveCountText}" Style="{StaticResource SetValue}" />
                            <Button Text="عرض"
                                    AutomationId="Settings_ViewArchiveButton"
                                    Style="{StaticResource SetEdit}"
                                    Clicked="OnViewArchiveClicked" />
                        </HorizontalStackLayout>
                    </Grid>
                    <BoxView Style="{StaticResource SetDivider}" Margin="24,0" />

                    <!-- Contributed per-source sections (contract §4/§10) — rendered through the generic
                         ISourceSettingsSectionViewModel template; the "تخطي المشاريع المغلقة" toggle and
                         the module's own session read-out arrive here, never duplicated above. Absent for
                         a source that contributes nothing (the group is never rendered empty). -->
                    <VerticalStackLayout Spacing="0" IsVisible="{Binding HasContributedSections}"
                                         BindableLayout.ItemsSource="{Binding ContributedSections}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="sources:ISourceSettingsSectionViewModel">
                                <VerticalStackLayout Spacing="0">
                                    <!-- section header row (module header) -->
                                    <Grid Padding="24,10">
                                        <Label Text="{Binding HeaderAr}" Style="{StaticResource SetLabel}" />
                                    </Grid>
                                    <BoxView Style="{StaticResource SetDivider}" Margin="24,0" />

                                    <!-- retry toggle row -->
                                    <Grid ColumnDefinitions="*,Auto" Padding="24,12" ColumnSpacing="16" IsVisible="{Binding HasRetryToggle}">
                                        <Label Text="{Binding RetryToggleLabelAr}" Style="{StaticResource SetLabel}" />
                                        <platform:AppToggle Grid.Column="1"
                                                            AutomationId="Settings_ContributedRetryToggle"
                                                            IsToggled="{Binding EnrichmentRetryEnabled, Mode=TwoWay}"
                                                            OnColor="{DynamicResource Brand}"
                                                            ThumbColor="White"
                                                            VerticalOptions="Center" />
                                    </Grid>

                                    <!-- session read-out row -->
                                    <Grid ColumnDefinitions="*,Auto" Padding="24,12" ColumnSpacing="16" IsVisible="{Binding HasSessionRow}">
                                        <Label Text="{Binding SessionRowLabelAr}" Style="{StaticResource SetLabel}" />
                                        <Label Grid.Column="1"
                                               Text="{Binding SessionStateText}"
                                               Style="{StaticResource SetValue}"
                                               FontFamily="Tajawal"
                                               HorizontalOptions="End"
                                               VerticalOptions="Center" />
                                    </Grid>
                                    <BoxView Style="{StaticResource SetDivider}" Margin="24,0" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- ================= Section عام ================= -->
                    <VerticalStackLayout Spacing="2" Padding="24,16" BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}">
                        <HorizontalStackLayout Spacing="8">
                            <platform:AppIcon Icon="Gear" WidthRequest="18" HeightRequest="18"
                                              TextColor="{DynamicResource BrandInk}" VerticalOptions="Center" />
                            <Label Text="عام" FontFamily="TajawalBold" FontSize="16"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- تشغيل مع النظام -->
                    <Grid ColumnDefinitions="*,Auto" Padding="24,12" ColumnSpacing="16" IsVisible="{Binding IsStartupVisible}">
                        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                            <Label Text="تشغيل مع النظام" Style="{StaticResource SetLabel}" />
                            <Label Text="يبدأ التطبيق في الدرج دون نافذة" Style="{StaticResource SetHint}" />
                        </VerticalStackLayout>
                        <platform:AppToggle Grid.Column="1"
                                            AutomationId="Settings_StartupToggle"
                                            IsToggled="{Binding StartupEnabled, Mode=TwoWay}"
                                            OnColor="{DynamicResource Brand}"
                                            ThumbColor="White"
                                            VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource SetDivider}" Margin="24,0" IsVisible="{Binding IsStartupVisible}" />

                    <!-- تجميع التنبيهات (existing per-source grouping pref, shown under عام per mockup) -->
                    <Grid ColumnDefinitions="*,Auto" Padding="24,12" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                            <Label Text="تجميع التنبيهات" Style="{StaticResource SetLabel}" />
                            <Label Text="تنبيه واحد لكل دفعة بدل تنبيه لكل مشروع — على كل المنصات" Style="{StaticResource SetHint}" />
                        </VerticalStackLayout>
                        <platform:AppToggle Grid.Column="1"
                                            AutomationId="Settings_GroupingToggle"
                                            IsToggled="{Binding NotificationGroupingEnabled, Mode=TwoWay}"
                                            OnColor="{DynamicResource Brand}"
                                            ThumbColor="White"
                                            VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource SetDivider}" Margin="24,0" />

                    <!-- نمط التجميع (kept for UI-test continuity: Settings_GroupingModePicker) -->
                    <Grid ColumnDefinitions="*,Auto" Padding="24,12" ColumnSpacing="16">
                        <Label Text="نمط التجميع" Style="{StaticResource SetLabel}" />
                        <Picker Grid.Column="1"
                                AutomationId="Settings_GroupingModePicker"
                                WidthRequest="160"
                                Title="نمط التجميع"
                                FontFamily="Tajawal" FontSize="14"
                                TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}"
                                BackgroundColor="Transparent"
                                ItemsSource="{Binding GroupingModeOptions}"
                                SelectedIndex="{Binding GroupingModeIndex, Mode=TwoWay}" />
                    </Grid>
                    <BoxView Style="{StaticResource SetDivider}" Margin="24,0" />

                    <!-- حد التجميع (kept for UI-test continuity: Settings_GroupingThresholdInput) -->
                    <Grid ColumnDefinitions="*,Auto" Padding="24,12" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                            <Label Text="حد التجميع" Style="{StaticResource SetLabel}" />
                            <Label Text="عدد المشاريع الذي يُجمَّع عنده التنبيه" Style="{StaticResource SetHint}" />
                        </VerticalStackLayout>
                        <platform:AppEntry Grid.Column="1"
                                           AutomationId="Settings_GroupingThresholdInput"
                                           Style="{StaticResource SetEditor}"
                                           Keyboard="Numeric"
                                           Text="{Binding GroupingThreshold, Mode=TwoWay}" />
                    </Grid>
                    <BoxView Style="{StaticResource SetDivider}" Margin="24,0" />

                    <!-- تذكر آخر منصة مفتوحة (new global pref, default on) -->
                    <Grid ColumnDefinitions="*,Auto" Padding="24,12" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                            <Label Text="تذكر آخر منصة مفتوحة" Style="{StaticResource SetLabel}" />
                            <Label Text="عند إعادة تشغيل التطبيق يعود لنفس المنصة التي كنت عليها" Style="{StaticResource SetHint}" />
                        </VerticalStackLayout>
                        <platform:AppToggle Grid.Column="1"
                                            AutomationId="Settings_RememberSourceToggle"
                                            IsToggled="{Binding RememberLastSource, Mode=TwoWay}"
                                            OnColor="{DynamicResource Brand}"
                                            ThumbColor="White"
                                            VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource SetDivider}" Margin="24,0" />

                    <!-- الوضع الداكن — relocated to the rail in the mockup, kept here bound for UI-test
                         continuity (Settings_DarkModeToggle) and reachable theme control. -->
                    <Grid ColumnDefinitions="*,Auto" Padding="24,12" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                            <Label Text="الوضع الداكن" Style="{StaticResource SetLabel}" />
                            <Label Text="تبديل مظهر التطبيق بين الفاتح والداكن" Style="{StaticResource SetHint}" />
                        </VerticalStackLayout>
                        <platform:AppToggle Grid.Column="1"
                                            AutomationId="Settings_DarkModeToggle"
                                            IsToggled="{Binding IsDarkMode, Mode=TwoWay}"
                                            OnColor="{DynamicResource Brand}"
                                            ThumbColor="White"
                                            VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource SetDivider}" Margin="24,0" />

                    <!-- Save (kept: every field persists live on change; Save is the page-loaded marker
                         + confirm-no-pending the UI tests assert via Settings_SaveButton) -->
                    <HorizontalStackLayout Padding="24,16" Spacing="12">
                        <platform:AppButton AutomationId="Settings_SaveButton"
                                            Text="حفظ"
                                            Command="{Binding SaveCommand}"
                                            BackgroundColor="{DynamicResource Brand}"
                                            TextColor="{DynamicResource OnBrand}" />
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="40" Color="Transparent" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>

</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MostaqlK.Features.Onboarding.Views.OnboardingPage"
             BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#202B46}"
             Title="MostaqlK">
    <Grid x:Name="Root" AutomationId="onboarding-page" Padding="28" RowDefinitions="Auto,*,Auto,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" FlowDirection="LeftToRight" Margin="0,0,0,12">
            <Label Text="MostaqlK" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#172033, Dark=#FFFFFF}" />
            <Button Grid.Column="1" Text="تخطي" Command="{Binding SkipCommand}" AutomationId="onboarding-top-skip" BackgroundColor="Transparent" />
        </Grid>
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="12" HorizontalOptions="Center" FlowDirection="RightToLeft">
                <Image x:Name="Illustration" Source="{Binding CurrentIllustration}" Aspect="AspectFit" HeightRequest="280" WidthRequest="440" AutomationId="onboarding-illustration" />
                <Label Text="{Binding CurrentTitle}" FontAttributes="Bold" FontSize="34" LineHeight="1.35" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light=#172033, Dark=#FFFFFF}" AutomationId="onboarding-heading" />
                <Label Text="{Binding CurrentDescription}" FontSize="18" LineHeight="1.45" HorizontalTextAlignment="Center" MaximumWidthRequest="680" TextColor="{AppThemeBinding Light=#64748B, Dark=#C9D3E6}" />
                <VerticalStackLayout IsVisible="{Binding IsQueryStep}" Spacing="10" Margin="0,12,0,0" MaximumWidthRequest="600">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="استعلام المشاريع" FontAttributes="Bold" FontSize="16" />
                        <Label Grid.Column="1" Text="يمكنك تغييره لاحقًا" FontSize="13" />
                    </Grid>
                    <Border StrokeThickness="1" Stroke="#D7E0EE" StrokeShape="RoundRectangle 16" Padding="12,0" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#18233B}">
                        <Grid ColumnDefinitions="Auto,*" FlowDirection="LeftToRight">
                            <Label Text="projects?" VerticalOptions="Center" FontSize="14" />
                            <Entry Grid.Column="1" Text="{Binding QueryParams}" Placeholder="category=development&amp;sort=latest" FontSize="16" FlowDirection="LeftToRight" AutomationId="onboarding-query-input" />
                        </Grid>
                    </Border>
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="تطوير" CommandParameter="category=development&amp;sort=latest" Command="{Binding SelectPresetCommand}" AutomationId="onboarding-preset-development" />
                        <Button Text="الأحدث" CommandParameter="sort=latest" Command="{Binding SelectPresetCommand}" AutomationId="onboarding-preset-latest" />
                        <Button Text="كل المشاريع" CommandParameter="" Command="{Binding SelectPresetCommand}" AutomationId="onboarding-preset-all" />
                    </HorizontalStackLayout>
                    <Label Text="استخدم الفواصل بين القيم، وسنرتب النتائج حسب اهتماماتك." FontSize="13" />
                    <HorizontalStackLayout HorizontalOptions="End" Spacing="12">
                        <Button Text="تخطي والبدء" Command="{Binding SkipCommand}" AutomationId="onboarding-query-skip" />
                        <Button Text="حفظ والبدء" Command="{Binding SaveCommand}" AutomationId="onboarding-query-save" BackgroundColor="#168F42" TextColor="White" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <HorizontalStackLayout Grid.Row="2" HorizontalOptions="Center" Spacing="8" Margin="0,14,0,14">
            <Label Text="{Binding CurrentStep, StringFormat='{0}/6'}" FontSize="14" />
        </HorizontalStackLayout>
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" FlowDirection="RightToLeft">
            <Button Text="{Binding NextLabel}" Command="{Binding NextCommand}" AutomationId="onboarding-next-button" BackgroundColor="#168F42" TextColor="White" FontAttributes="Bold" FontSize="16" Padding="24,12" />
            <Button Grid.Column="2" Text="رجوع" Command="{Binding BackCommand}" IsVisible="{Binding CanGoBack}" AutomationId="onboarding-back-button" BackgroundColor="Transparent" FontSize="16" />
        </Grid>
    </Grid>
</ContentPage>
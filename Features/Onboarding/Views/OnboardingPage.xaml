<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:MostaqlK.UI.PlatformComponents"
             xmlns:ds="clr-namespace:MostaqlK.UI.DesignSystem"
             xmlns:conv="clr-namespace:MostaqlK.UI.DesignSystem.Converters"
             xmlns:vm="clr-namespace:MostaqlK.Features.Onboarding.ViewModels"
             x:Class="MostaqlK.Features.Onboarding.Views.OnboardingPage"
             BackgroundColor="{DynamicResource SurfaceShellAlt}"
             Title="">
    <ContentPage.Resources>
        <conv:InvertedBoolConverter x:Key="InvertedBoolConverter" />

        <!-- One platform card: identity from the descriptor, live switch state from PlatformEnablement.
             The switch lives in the FOOTER row — on WinUI a Switch reserves ~100px, and in the header
             it crushed the name column into per-word wraps. Colors bind to view-model Color properties
             resolved from the token table / the module's own brand set, so no hex and no
             AppThemeBinding exists here (both are build-gated). -->
        <DataTemplate x:Key="PlatformCardTemplate">
            <Border StrokeThickness="1.5" Stroke="{Binding CardStroke}" StrokeShape="RoundRectangle 20"
                    BackgroundColor="{DynamicResource Surface}" Padding="16,14,16,0"
                    WidthRequest="340" AutomationId="{Binding CardAutomationId}">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.08" Radius="14" Offset="0,6" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                        <Border WidthRequest="42" HeightRequest="42" StrokeThickness="0" BackgroundColor="{Binding GlyphFill}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Label Text="{Binding Glyph}" FontFamily="TajawalBold" FontSize="18" FontAttributes="Bold"
                                   TextColor="{Binding GlyphOnText}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="{Binding NameAr}" FontFamily="TajawalBold" FontSize="16" FontAttributes="Bold"
                                   TextColor="{DynamicResource TextPrimary}" LineBreakMode="NoWrap" />
                            <Label Text="{Binding TaglineAr}" IsVisible="{Binding HasTagline}"
                                   FontFamily="Tajawal" FontSize="12" TextColor="{DynamicResource TextMuted}"
                                   MaxLines="2" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding CadenceText}" FontFamily="Tajawal" FontSize="11.5"
                                   TextColor="{DynamicResource TextMuted}" LineBreakMode="NoWrap" />
                        </VerticalStackLayout>
                    </Grid>
                    <Label Text="{Binding DescriptionAr}" FontFamily="Tajawal" FontSize="13" LineHeight="1.4"
                           TextColor="{DynamicResource TextDescription}" MaxLines="2" LineBreakMode="TailTruncation" />
                    <BoxView HeightRequest="1" Color="{DynamicResource BorderSubtle}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,0,0,12">
                        <Label Text="{Binding StateText}" FontFamily="TajawalBold" FontSize="12" FontAttributes="Bold"
                               TextColor="{Binding StateTextColor}" VerticalOptions="Center" LineBreakMode="NoWrap" />
                        <Switch Grid.Column="2" VerticalOptions="Center" Style="{StaticResource AppToggleBase}"
                                IsToggled="{Binding IsEnabled, Mode=OneWay}"
                                IsEnabled="{Binding IsLocked, Converter={StaticResource InvertedBoolConverter}}"
                                Toggled="OnPlatformToggled"
                                AutomationId="{Binding SwitchAutomationId}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <!-- One interest chip: a plain Button (invokable, keyboard-reachable, UIA-measurable);
             selected state carried by the ✓ in its text + token colors, never color alone. -->
        <DataTemplate x:Key="InterestChipTemplate">
            <Button Text="{Binding ChipDisplayText}"
                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:OnboardingViewModel}}, Path=ToggleInterestCommand}"
                    CommandParameter="{Binding}"
                    BackgroundColor="{Binding ChipBackground}"
                    BorderColor="{Binding ChipBorder}"
                    BorderWidth="1.5"
                    CornerRadius="999"
                    Padding="16,9"
                    FontFamily="TajawalBold"
                    FontSize="13.5"
                    TextColor="{Binding ChipTextColor}"
                    AutomationId="{Binding ChipAutomationId}" />
        </DataTemplate>
    </ContentPage.Resources>
    <Grid Padding="8">
        <Border x:Name="Root" AutomationId="onboarding-page" Padding="20"
                StrokeThickness="0"
                BackgroundColor="{DynamicResource SurfaceDeep}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="28" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.15" Radius="30" Offset="0,10" />
            </Border.Shadow>
            <Grid RowDefinitions="Auto,*,Auto,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" FlowDirection="LeftToRight" Margin="0,0,0,12">
                    <Label Text="مستقلك" FontFamily="TajawalBold" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource TextDisplay}" />
                    <Button Grid.Column="1" Text="تخطي" FontFamily="TajawalMedium" Command="{Binding SkipCommand}" AutomationId="onboarding-top-skip" BackgroundColor="Transparent" TextColor="{DynamicResource TextDescription}" FontSize="14">
                        <Button.Behaviors>
                            <ds:PressableEffect ApplyHoverHighlight="False" />
                        </Button.Behaviors>
                    </Button>
                </Grid>
                <ScrollView Grid.Row="1">
                    <VerticalStackLayout Spacing="22" HorizontalOptions="Center" Padding="0,10" FlowDirection="RightToLeft">
                        <Border x:Name="ImageWrapper" IsVisible="{Binding HasIllustration}" Padding="0" StrokeThickness="0" WidthRequest="340" HeightRequest="340"
                                BackgroundColor="{DynamicResource SurfaceWarningSoft}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black" Opacity="0.10" Radius="18" Offset="0,6" />
                            </Border.Shadow>
                            <!--
                            OnboardingStepImage (not a plain Image) wraps this illustration through
                            PlatformImage's per-platform resolution/caching seam - see
                            UI/PlatformComponents/PlatformImage/OnboardingStepImage.cs. Today it
                            resolves the identical asset on every platform (no separate mobile art
                            exists yet), but the seam is now in place for when it does.
                            -->
                            <ui:OnboardingStepImage x:Name="Illustration" StepImageFileName="{Binding CurrentIllustration}" Aspect="AspectFit" Margin="20" AutomationId="onboarding-illustration" />
                        </Border>
                        <Border x:Name="BadgeBorder" IsVisible="{Binding IsBadgeVisible}" HorizontalOptions="Center" Padding="14,6" StrokeThickness="1"
                                Stroke="{DynamicResource BorderPositiveBrush}"
                                BackgroundColor="{DynamicResource SurfacePositiveSoft}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                                <ui:AppIcon Icon="Bolt" WidthRequest="14" HeightRequest="14" TextColor="{DynamicResource PositiveAction}" VerticalOptions="Center" />
                                <Label Text="{Binding BadgeText}" FontFamily="TajawalBold" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource PositiveAction}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Label x:Name="HeadingLabel" FontAttributes="Bold" FontSize="34" LineHeight="1.35" HorizontalTextAlignment="Center" AutomationId="onboarding-heading" FontFamily="TajawalBold">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding TitleBefore}" FontFamily="TajawalBold" TextColor="{DynamicResource TextDisplay}" />
                                    <Span Text="{Binding TitleAccent}" FontFamily="TajawalBold" TextColor="{DynamicResource PositiveAccent}" />
                                    <Span Text="{Binding TitleAfter}" FontFamily="TajawalBold" TextColor="{DynamicResource TextDisplay}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label x:Name="DescriptionLabel" Text="{Binding CurrentDescription}" FontFamily="Tajawal" FontSize="18" LineHeight="1.45" HorizontalTextAlignment="Center" MaximumWidthRequest="680" TextColor="{DynamicResource TextDescription}" />

                        <!-- Choice step: two named groups, each with its own header rule, mirroring
                             the approved mockup. No query field, no theme control. -->
                        <VerticalStackLayout x:Name="ChoicePanel" IsVisible="{Binding IsChoiceStep}" Spacing="20" MaximumWidthRequest="700">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Label Text="المنصات" FontFamily="TajawalBold" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center" />
                                    <BoxView Grid.Column="1" HeightRequest="1" Color="{DynamicResource BorderSubtle}" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding PlatformCountText}" FontFamily="Tajawal" FontSize="12" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" />
                                </Grid>
                                <FlexLayout BindableLayout.ItemsSource="{Binding Platforms}"
                                             BindableLayout.ItemTemplate="{StaticResource PlatformCardTemplate}"
                                             Direction="Row" Wrap="Wrap" JustifyContent="Center">
                                </FlexLayout>
                                <Border x:Name="LockNoticeBorder" IsVisible="{Binding LockNoticeVisible}" Padding="13,9" StrokeThickness="1"
                                        Stroke="{DynamicResource BorderSubtleBrush}" StrokeShape="RoundRectangle 14"
                                        BackgroundColor="{DynamicResource SurfaceSunken}"
                                        AutomationId="onboarding-choice-lock-note">
                                    <Label Text="يجب أن تبقى منصة واحدة على الأقل قيد المراقبة." FontFamily="Tajawal" FontSize="12.5"
                                           TextColor="{DynamicResource TextPrimary}" HorizontalTextAlignment="Center"
                                           AutomationId="onboarding-choice-lock-note" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Label Text="مجالات اهتمامك" FontFamily="TajawalBold" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center" />
                                    <BoxView Grid.Column="1" HeightRequest="1" Color="{DynamicResource BorderSubtle}" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding InterestCountText}" FontFamily="Tajawal" FontSize="12" TextColor="{DynamicResource TextSecondary}" VerticalOptions="Center" />
                                </Grid>
                                <Label Text="{Binding InterestHintText}" FontFamily="Tajawal" FontSize="13" TextColor="{DynamicResource TextSecondary}" HorizontalTextAlignment="Center" />
                                <FlexLayout BindableLayout.ItemsSource="{Binding Interests}"
                                             BindableLayout.ItemTemplate="{StaticResource InterestChipTemplate}"
                                             Direction="Row" Wrap="Wrap" JustifyContent="Center">
                                </FlexLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
                <HorizontalStackLayout Grid.Row="2" HorizontalOptions="Center" Spacing="12" Margin="0,16,0,10" FlowDirection="RightToLeft">
                    <Grid>
                        <!--
                        NOTE: two static, pre-baked icon buttons toggled by IsVisible instead of a
                        single button whose ImageSource used to be re-resolved at runtime on every
                        step change (AppIconGlyph.ChevronLeft <-> CircleCheck via AppIconConverter).
                        That runtime resolution (ImageSource.FromFile on the UI thread, firing
                        together with several other bound properties during the step transition)
                        was the root cause of the crash documented in
                        docs/reports/onboarding-icon-crash-report.md. See
                        scripts/generate_onboarding_icons.py for how the white icon variants below
                        were generated.

                        Button.ImageSource is NOT used here on purpose: on Windows (WinUI), an
                        image assigned directly to a Button's ImageSource is a known rendering gap
                        - it stays invisible on first paint and only appears after some other
                        layout pass is forced (e.g. clicking the button, resizing the window).
                        Instead, each icon is a separate InputTransparent Image overlaid on top of
                        a plain text-only Button, exactly like the NextSpinnerIcon overlay below,
                        which has always rendered correctly on first paint.

                        Cross-platform note: although this pattern exists to dodge a Windows/WinUI
                        bug, the pattern itself (a plain-text Button + an AppIcon overlaid via
                        ZIndex, both standard MAUI/Grid composition) has NO platform-conditional
                        code anywhere - AppIcon.cs (see its own doc comment) is already confirmed
                        cross-platform-safe. So unlike the other findings in
                        docs/mobile-readiness/windows-workaround-findings.md, this one does NOT
                        need a .Windows.cs/.Windows.xaml split: there is no Windows-only branch to
                        isolate, and the composed technique is safe to ship unmodified to Android.
                        -->
                        <Button AutomationId="onboarding-next-button" ZIndex="0" BackgroundColor="{DynamicResource FixedPositiveAction}" TextColor="{DynamicResource FixedWhite}" FontFamily="TajawalBold" FontAttributes="Bold" FontSize="16" CornerRadius="14" Padding="24,12,54,12" Command="{Binding NextCommand}" IsEnabled="{Binding IsTransitioning, Converter={StaticResource InvertedBoolConverter}}"
                                IsVisible="{Binding IsFinalStep, Converter={StaticResource InvertedBoolConverter}}"
                                Text="{Binding NextLabel}">
                            <Button.Behaviors>
                                <ds:PressableEffect ApplyHoverHighlight="False" />
                            </Button.Behaviors>
                        </Button>
                        <Button AutomationId="onboarding-next-button-final" ZIndex="0" BackgroundColor="{DynamicResource FixedPositiveAction}" TextColor="{DynamicResource FixedWhite}" FontFamily="TajawalBold" FontAttributes="Bold" FontSize="16" CornerRadius="14" Padding="24,12,54,12" Command="{Binding NextCommand}" IsEnabled="{Binding IsTransitioning, Converter={StaticResource InvertedBoolConverter}}"
                                IsVisible="{Binding IsFinalStep}"
                                Text="{Binding NextLabel}">
                            <Button.Behaviors>
                                <ds:PressableEffect ApplyHoverHighlight="False" />
                            </Button.Behaviors>
                        </Button>
                        <!--
                        AppIcon (not a plain Image) is used here on purpose: plain XAML `Image`
                        elements share the same WinUI first-paint invisibility bug that
                        Button.ImageSource had (stays invisible until some other layout pass is
                        forced, e.g. a click). AppIcon sets its Image.Source in code-behind
                        (AppIcon.cs constructor) rather than via XAML markup, which is the same
                        mechanism NextSpinnerIcon below uses and which has always rendered
                        correctly on first paint.
                        -->
                        <ui:AppIcon x:Name="NextChevronIcon" ZIndex="1" Icon="ChevronLeft" FontSize="16" TextColor="{DynamicResource FixedWhite}" HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,22,0" InputTransparent="True"
                                    IsVisible="{Binding IsFinalStep, Converter={StaticResource InvertedBoolConverter}}" />
                        <ui:AppIcon x:Name="NextCheckIcon" ZIndex="1" Icon="CircleCheck" FontSize="16" TextColor="{DynamicResource FixedWhite}" HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,22,0" InputTransparent="True"
                                    IsVisible="{Binding IsFinalStep}" />
                        <!-- Explicit ZIndex guarantees this stays on top of the two toggled Button
                             siblings above: on Windows (WinUI), a sibling whose IsVisible flips at
                             runtime can be re-inserted into the native children collection, which
                             silently changes paint order and can cover elements that used to be on
                             top purely by XAML declaration order. -->
                        <ui:AppIcon x:Name="NextSpinnerIcon" ZIndex="1" Icon="Refresh" WidthRequest="16" HeightRequest="16" TextColor="{DynamicResource FixedWhite}" HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,22,0" IsVisible="False" Opacity="0" InputTransparent="True" />
                    </Grid>
                    <Button Text="رجوع" FontFamily="TajawalMedium" Command="{Binding BackCommand}" IsVisible="{Binding CanGoBack}" AutomationId="onboarding-back-button" BackgroundColor="Transparent" TextColor="{DynamicResource TextDescription}" FontSize="16">
                        <Button.Behaviors>
                            <ds:PressableEffect ApplyHoverHighlight="False" />
                        </Button.Behaviors>
                    </Button>
                </HorizontalStackLayout>
                <HorizontalStackLayout Grid.Row="3" HorizontalOptions="Center" Spacing="6" Margin="0,0,0,0" AutomationId="onboarding-step-dots">
                    <BoxView x:Name="StepDot0" WidthRequest="8" HeightRequest="8" CornerRadius="4" VerticalOptions="Center" />
                    <BoxView x:Name="StepDot1" WidthRequest="8" HeightRequest="8" CornerRadius="4" VerticalOptions="Center" />
                    <BoxView x:Name="StepDot2" WidthRequest="8" HeightRequest="8" CornerRadius="4" VerticalOptions="Center" />
                    <BoxView x:Name="StepDot3" WidthRequest="8" HeightRequest="8" CornerRadius="4" VerticalOptions="Center" />
                    <BoxView x:Name="StepDot4" WidthRequest="8" HeightRequest="8" CornerRadius="4" VerticalOptions="Center" />
                    <BoxView x:Name="StepDot5" WidthRequest="8" HeightRequest="8" CornerRadius="4" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>

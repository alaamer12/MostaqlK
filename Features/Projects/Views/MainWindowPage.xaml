<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:MostaqlK.UI.PlatformComponents"
             xmlns:design="clr-namespace:MostaqlK.UI.DesignSystem"
             xmlns:vm="clr-namespace:MostaqlK.Features.Projects.ViewModels"
             xmlns:views="clr-namespace:MostaqlK.Features.Projects.Views"
             xmlns:notifViews="clr-namespace:MostaqlK.Features.Notifications.Views"
             xmlns:sidebar="clr-namespace:MostaqlK.UI.PlatformComponents.AppSidebar"
             x:Class="MostaqlK.Features.Projects.Views.MainWindowPage"
             x:DataType="vm:ProjectFeedViewModel"
             Title="المشاريع"
             FlowDirection="RightToLeft">

    <!-- Layout mirrors projects.html: a shared sidebar nav (AppSidebar unit) and a scrollable
         project feed covering all four feed states: loading (ShimmerBox), empty/error
         (LabelWithSubText), and success (CollectionView of ProjectCard). Sidebar nav items
         match the mockup: المشاريع، البحث المتقدم، التنبيهات (badge)، الإعدادات، حول التطبيق. -->
    <Grid x:Name="Root" BackgroundColor="#F1F5F9" ColumnDefinitions="Auto,*">

    <sidebar:AppSidebar Grid.Column="0"
                         ActivePage="Projects"
                         StatValue="{Binding UnreadCount}"
                         ProjectsClicked="OnProjectsNavClicked"
                         AdvancedSearchClicked="OnAdvancedSearchNavClicked"
                         NotificationsClicked="OnNotificationsNavClicked"
                         SettingsClicked="OnSettingsNavClicked"
                         AboutClicked="OnAboutNavClicked" />

    <Grid x:Name="FeedContent" Grid.Column="1" RowDefinitions="32,Auto,Auto,Auto,*,Auto" Padding="24,20,24,0" RowSpacing="12" BackgroundColor="#F1F5F9">

        <BoxView Grid.Row="0" BackgroundColor="Transparent" InputTransparent="True" />

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" FlowDirection="RightToLeft">
            <Label Text="المشاريع" FontSize="26" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="MostaqlK" FontSize="11" TextColor="#64748B" VerticalOptions="Center" />
        </Grid>

        <Border Grid.Row="2" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="16,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <components:SearchInputField Text="{Binding SearchQuery}"
                                          Placeholder="بحث متقدم في المشاريع (العنوان، الوصف، المهارات...)"
                                          PlaceholderColor="#64748B"
                                          TextColor="#0F172A"
                                          DebounceMilliseconds="300"
                                          DebouncedCommand="{Binding SearchCommand}"
                                          ClearCommand="{Binding ClearSearchCommand}" />
        </Border>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Padding="4,0" FlowDirection="RightToLeft">
            <Label Text="الاستعلام النشط: كل المشاريع" FontSize="12" TextColor="#475569" />
            <Label Grid.Column="1" Text="تعديل ✎" FontSize="12" TextColor="#2563EB" />
        </Grid>

        <Grid Grid.Row="4" Margin="0,28,0,0">

            <!-- Loading state -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsLoading}">
                <design:ShimmerBox HeightRequest="88" />
                <design:ShimmerBox HeightRequest="88" />
                <design:ShimmerBox HeightRequest="88" />
            </VerticalStackLayout>

            <!-- Error state -->
            <VerticalStackLayout IsVisible="{Binding HasError}" VerticalOptions="Center">
                <design:LabelWithSubText Text="{Binding ErrorMessage}" SubText="اضغط لإعادة المحاولة." />
                <components:AppButton Text="إعادة المحاولة" Command="{Binding RefreshCommand}" HorizontalOptions="Center" Margin="0,12,0,0" />
            </VerticalStackLayout>

            <!-- Empty state -->
            <design:LabelWithSubText IsVisible="{Binding IsEmpty}"
                                      VerticalOptions="Center"
                                      Text="لا توجد مشاريع حالياً"
                                      SubText="سيتم عرض المشاريع الجديدة هنا فور توفرها." />

            <!-- Success state -->
            <ScrollView IsVisible="{Binding ShowFeed}">
                <CollectionView ItemsSource="{Binding Projects}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProjectCardViewModel">
                            <views:ProjectCard BindingContext="{Binding .}" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </ScrollView>

        </Grid>

        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Padding="4,10" BackgroundColor="White" FlowDirection="RightToLeft">
            <Label Text="●  الاتصال: متصل" TextColor="#2E9E6B" FontSize="12" />
            <Label Grid.Column="1" Text="آخر فحص: منذ 12 ثانية   ↻" TextColor="#64748B" FontSize="12" />
        </Grid>

    </Grid>

    <notifViews:RecentNotificationsFlyout x:Name="NotificationsFlyout"
                                           Grid.Column="1"
                                           IsVisible="False"
                                           HorizontalOptions="End"
                                           VerticalOptions="Start"
                                           Margin="0,12,12,0" />

    </Grid>

</ContentPage>

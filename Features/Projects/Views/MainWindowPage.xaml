<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:MostaqlK.UI.PlatformComponents"
             xmlns:design="clr-namespace:MostaqlK.UI.DesignSystem"
             xmlns:vm="clr-namespace:MostaqlK.Features.Projects.ViewModels"
             xmlns:views="clr-namespace:MostaqlK.Features.Projects.Views"
             xmlns:notifViews="clr-namespace:MostaqlK.Features.Notifications.Views"
             xmlns:sidebar="clr-namespace:MostaqlK.UI.PlatformComponents.AppSidebar"
             xmlns:dashboard="clr-namespace:MostaqlK.UI.PlatformComponents.PipelineDashboard"
             xmlns:lastscan="clr-namespace:MostaqlK.UI.PlatformComponents.LastScanStatus"
             x:Class="MostaqlK.Features.Projects.Views.MainWindowPage"
             x:DataType="vm:ProjectFeedViewModel"
             Title=""
             Shell.NavBarIsVisible="False"
             FlowDirection="RightToLeft"
             BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#020617}">

    <!-- Layout mirrors projects.html: sidebar + header controls + active-query + dense cards + footer. -->
    <!-- Colours follow the mockup's light/dark class pairs (bg-slate-100 dark:bg-slate-950 for the
         page, bg-white dark:bg-slate-900 for panels, border-slate-200 dark:border-slate-800). -->
    <!-- Columns (the page is RTL, so column 0 renders on the *right*): nav sidebar, project feed,
         drag handle, pipeline dashboard. The dashboard therefore sits on the visual left, opposite
         the nav rail, and the handle lets the user pan the boundary between the two sections
         within each one's minimum width (see OnRootSizeChanged). -->
    <Grid x:Name="Root"
          BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#020617}"
          ColumnDefinitions="Auto,*,Auto,Auto"
          SizeChanged="OnRootSizeChanged">

        <BoxView Grid.Column="0" Color="{AppThemeBinding Light=White, Dark=#0F172A}" />
        <sidebar:AppSidebar Grid.Column="0"
                            ActivePage="Projects"
                            StatValue="{Binding GlobalStatus.ProjectsAddedTodayText}"
                            ProjectsClicked="OnProjectsNavClicked"
                            AdvancedSearchClicked="OnAdvancedSearchNavClicked"
                            SettingsClicked="OnSettingsNavClicked"
                            AboutClicked="OnAboutNavClicked"
                            VerticalOptions="Fill" />

        <Grid x:Name="FeedContent"
              Grid.Column="1"
              RowDefinitions="Auto,*,Auto"
              Padding="24,24,24,0"
              BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#020617}">

            <!-- Header controls + active query -->
            <VerticalStackLayout Grid.Row="0" Spacing="16" Padding="0,0,0,8">

                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <!-- Header card content: `flex items-center justify-between gap-4` (16px). -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <!-- The mockup's search input is a `bg-slate-50 border border-slate-200
                             rounded-lg py-2.5` box with an absolutely-positioned magnifier at
                             `left-4` and the text inset by `pl-10 pr-4` (40px / 16px). MAUI's
                             Entry has no leading-icon slot or padding, so the box is composed
                             here around the shared SearchInputField unit. The inner grid is
                             forced LeftToRight because `left-4` is a physical edge, not a
                             start-edge, and the page itself is RTL. -->
                        <Border Grid.Column="0"
                                StrokeThickness="1"
                                HeightRequest="40"
                                VerticalOptions="Center"
                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1E293B}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="8"
                                  Padding="16,0"
                                  FlowDirection="LeftToRight">
                                <components:AppIcon Grid.Column="0"
                                                    Icon="Search"
                                                    FontSize="16"
                                                    TextColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}"
                                                    VerticalOptions="Center" />
                                <components:SearchInputField Grid.Column="1"
                                                              AutomationId="Projects_SearchInput"
                                                              FlowDirection="RightToLeft"
                                                              Text="{Binding SearchQuery}"
                                                              Placeholder="بحث متقدم في المشاريع (العنوان، الوصف، المهارات، الميزانية...)"
                                                              PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}"
                                                              TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}"
                                                              BackgroundColor="Transparent"
                                                              FontSize="14"
                                                              DebounceMilliseconds="300"
                                                              DebouncedCommand="{Binding SearchCommand}"
                                                              ClearCommand="{Binding ClearSearchCommand}"
                                                              VerticalOptions="Center"
                                                              FontFamily="Tajawal" />
                            </Grid>
                        </Border>

                        <HorizontalStackLayout Grid.Column="1" Spacing="16" VerticalOptions="Center">
                            <Label Text="{Binding PollIntervalText}"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                                   VerticalOptions="Center"
                                   FontFamily="Tajawal" />

                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                <components:AppIcon Icon="Gauge" FontSize="11" TextColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}" VerticalOptions="Center" />
                                <Label Text="{Binding RateLimitText}"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                                       VerticalOptions="Center"
                                       FontFamily="Tajawal" />
                            </HorizontalStackLayout>

                            <Border StrokeThickness="0"
                                    BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#112828}"
                                    Padding="10,4"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="6">
                                    <BoxView WidthRequest="8" HeightRequest="8" Color="{AppThemeBinding Light=#2E9E6B, Dark=#4FBF8C}" CornerRadius="4" VerticalOptions="Center" />
                                    <Label Text="{Binding LiveStatusText}"
                                           FontSize="14"
                                           FontFamily="TajawalBold"
                                           TextColor="{AppThemeBinding Light=#2E9E6B, Dark=#4FBF8C}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <Border StrokeThickness="0"
                                    AutomationId="Projects_TogglePollingButton"
                                    SemanticProperties.Description="إيقاف/بدء الفحص"
                                    BackgroundColor="#EF4444"
                                    Padding="12,6"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding TogglePollingCommand}" />
                                </Border.GestureRecognizers>
                                <Border.Behaviors>
                                    <design:PressableEffect ApplyHoverHighlight="True" />
                                </Border.Behaviors>
                                <!-- `flex items-center gap-1.5` with a leading `fa-solid fa-pause`. -->
                                <HorizontalStackLayout Spacing="6">
                                    <components:AppIcon Icon="Pause"
                                                        FontSize="12"
                                                        TextColor="White"
                                                        VerticalOptions="Center" />
                                    <Label Text="{Binding PollToggleLabel}"
                                           FontSize="14"
                                           FontFamily="TajawalBold"
                                           TextColor="White"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <Border StrokeThickness="0"
                                    AutomationId="Projects_NotificationsButton"
                                    SemanticProperties.Description="التنبيهات"
                                    BackgroundColor="Transparent"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnNotificationsButtonTapped" />
                                </Border.GestureRecognizers>
                                <Border.Behaviors>
                                    <design:PressableEffect ApplyHoverHighlight="True" />
                                </Border.Behaviors>
                                <components:AppIcon Icon="Bell"
                                                     FontSize="14"
                                                     TextColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Center" />
                            </Border>
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}"
                        Padding="16,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <components:AppIcon Icon="Filter" FontSize="11" TextColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}" VerticalOptions="Center" />
                            <Label Text="الاستعلام النشط:"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                                   VerticalOptions="Center"
                                   FontFamily="Tajawal" />
                            <Label Text="كل المشاريع"
                                   FontSize="13"
                                   FontFamily="TajawalBold"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                            <components:AppIcon Icon="Edit" WidthRequest="14" HeightRequest="14" TextColor="{AppThemeBinding Light=#2386C8, Dark=#5CA8DE}" VerticalOptions="Center" />
                            <Label Text="تعديل"
                                   FontSize="13"
                                   FontFamily="TajawalBold"
                                   TextColor="{AppThemeBinding Light=#2386C8, Dark=#5CA8DE}"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SearchCommand}" />
                                </Label.GestureRecognizers>
                                <Label.Behaviors>
                                    <design:PressableEffect ApplyHoverHighlight="True" />
                                </Label.Behaviors>
                            </Label>
                        </HorizontalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <Grid Grid.Row="1">

                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsLoading}">
                    <design:ShimmerBox HeightRequest="160" />
                    <design:ShimmerBox HeightRequest="160" />
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding HasError}" VerticalOptions="Center">
                    <design:LabelWithSubText Text="{Binding ErrorMessage}" SubText="اضغط لإعادة المحاولة." />
                    <components:AppButton Text="إعادة المحاولة" AutomationId="Projects_RetryButton" Command="{Binding RefreshCommand}" HorizontalOptions="Center" Margin="0,12,0,0" FontFamily="Tajawal" />
                </VerticalStackLayout>

                <design:LabelWithSubText IsVisible="{Binding IsEmpty}"
                                          AutomationId="Projects_EmptyStateLabel"
                                          VerticalOptions="Center"
                                          Text="{Binding EmptyStateTitle}"
                                          SubText="{Binding EmptyStateSubtitle}" />

                <CollectionView IsVisible="{Binding ShowFeed}"
                                AutomationId="Projects_ProjectsCollectionView"
                                ItemsSource="{Binding Projects}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProjectCardViewModel">
                            <views:ProjectCard BindingContext="{Binding .}" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </Grid>

            <!-- Footer status bar -->
            <Grid Grid.Row="2"
                  ColumnDefinitions="*,Auto"
                  Padding="0,12"
                  BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}">
                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                         VerticalOptions="Start"
                         Grid.ColumnSpan="2" />

                <HorizontalStackLayout Spacing="10" VerticalOptions="Center" Margin="0,4,0,0">
                    <Label Text="{Binding TrackedCountText}" AutomationId="Projects_TrackedCountLabel" FontSize="11" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" VerticalOptions="Center" FontFamily="Tajawal" />
                    <BoxView WidthRequest="4" HeightRequest="4" Color="{AppThemeBinding Light=#CBD5E1, Dark=#475569}" CornerRadius="2" VerticalOptions="Center" />
                    <Label Text="{Binding UnreadCountText}" AutomationId="Projects_UnreadCountLabel" FontSize="11" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#2386C8, Dark=#5CA8DE}" VerticalOptions="Center" />
                    <Label Text="تحديد الكل كمقروء"
                           AutomationId="Projects_MarkAllReadLabel"
                           FontSize="11"
                           TextColor="{AppThemeBinding Light=#2386C8, Dark=#5CA8DE}"
                           VerticalOptions="Center"
                           FontFamily="Tajawal">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding MarkAllReadCommand}" />
                        </Label.GestureRecognizers>
                        <Label.Behaviors>
                            <design:PressableEffect ApplyHoverHighlight="True" />
                        </Label.Behaviors>
                    </Label>
                </HorizontalStackLayout>

                <HorizontalStackLayout Grid.Column="1" Spacing="16" VerticalOptions="Center" Margin="0,4,0,0">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <!-- This line was hard-coded to "متصل" with a permanently green dot, so a
                             pipeline whose every scan was being rejected still reported itself
                             connected. It now follows the real scan outcome. -->
                        <Label Text="{Binding GlobalStatus.ConnectionText}"
                               AutomationId="Projects_ConnectionLabel"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                               VerticalOptions="Center"
                               FontFamily="Tajawal" />
                        <BoxView WidthRequest="8" HeightRequest="8" Color="#22C55E" CornerRadius="4" VerticalOptions="Center"
                                 IsVisible="{Binding GlobalStatus.IsConnectionHealthy}" />
                        <BoxView WidthRequest="8" HeightRequest="8" Color="#EF4444" CornerRadius="4" VerticalOptions="Center"
                                 IsVisible="{Binding GlobalStatus.LastScanFailed}" />
                    </HorizontalStackLayout>
                    <!-- Same shared readout the pipeline dashboard's discovery card uses, reading
                         the pipeline's own scan timestamp rather than the feed's last load - which
                         is why the footer no longer drifts past the poll interval. -->
                    <lastscan:LastScanStatus AutomationId="Projects_LastScanStatus"
                                             LabelAutomationId="Projects_LastScanLabel"
                                             RefreshAutomationId="Projects_RefreshLabel"
                                             LastScanAt="{Binding GlobalStatus.LastScanCompletedAt}"
                                             ShowRefresh="True"
                                             RefreshCommand="{Binding RefreshCommand}"
                                             FontSize="11"
                                             TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                                             VerticalOptions="Center" />

                    <!-- The 56px radar dial used to live here. It was unreadable at that size and
                         faded out entirely once the pipeline settled, so it moved to the pipeline
                         dashboard column (see PipelinePanel below). -->
                </HorizontalStackLayout>
            </Grid>

        </Grid>

        <components:SplitterHandle x:Name="PanelSplitter"
                                   Grid.Column="2"
                                   AutomationId="Pipeline_ResizeHandle"
                                   Minimum="260"
                                   Maximum="560"
                                   DragSign="-1"
                                   IsVisible="{Binding Source={x:Reference PipelinePanel}, Path=IsExpanded}"
                                   Value="{Binding Source={x:Reference PipelinePanel}, Path=ExpandedWidth, Mode=TwoWay}"
                                   DragCompleted="OnPanelSplitterDragCompleted" />

        <dashboard:PipelineDashboardPanel x:Name="PipelinePanel"
                                          Grid.Column="3"
                                          AutomationId="Pipeline_DashboardPanel"
                                          VerticalOptions="Fill"
                                          DiscoveryProgress="{Binding GlobalStatus.DiscoveryProgress}"
                                          QueuePressure="{Binding GlobalStatus.QueuePressure}"
                                          QueueCount="{Binding GlobalStatus.QueueCount}"
                                          QueueCapacity="{Binding GlobalStatus.QueueCapacity}"
                                          EnrichmentActivity="{Binding GlobalStatus.EnrichmentActivity}"
                                          IsSnapshotActive="{Binding GlobalStatus.IsSnapshotActive}" />

        <!-- Full-page transparent backdrop, shown together with the flyout so a click anywhere
             outside of it (auto-dismiss, like any normal menu/popover) closes it too - before this
             the only way out was re-clicking the bell/sidebar entry that opened it. -->
        <BoxView x:Name="NotificationsBackdrop"
                 Grid.ColumnSpan="4"
                 Color="Transparent"
                 IsVisible="False"
                 InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnNotificationsBackdropTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <notifViews:RecentNotificationsFlyout x:Name="NotificationsFlyout"
                                               AutomationId="Notifications_Flyout"
                                               Grid.Column="1"
                                               IsVisible="False"
                                               HorizontalOptions="End"
                                               VerticalOptions="Start"
                                               Margin="0,12,12,0" />

    </Grid>

</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:rail="clr-namespace:MostaqlK.UI.PlatformComponents.SourceRail"
             xmlns:components="clr-namespace:MostaqlK.UI.PlatformComponents"
             xmlns:ds="clr-namespace:MostaqlK.UI.DesignSystem"
             x:Class="MostaqlK.Features.Projects.Views.Layouts.AboutPageWindowsLayout"
             FlowDirection="RightToLeft">

    <!-- v3 shell (contract §3): the 64px SourceRail replaces the 256px AppSidebar, physical LEFT
         (rail rides the last column of this RTL grid → reclaiming 192px). Content (dev23-era About
         cards) is untouched — shell swap only. BindingContext is the GlobalAppStatusService, so the
         bell's unread pill binds UnreadNotificationCount directly. -->
    <Grid BackgroundColor="{DynamicResource Background}">
        <!-- Rail track pinned (never Auto): an Auto rail column is resolved after the content star
             and lands outside the window frame (RTL clips at the physical left). -->
        <!-- v4 D41: rail column 0 = physical right in RTL; content column 1. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{x:Static rail:RailWidths.ColumnWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <rail:SourceRail Grid.Column="0"
                         x:Name="Rail"
                         ActivePage="About"
                         UnreadCount="{Binding UnreadNotificationCount}"
                         ProjectsClicked="OnProjectsNavClicked"
                         AdvancedSearchClicked="OnAdvancedSearchNavClicked"
                         SettingsClicked="OnSettingsNavClicked"
                         AboutClicked="OnAboutNavClicked"
                         NotificationsClicked="OnRailNotificationsClicked" />

        <Grid Grid.Column="1" RowDefinitions="32,Auto,*" Padding="24,20,24,24" RowSpacing="16">
            <BoxView Grid.Row="0" BackgroundColor="Transparent" InputTransparent="True" />

            <Border Grid.Row="1" StrokeThickness="1" Stroke="{DynamicResource BorderSubtleBrush}" BackgroundColor="{DynamicResource Surface}" Padding="16,12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label Text="حول التطبيق" FontSize="16" FontFamily="TajawalBold" TextColor="{DynamicResource TextPrimary}" />
            </Border>

            <ScrollView Grid.Row="2" AutomationId="About_ScrollView">
                <VerticalStackLayout Spacing="16">

                    <!-- Identity card -->
                    <Border Padding="24" StrokeThickness="1" Stroke="{DynamicResource BorderSubtleBrush}" BackgroundColor="{DynamicResource Surface}" HorizontalOptions="Fill">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Border WidthRequest="64" HeightRequest="64" StrokeThickness="0" BackgroundColor="{DynamicResource AvatarTile}" HorizontalOptions="Center">
                                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                                <Label Text="M" TextColor="{DynamicResource FixedWhite}" FontFamily="TajawalBold" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="Mostaqlk" FontSize="20" FontFamily="TajawalBold" TextColor="{DynamicResource TextPrimary}" HorizontalTextAlignment="Center" />
                            <Border Padding="12,4" BackgroundColor="{DynamicResource SurfaceSunken}" StrokeThickness="0" HorizontalOptions="Center">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                <Label x:Name="VersionLabel" FontSize="11" TextColor="{DynamicResource TextFaint}" FontFamily="Tajawal" />
                            </Border>
                            <Label Text="تطبيق سطح مكتب لنظام Windows يراقب صفحة المشاريع المفتوحة في مستقل وينبّهك خلال دقيقة تقريبًا من نشر مشروع جديد، مع حفظ كامل تفاصيله محليًا للرجوع إليها لاحقًا دون اتصال."
                                   FontSize="13" TextColor="{DynamicResource TextSecondary}" HorizontalTextAlignment="Center" MaximumWidthRequest="420"
                                   FontFamily="Tajawal" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Quick facts -->
                    <Border Padding="0" StrokeThickness="1" Stroke="{DynamicResource BorderSubtleBrush}" BackgroundColor="{DynamicResource Surface}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <VerticalStackLayout>
                            <HorizontalStackLayout Padding="20,14,20,10" Spacing="8">
                                <components:AppIcon Icon="List" FontSize="14" TextColor="{DynamicResource TextFaint}" VerticalOptions="Center" />
                                <Label Text="حقائق سريعة" FontSize="14" FontFamily="TajawalBold" TextColor="{DynamicResource TextPrimary}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource SurfaceSunken}" />
                            
                            <Grid ColumnDefinitions="Auto,*" Padding="20,14">
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <components:AppIcon Icon="Windows" FontSize="14" TextColor="{DynamicResource TextMuted}" WidthRequest="20" HorizontalOptions="Center" />
                                    <Label Text="المنصة" TextColor="{DynamicResource TextMuted}" FontSize="13" FontFamily="Tajawal" />
                                </HorizontalStackLayout>
                                <Label Grid.Column="1" Text="تطبيق سطح مكتب لنظام Windows (مقيم في شريط المهام)" 
                                       TextColor="{DynamicResource TextStrong}" FontSize="13" FontFamily="TajawalBold" 
                                       HorizontalOptions="End" VerticalOptions="Center" />
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource SurfaceSunken}" />
                            
                            <Grid ColumnDefinitions="Auto,*" Padding="20,14">
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <components:AppIcon Icon="Database" FontSize="14" TextColor="{DynamicResource TextMuted}" WidthRequest="20" HorizontalOptions="Center" />
                                    <Label Text="التخزين" TextColor="{DynamicResource TextMuted}" FontSize="13" FontFamily="Tajawal" />
                                </HorizontalStackLayout>
                                <Label Grid.Column="1" Text="قاعدة بيانات محلية مُضمَّنة — بلا خادر أو سحابة" 
                                       TextColor="{DynamicResource TextStrong}" FontSize="13" FontFamily="TajawalBold" 
                                       HorizontalOptions="End" VerticalOptions="Center" />
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource SurfaceSunken}" />
                            
                            <Grid ColumnDefinitions="Auto,*" Padding="20,14">
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <components:AppIcon Icon="Gauge" FontSize="14" TextColor="{DynamicResource TextMuted}" WidthRequest="20" HorizontalOptions="Center" />
                                    <Label Text="حد الطلبات" TextColor="{DynamicResource TextMuted}" FontSize="13" FontFamily="Tajawal" />
                                </HorizontalStackLayout>
                                <Label Grid.Column="1" Text="قابل للتعديل — الافتراضي ~2 طلب/دقيقة" 
                                       TextColor="{DynamicResource TextStrong}" FontSize="13" FontFamily="TajawalBold" 
                                       HorizontalOptions="End" VerticalOptions="Center" />
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource SurfaceSunken}" />
                            
                            <Grid ColumnDefinitions="Auto,*" Padding="20,14">
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <components:AppIcon Icon="Archive" FontSize="14" TextColor="{DynamicResource TextMuted}" WidthRequest="20" HorizontalOptions="Center" />
                                    <Label Text="سياسة البيانات" TextColor="{DynamicResource TextMuted}" FontSize="13" FontFamily="Tajawal" />
                                </HorizontalStackLayout>
                                <Label Grid.Column="1" Text="يُجلب المشروع مرة واحدة ولا يُحدَّث لاحقًا" 
                                       TextColor="{DynamicResource TextStrong}" FontSize="13" FontFamily="TajawalBold" 
                                       HorizontalOptions="End" VerticalOptions="Center" />
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource SurfaceSunken}" />
                            
                            <Grid ColumnDefinitions="Auto,*" Padding="20,14">
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <components:AppIcon Icon="Language" FontSize="14" TextColor="{DynamicResource TextMuted}" WidthRequest="20" HorizontalOptions="Center" />
                                    <Label Text="اللغة" TextColor="{DynamicResource TextMuted}" FontSize="13" FontFamily="Tajawal" />
                                </HorizontalStackLayout>
                                <Label Grid.Column="1" Text="العربية أساسًا، مع دعم كامل للإنجليزية في البحث" 
                                       TextColor="{DynamicResource TextStrong}" FontSize="13" FontFamily="TajawalBold" 
                                       HorizontalOptions="End" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Version scope -->
                    <Border Padding="0" StrokeThickness="1" Stroke="{DynamicResource BorderSubtleBrush}" BackgroundColor="{DynamicResource Surface}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <VerticalStackLayout>
                            <Label Text="نطاق الإصدارات" FontSize="14" FontFamily="TajawalBold" TextColor="{DynamicResource TextPrimary}" Padding="20,14,20,10" />
                            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource SurfaceSunken}" />

                            <VerticalStackLayout Padding="20,14" Spacing="4">
                                <HorizontalStackLayout Spacing="8">
                                    <Ellipse Fill="{DynamicResource PositiveBrush}" WidthRequest="8" HeightRequest="8" VerticalOptions="Center" />
                                    <Label Text="v1 — الإصدار الحالي (MVP)" FontSize="13" FontFamily="TajawalBold" TextColor="{DynamicResource TextStrong}" />
                                </HorizontalStackLayout>
                                <Label Text="فحص &gt; اكتشاف &gt; إثراء &gt; تخزين &gt; تنبيه، مع نافذة أساسية وشريط مهام. الإعداد الوحيد المتاح حاليًا هو استعلام الفحص (query_params)."
                                       FontSize="11" TextColor="{DynamicResource TextMuted}" Margin="16,0,0,0"
                                       FontFamily="Tajawal" />
                            </VerticalStackLayout>
                            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource SurfaceSunken}" />

                            <VerticalStackLayout Padding="20,14" Spacing="4">
                                <HorizontalStackLayout Spacing="8">
                                    <Ellipse Fill="{DynamicResource BorderMutedBrush}" WidthRequest="8" HeightRequest="8" VerticalOptions="Center" />
                                    <Label Text="v2 — قادم" FontSize="13" FontFamily="TajawalBold" TextColor="{DynamicResource TextSubtle}" />
                                </HorizontalStackLayout>
                                <Label Text="تنزيل المرفقات، تجميع التنبيهات، تمييز المقروء/غير المقروء، بحث نصي كامل، ومُنشئ استعلامات متقدم."
                                       FontSize="11" TextColor="{DynamicResource TextFaint}" Margin="16,0,0,0"
                                       FontFamily="Tajawal" />
                            </VerticalStackLayout>
                            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource SurfaceSunken}" />

                            <VerticalStackLayout Padding="20,14" Spacing="4">
                                <HorizontalStackLayout Spacing="8">
                                    <Ellipse Fill="{DynamicResource BorderMutedBrush}" WidthRequest="8" HeightRequest="8" VerticalOptions="Center" />
                                    <Label Text="v3 — مستقبلي" FontSize="13" FontFamily="TajawalBold" TextColor="{DynamicResource TextSubtle}" />
                                </HorizontalStackLayout>
                                <Label Text="تطبيق مرافق للجوال، مزامنة عبر الشبكة المحلية، وتنبيهات push."
                                       FontSize="11" TextColor="{DynamicResource TextFaint}" Margin="16,0,0,0"
                                       FontFamily="Tajawal" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="Mostaqlk ليس تابعًا لمنصة Mostaql.com ولا معتمدًا رسميًا منها." AutomationId="About_MostaqlLink" FontSize="12" TextColor="{DynamicResource TextFaint}" HorizontalOptions="Center" FontFamily="Tajawal">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMostaqlLinkTapped" />
                        </Label.GestureRecognizers>
                        <Label.Behaviors>
                            <ds:PressableEffect ApplyHoverHighlight="True" />
                        </Label.Behaviors>
                    </Label>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>

</ContentView>

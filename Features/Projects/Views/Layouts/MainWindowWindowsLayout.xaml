<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:MostaqlK.UI.PlatformComponents"
             xmlns:design="clr-namespace:MostaqlK.UI.DesignSystem"
             xmlns:vm="clr-namespace:MostaqlK.Features.Projects.ViewModels"
             xmlns:views="clr-namespace:MostaqlK.Features.Projects.Views"
             xmlns:notifViews="clr-namespace:MostaqlK.Features.Notifications.Views"
             xmlns:rail="clr-namespace:MostaqlK.UI.PlatformComponents.SourceRail"
             xmlns:dashboard="clr-namespace:MostaqlK.UI.PlatformComponents.PipelineDashboard"
             xmlns:lastscan="clr-namespace:MostaqlK.UI.PlatformComponents.LastScanStatus"
             xmlns:filtermodal="clr-namespace:MostaqlK.UI.PlatformComponents.FilterModal"
             x:Class="MostaqlK.Features.Projects.Views.Layouts.MainWindowWindowsLayout"
             x:DataType="vm:ProjectFeedViewModel"
             FlowDirection="RightToLeft"
             BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#0F172A}">

    <ContentView.Resources>
        <ResourceDictionary>
            <!-- Paused poll-pill state colours (a STATE colour, never brand). Setter.Value cannot
                 take an AppThemeBinding in MAUI, so the paused variant uses fixed green tokens. -->
            <Color x:Key="PausedGreen">#2E9E6B</Color>
            <Color x:Key="PausedGreenSoft">#262E9E6B</Color>
        </ResourceDictionary>
    </ContentView.Resources>

    <!-- v3 projects feed — restyled to projects.html (pixel truth). Structure mirrors the mockup's
         main column: a full-width title header (centered title + cadence caption + top-right today
         card), a content row (pipeline panel + splitter + feed column whose top holds the search +
         الفلاتر row above the continuous rows), and a full-width footer (count cluster · active query
         · last-scan + poll pill). -->
    <!-- Columns stay RTL-ordered as before (column 0 renders on the *right*): pipeline dashboard, drag
         handle, project feed, nav rail. The rail (col 3) and the header/footer span the panel+feed
         columns (0..2) so the title band and footer stretch full width, exactly like the mockup.
         Panel/feed/rail split is unchanged; the splitter pans the panel/feed boundary (OnRootSizeChanged
         clamps it against the shared RailWidths token). -->
    <Grid x:Name="Root"
          BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#0F172A}"
          ColumnDefinitions="Auto,Auto,*,Auto"
          RowDefinitions="Auto,*,Auto"
          SizeChanged="OnRootSizeChanged">

        <rail:SourceRail Grid.Column="3"
                         Grid.RowSpan="3"
                         x:Name="Rail"
                         ActivePage="Projects"
                         UnreadCount="{Binding GlobalStatus.UnreadNotificationCount}"
                         ProjectsClicked="OnProjectsNavClicked"
                         AdvancedSearchClicked="OnAdvancedSearchNavClicked"
                         SettingsClicked="OnSettingsNavClicked"
                         AboutClicked="OnAboutNavClicked"
                         NotificationsClicked="OnRailNotificationsClicked"
                         SourceChanged="OnSourceChanged"
                         VerticalOptions="Fill" />

        <!-- ============ HEADER (full-width surface band, bottom hairline) ============ -->
        <Grid Grid.Row="0"
              Grid.Column="0"
              Grid.ColumnSpan="3"
              Padding="24,20,24,16"
              RowDefinitions="Auto"
              BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}">

            <!-- Centered page title + cadence caption (the "يتم الفحص كل" string stays rendered here
                 for the cross-page poll-interval consistency test). -->
            <VerticalStackLayout Grid.Row="0" HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                <Label Text="المشاريع"
                       FontSize="30"
                       FontFamily="TajawalBold"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                    <Label Text="{Binding PollIntervalText}"
                           FontSize="12"
                           FontFamily="Tajawal"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                    <Label Text="·"
                           FontSize="12"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}" />
                    <Label Text="{Binding RateLimitText}"
                           FontSize="12"
                           FontFamily="Tajawal"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Today stat card — top-right (inline-start in RTL). Bordered soft box: label over a big
                 number bound to the existing per-source ProjectsAddedToday read. -->
            <Border Grid.Row="0"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                    BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#172032}"
                    Padding="14,8">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label Text="أُضيفت اليوم"
                           FontSize="11"
                           FontFamily="TajawalBold"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                    <Label Text="{Binding GlobalStatus.ProjectsAddedTodayText}"
                           AutomationId="Sidebar_StatValueLabel"
                           FontSize="26"
                           FontFamily="TajawalBold"
                           HorizontalTextAlignment="Center"
                           TextColor="{DynamicResource BrandInk}" />
                </VerticalStackLayout>
            </Border>

            <!-- Bottom hairline. -->
            <BoxView Grid.Row="0"
                     HeightRequest="1"
                     VerticalOptions="End"
                     Color="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" />
        </Grid>

        <!-- ============ PIPELINE PANEL (reused shipped unit, active-source scoped) ============ -->
        <dashboard:PipelineDashboardPanel x:Name="PipelinePanel"
                                          Grid.Row="1"
                                          Grid.Column="0"
                                          AutomationId="Pipeline_DashboardPanel"
                                          VerticalOptions="Fill"
                                          DiscoveryProgress="{Binding GlobalStatus.DiscoveryProgress}"
                                          QueuePressure="{Binding GlobalStatus.QueuePressure}"
                                          QueueCount="{Binding GlobalStatus.QueueCount}"
                                          QueueCapacity="{Binding GlobalStatus.QueueCapacity}"
                                          EnrichmentActivity="{Binding GlobalStatus.EnrichmentActivity}"
                                          IsSnapshotActive="{Binding GlobalStatus.IsSnapshotActive}" />

        <components:SplitterHandle x:Name="PanelSplitter"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   AutomationId="Pipeline_ResizeHandle"
                                   Minimum="260"
                                   Maximum="560"
                                   DragSign="1"
                                   IsVisible="{Binding Source={x:Reference PipelinePanel}, Path=IsExpanded}"
                                   Value="{Binding Source={x:Reference PipelinePanel}, Path=ExpandedWidth, Mode=TwoWay}"
                                   DragCompleted="OnPanelSplitterDragCompleted" />

        <!-- ============ FEED COLUMN (search row + continuous rows) ============ -->
        <Grid Grid.Row="1"
              Grid.Column="2"
              RowDefinitions="Auto,*"
              BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}">

            <!-- Search row: full-width input (right) with the filters button docked at its left.
                 Lives INSIDE the feed column so the pipeline panel squeezes it (they are relative). -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="12"
                  Padding="24,16">
                <Border Grid.Column="0"
                        StrokeThickness="1"
                        HeightRequest="40"
                        VerticalOptions="Center"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                        BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#172032}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="8"
                          Padding="16,0"
                          FlowDirection="LeftToRight">
                        <components:AppIcon Grid.Column="0"
                                            Icon="Search"
                                            FontSize="16"
                                            TextColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}"
                                            VerticalOptions="Center" />
                        <components:SearchInputField Grid.Column="1"
                                                     AutomationId="Projects_SearchInput"
                                                     FlowDirection="RightToLeft"
                                                     Text="{Binding SearchQuery}"
                                                     Placeholder="{Binding SearchPlaceholder}"
                                                     PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}"
                                                     TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}"
                                                     BackgroundColor="Transparent"
                                                     FontSize="14"
                                                     DebounceMilliseconds="300"
                                                     DebouncedCommand="{Binding SearchCommand}"
                                                     ClearCommand="{Binding ClearSearchCommand}"
                                                     VerticalOptions="Center"
                                                     FontFamily="Tajawal" />
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        StrokeThickness="1"
                        HeightRequest="40"
                        AutomationId="Projects_FiltersButton"
                        SemanticProperties.Description="فلاتر البحث"
                        VerticalOptions="Center"
                        IsVisible="{Binding HasFilterFacets}"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                        Padding="14,0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOpenFiltersTapped" />
                    </Border.GestureRecognizers>
                    <Border.Behaviors>
                        <design:PressableEffect ApplyHoverHighlight="True" />
                    </Border.Behaviors>
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <components:AppIcon Icon="Filter"
                                            FontSize="12"
                                            TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                                            VerticalOptions="Center" />
                        <Label Text="الفلاتر"
                               FontSize="14"
                               FontFamily="TajawalBold"
                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- Rows region: lifecycle + CollectionView (continuous, hairline-divided — see ProjectCard). -->
            <Grid Grid.Row="1" Padding="0">

                <VerticalStackLayout Spacing="12" Padding="24,0" IsVisible="{Binding IsLoading}">
                    <design:ShimmerBox HeightRequest="150" />
                    <design:ShimmerBox HeightRequest="150" />
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding HasError}" VerticalOptions="Center">
                    <design:LabelWithSubText Text="{Binding ErrorMessage}" SubText="اضغط لإعادة المحاولة." />
                    <components:AppButton Text="إعادة المحاولة" AutomationId="Projects_RetryButton" Command="{Binding RefreshCommand}" HorizontalOptions="Center" Margin="0,12,0,0" FontFamily="Tajawal" />
                </VerticalStackLayout>

                <design:LabelWithSubText IsVisible="{Binding IsEmpty}"
                                         AutomationId="Projects_EmptyStateLabel"
                                         VerticalOptions="Center"
                                         Text="{Binding EmptyStateTitle}"
                                         SubText="{Binding EmptyStateSubtitle}" />

                <CollectionView x:Name="ProjectsCollectionView"
                                IsVisible="{Binding ShowFeed}"
                                AutomationId="Projects_ProjectsCollectionView"
                                ItemsSource="{Binding Projects}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProjectCardViewModel">
                            <views:ProjectCard BindingContext="{Binding .}" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>

        <!-- ============ FOOTER (full-width surface band, top hairline) ============ -->
        <Grid Grid.Row="2"
              Grid.Column="0"
              Grid.ColumnSpan="3"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="16"
              Padding="24,12"
              BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}">
            <BoxView Grid.ColumnSpan="3"
                     HeightRequest="1"
                     VerticalOptions="Start"
                     Color="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" />

            <!-- inline-start cluster: tracked count · unread · تحديد الكل كمقروء -->
            <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center" Margin="0,4,0,0">
                <Label Text="{Binding FooterTrackedText}" AutomationId="Projects_TrackedCountLabel" FontSize="11" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" VerticalOptions="Center" FontFamily="Tajawal" />
                <BoxView WidthRequest="4" HeightRequest="4" Color="{AppThemeBinding Light=#CBD5E1, Dark=#475569}" CornerRadius="2" VerticalOptions="Center" />
                <Label Text="{Binding UnreadCountText}" AutomationId="Projects_UnreadCountLabel" FontSize="11" FontFamily="TajawalBold" TextColor="{DynamicResource BrandInk}" VerticalOptions="Center" />
                <Label Text="تحديد الكل كمقروء"
                       AutomationId="Projects_MarkAllReadLabel"
                       FontSize="11"
                       TextColor="{DynamicResource BrandInk}"
                       VerticalOptions="Center"
                       FontFamily="Tajawal">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding MarkAllReadCommand}" />
                    </Label.GestureRecognizers>
                    <Label.Behaviors>
                        <design:PressableEffect ApplyHoverHighlight="True" />
                    </Label.Behaviors>
                </Label>
            </HorizontalStackLayout>

            <!-- center: active query + تعديل (opens the same FilterModal as الفلاتر). -->
            <HorizontalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,4,0,0">
                <components:AppIcon Icon="Filter" FontSize="10" TextColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}" VerticalOptions="Center" />
                <Label Text="الاستعلام النشط:"
                       FontSize="11"
                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                       VerticalOptions="Center"
                       FontFamily="Tajawal" />
                <Label Text="{Binding ActiveQueryText}"
                       FontSize="11"
                       FontFamily="TajawalBold"
                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}"
                       VerticalOptions="Center" />
                <Label Text="تعديل"
                       IsVisible="{Binding HasFilterFacets}"
                       FontSize="11"
                       FontFamily="TajawalBold"
                       TextColor="{DynamicResource BrandInk}"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOpenFiltersTapped" />
                    </Label.GestureRecognizers>
                    <Label.Behaviors>
                        <design:PressableEffect ApplyHoverHighlight="True" />
                    </Label.Behaviors>
                </Label>
            </HorizontalStackLayout>

            <!-- inline-end: آخر فحص (LastScanStatus unit) + poll pill (pause/resume). -->
            <HorizontalStackLayout Grid.Column="2" Spacing="12" VerticalOptions="Center" Margin="0,4,0,0">
                <lastscan:LastScanStatus AutomationId="Projects_LastScanStatus"
                                         LabelAutomationId="Projects_LastScanLabel"
                                         RefreshAutomationId="Projects_RefreshLabel"
                                         LastScanAt="{Binding GlobalStatus.LastScanCompletedAt}"
                                         IsChecking="{Binding GlobalStatus.IsScanning}"
                                         ShowRefresh="True"
                                         RefreshCommand="{Binding RefreshCommand}"
                                         FontSize="11"
                                         TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                                         VerticalOptions="Center" />

                <!-- Poll pill: brand-outlined, BrandSoft fill, BrandInk text+glyph. Paused → accent-green
                     outline variant (state colour, never brand). Wire the existing TogglePolling command. -->
                <Border StrokeThickness="1"
                        AutomationId="Projects_TogglePollingButton"
                        SemanticProperties.Description="إيقاف/بدء الفحص"
                        Stroke="{DynamicResource Brand}"
                        BackgroundColor="{DynamicResource BrandSoft}"
                        Padding="12,5"
                        VerticalOptions="Center">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding TogglePollingCommand}" />
                    </Border.GestureRecognizers>
                    <Border.Behaviors>
                        <design:PressableEffect ApplyHoverHighlight="True" />
                    </Border.Behaviors>
                    <Border.Triggers>
                        <!-- Paused → accent-green outline variant (a STATE colour, never brand). Plain
                             values here because MAUI Setter.Value does not accept AppThemeBinding; the
                             translucent fill blends correctly over both surfaces. -->
                        <DataTrigger TargetType="Border" Binding="{Binding IsPollingActive}" Value="False">
                            <Setter Property="Stroke" Value="{StaticResource PausedGreen}" />
                            <Setter Property="BackgroundColor" Value="{StaticResource PausedGreenSoft}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <HorizontalStackLayout Spacing="6">
                        <components:AppIcon Icon="{Binding PollToggleIcon}"
                                            FontSize="12"
                                            TextColor="{DynamicResource BrandInk}"
                                            VerticalOptions="Center">
                            <components:AppIcon.Triggers>
                                <DataTrigger TargetType="components:AppIcon" Binding="{Binding IsPollingActive}" Value="False">
                                    <Setter Property="TextColor" Value="{StaticResource PausedGreen}" />
                                </DataTrigger>
                            </components:AppIcon.Triggers>
                        </components:AppIcon>
                        <Label Text="{Binding PollPillLabel}"
                               FontSize="12"
                               FontFamily="TajawalBold"
                               VerticalOptions="Center"
                               TextColor="{DynamicResource BrandInk}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsPollingActive}" Value="False">
                                    <Setter Property="TextColor" Value="{StaticResource PausedGreen}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </HorizontalStackLayout>
                </Border>
            </HorizontalStackLayout>
        </Grid>

        <!-- Full-page transparent backdrop, shown together with the flyout so a click anywhere
             outside of it (auto-dismiss, like any normal menu/popover) closes it too. -->
        <BoxView x:Name="NotificationsBackdrop"
                 Grid.RowSpan="3"
                 Grid.ColumnSpan="4"
                 Color="Transparent"
                 IsVisible="False"
                 InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnNotificationsBackdropTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <notifViews:RecentNotificationsFlyout x:Name="NotificationsFlyout"
                                               AutomationId="Notifications_Flyout"
                                               Grid.Row="1"
                                               Grid.Column="2"
                                               IsVisible="False"
                                               HorizontalOptions="End"
                                               VerticalOptions="Start"
                                               Margin="0,12,12,0" />

        <!-- B3 typed-facet FilterModal: a page-covering overlay (backdrop + centered card built into
             the unit, same host-managed visibility mechanic as the notifications flyout above).
             Every control inside it is generated from the ACTIVE source's descriptor.FilterFacets. -->
        <filtermodal:FilterModal x:Name="FiltersModal"
                                 Grid.RowSpan="3"
                                 Grid.ColumnSpan="4"
                                 AutomationId="Projects_FiltersModal"
                                 IsVisible="False" />

    </Grid>
</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:MostaqlK.UI.PlatformComponents"
             xmlns:design="clr-namespace:MostaqlK.UI.DesignSystem"
             xmlns:ds="clr-namespace:MostaqlK.UI.DesignSystem"
             xmlns:vm="clr-namespace:MostaqlK.Features.Projects.ViewModels"
             xmlns:models="clr-namespace:MostaqlK.Models"
             xmlns:converters="clr-namespace:MostaqlK.UI.DesignSystem.Converters"
             x:Class="MostaqlK.Features.Projects.Views.Layouts.ProjectDetailsMobileLayout"
             x:DataType="vm:ProjectDetailsViewModel"
             FlowDirection="RightToLeft">

    <ContentView.Resources>
        <ResourceDictionary>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid RowDefinitions="Auto,*" BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#020617}">
        <!-- Top App Bar with back button -->
        <Grid Grid.Row="0" Padding="16,12" ColumnDefinitions="Auto,*,Auto" BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}">
            <ds:PressableButton Grid.Column="0" Text="← رجوع" AutomationId="Details_Mobile_BackButton" Clicked="OnBackClicked"
                                BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" Padding="0"
                                FontFamily="TajawalBold" FontSize="14" />
            <Label Grid.Column="1" Text="تفاصيل المشروع" FontSize="18" FontFamily="TajawalBold"
                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" HorizontalOptions="Center" VerticalOptions="Center" />
            <BoxView Grid.Column="2" WidthRequest="40" Color="Transparent" />
        </Grid>

        <!-- Loading state -->
        <VerticalStackLayout Grid.Row="1" Padding="16,20" Spacing="12" IsVisible="{Binding IsLoading}">
            <design:ShimmerBox HeightRequest="32" />
            <design:ShimmerBox HeightRequest="120" />
            <design:ShimmerBox HeightRequest="60" />
        </VerticalStackLayout>

        <!-- Error state -->
        <design:LabelWithSubText IsVisible="{Binding HasError}"
                                  Grid.Row="1" VerticalOptions="Center"
                                  Text="{Binding ErrorMessage}"
                                  SubText="تعذر تحميل تفاصيل المشروع." />

        <!-- Success state: Single-column scrollview for mobile -->
        <ScrollView Grid.Row="1" AutomationId="Details_Mobile_ScrollView" IsVisible="{Binding ShowDetails}">
            <VerticalStackLayout Padding="16" Spacing="16">
                
                <!-- Main title & description card -->
                <Border Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" StrokeThickness="1">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="{Binding Details.Title}" FontSize="18" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                            <Border Grid.Column="1"
                                    StrokeThickness="0"
                                    Padding="8,3"
                                    VerticalOptions="Start"
                                    BackgroundColor="{Binding EnrichmentBadgeBackground}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="4">
                                    <components:AppIcon Icon="{Binding EnrichmentBadgeIcon}"
                                                        FontSize="11"
                                                        TextColor="{Binding EnrichmentBadgeForeground}"
                                                        VerticalOptions="Center" />
                                    <Label Text="{Binding EnrichmentBadgeText}"
                                           FontSize="10"
                                           FontFamily="TajawalBold"
                                           VerticalOptions="Center"
                                           TextColor="{Binding EnrichmentBadgeForeground}" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                        <Label Text="{Binding Details.EnrichedAt, StringFormat='آخر تحديث: {0:yyyy/MM/dd HH:mm}'}" FontSize="11" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontFamily="Tajawal" />
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" />
                        <Label Text="{Binding Details.Description}" FontSize="14" TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}" LineBreakMode="WordWrap" FontFamily="Tajawal" />
                    </VerticalStackLayout>
                </Border>

                <!-- Project metadata card -->
                <Border Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" StrokeThickness="1">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="بطاقة المشروع" FontSize="16" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                            <Label Text="حالة المشروع" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontSize="13" FontFamily="Tajawal" />
                            <Label Grid.Column="1" Text="{Binding Details.ProjectStatus}" FontSize="13" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#E2E8F0}" />

                            <Label Grid.Row="1" Text="تاريخ النشر" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontSize="13" FontFamily="Tajawal" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding PublishTimeText}" FontSize="13" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#E2E8F0}" />

                            <Label Grid.Row="2" Text="الميزانية" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontSize="13" FontFamily="Tajawal" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding Budget}" FontSize="13" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#16A34A, Dark=#4ADE80}" />

                            <Label Grid.Row="3" Text="مدة التنفيذ" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontSize="13" FontFamily="Tajawal" />
                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding Duration}" FontSize="13" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#E2E8F0}" />
                        </Grid>
                        
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" />
                        
                        <components:MostaqlLinkButton 
                            Command="{Binding OpenOnMostaqlCommand}"
                            Margin="0,4,0,0"
                            AutomationId="Details_Mobile_OpenOnMostaqlButton" />
                    </VerticalStackLayout>
                </Border>

                <!-- Owner statistics card (mobile-adapted) -->
                <Border Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" StrokeThickness="1">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="صاحب المشروع" FontSize="16" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                            <Label Text="اسم صاحب المشروع" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontSize="13" FontFamily="Tajawal" />
                            <Label Grid.Column="1" Text="{Binding OwnerName}" FontSize="13" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#E2E8F0}" />

                            <Label Grid.Row="1" Text="تاريخ التسجيل" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontSize="13" FontFamily="Tajawal" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding OwnerRegisteredAt}" FontSize="13" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#E2E8F0}" />

                            <Label Grid.Row="2" Text="معدل التوظيف" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontSize="13" FontFamily="Tajawal" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding OwnerHiringRateText}" FontSize="13" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#E2E8F0}" />

                            <Label Grid.Row="3" Text="المشاريع المفتوحة" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontSize="13" FontFamily="Tajawal" />
                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding OwnerOpenProjectsText}" FontSize="13" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#E2E8F0}" />

                            <Label Grid.Row="4" Text="قيد التنفيذ" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontSize="13" FontFamily="Tajawal" />
                            <Label Grid.Row="4" Grid.Column="1" Text="{Binding OwnerInProgressProjectsText}" FontSize="13" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#E2E8F0}" />

                            <Label Grid.Row="5" Text="التواصلات الجارية" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontSize="13" FontFamily="Tajawal" />
                            <Label Grid.Row="5" Grid.Column="1" Text="{Binding OwnerOngoingCommunicationsText}" FontSize="13" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#E2E8F0}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Skills -->
                <Border Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" StrokeThickness="1">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="المهارات المطلوبة" FontSize="15" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}" />
                        <FlexLayout BindableLayout.ItemsSource="{Binding Skills}" Wrap="Wrap" Direction="Row">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:ProjectSkill">
                                    <Border Padding="8,4" Margin="0,0,6,6" BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#132239}" StrokeThickness="0">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                                        <Label Text="{Binding Name}" FontSize="11" TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" FontFamily="Tajawal" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Attachments -->
                <Border Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" StrokeThickness="1">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="المرفقات" FontSize="15" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}" />
                        <CollectionView ItemsSource="{Binding Attachments}" AutomationId="Details_Mobile_AttachmentsList">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:AttachmentItemViewModel">
                                    <Grid ColumnDefinitions="*,Auto" Padding="0,6">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding FileName}" FontSize="13" TextColor="{AppThemeBinding Light=#0F172A, Dark=#E2E8F0}" FontFamily="Tajawal" />
                                            <Label Text="{Binding StatusMessage}" FontSize="10" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" LineBreakMode="WordWrap" FontFamily="Tajawal" />
                                        </VerticalStackLayout>
                                        <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                            <components:AppButton Text="تصفح"
                                                                   Command="{Binding BrowseCommand}"
                                                                   FontFamily="Tajawal"
                                                                   FontSize="11"
                                                                   Style="{StaticResource GhostButtonStyle}" />
                                            <components:AppButton Text="تحميل"
                                                                   Command="{Binding ResolveCommand}"
                                                                   FontFamily="Tajawal"
                                                                   FontSize="11"
                                                                   IsVisible="{Binding IsDownloaded, Converter={StaticResource InvertedBoolConverter}}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:MostaqlK.UI.PlatformComponents"
             xmlns:design="clr-namespace:MostaqlK.UI.DesignSystem"
             xmlns:ds="clr-namespace:MostaqlK.UI.DesignSystem"
             xmlns:vm="clr-namespace:MostaqlK.Features.Projects.ViewModels"
             xmlns:models="clr-namespace:MostaqlK.Models"
             xmlns:converters="clr-namespace:MostaqlK.UI.DesignSystem.Converters"
             xmlns:rail="clr-namespace:MostaqlK.UI.PlatformComponents.SourceRail"
             x:Class="MostaqlK.Features.Projects.Views.Layouts.ProjectDetailsWindowsLayout"
             x:DataType="vm:ProjectDetailsViewModel"
             FlowDirection="RightToLeft">

    <ContentView.Resources>
        <ResourceDictionary>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:BoolToFlowDirectionConverter x:Key="BoolToFlowDirectionConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <!-- v3 shell (contract §3): the 64px SourceRail replaces the 256px AppSidebar, physical LEFT
         (rail rides the last column of this RTL grid → reclaiming 192px). The details page belongs
         to the المشاريع section, so ActivePage=Projects. Content is untouched (dev23-era, verified). -->
    <Grid BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#020617}">
        <!-- Rail track pinned (never Auto): an Auto rail column is resolved after the content star
             and lands outside the window frame (RTL clips at the physical left). -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="{x:Static rail:RailWidths.ColumnWidth}" />
        </Grid.ColumnDefinitions>

        <rail:SourceRail Grid.Column="1"
                         x:Name="Rail"
                         ActivePage="Projects"
                         UnreadCount="{Binding GlobalStatus.UnreadNotificationCount}"
                         ProjectsClicked="OnProjectsNavClicked"
                         AdvancedSearchClicked="OnAdvancedSearchNavClicked"
                         SettingsClicked="OnSettingsNavClicked"
                         AboutClicked="OnAboutNavClicked"
                         NotificationsClicked="OnRailNotificationsClicked"
                         SourceChanged="OnRailSourceChanged" />

        <Grid Grid.Column="0" RowDefinitions="Auto,*">

            <!-- ============ HEADER BAND (surface, bottom hairline) ============
                 v3: the page title IS the scraped project title (not the static "تفاصيل المشروع"),
                 the removed source-banner lives here as a compact caption chip row, and the brand
                 CTA ("عرض في {source}" — the SourceLinkButton unit) sits opposite the back control.
                 Back-arrow side follows the mockup (inline-start of the RTL row). -->
            <VerticalStackLayout Grid.Row="0"
                                 BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                                 Padding="24,20,24,16"
                                 Spacing="10">
                <!-- Scraped project title, centered, big (mockup text-3xl leading-snug = 30px/1.375). -->
                <Label Text="{Binding Details.Title}"
                       FontSize="30" LineHeight="1.375" FontFamily="TajawalBold"
                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}"
                       HorizontalTextAlignment="Center" HorizontalOptions="Center" />

                <!-- Caption chip row: source chip · enrichment status · discovered date. -->
                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Border BackgroundColor="{DynamicResource BrandSoft}" StrokeThickness="0"
                            Padding="10,3" VerticalOptions="Center" IsVisible="{Binding ShowSourceChip}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                        <Label Text="{Binding SourceNameAr}" FontSize="11" FontFamily="TajawalBold"
                               TextColor="{DynamicResource BrandInk}" />
                    </Border>

                    <!-- Enrichment badge mirrors ProjectCard's logic: leading icon + state-driven color/text. -->
                    <Border StrokeThickness="0" Padding="10,3" VerticalOptions="Center"
                            BackgroundColor="{Binding EnrichmentBadgeBackground}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                        <HorizontalStackLayout Spacing="6">
                            <components:AppIcon Icon="{Binding EnrichmentBadgeIcon}"
                                                FontSize="12" TextColor="{Binding EnrichmentBadgeForeground}"
                                                VerticalOptions="Center" />
                            <Label Text="{Binding EnrichmentBadgeText}" FontSize="11" FontFamily="TajawalBold"
                                   VerticalOptions="Center" TextColor="{Binding EnrichmentBadgeForeground}" />
                        </HorizontalStackLayout>
                    </Border>

                    <Label Text="· اكتُشف" FontSize="11" FontFamily="Tajawal"
                           VerticalOptions="Center" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                    <Label Text="{Binding DiscoveredAtText}" FontSize="11" FontFamily="Tajawal"
                           VerticalOptions="Center" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                </HorizontalStackLayout>

                <!-- back + breadcrumb (inline-start) ......... brand CTA (inline-end) -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                        <!-- Round icon-only back button (~36px). A real transparent Button keeps Details_BackButton
                             reliably invokable for the UI test; the chevron glyph is an input-transparent overlay. -->
                        <Grid WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                            <ds:PressableButton AutomationId="Details_BackButton" Clicked="OnProjectsNavClicked"
                                                BackgroundColor="Transparent" BorderWidth="0" Padding="0"
                                                FontSize="1" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                                                MinimumWidthRequest="0" MinimumHeightRequest="0" />
                            <components:AppIcon Grid.Row="0" Icon="ChevronRight" FontSize="16"
                                                TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                                                InputTransparent="True" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Grid>
                        <!-- Breadcrumb (replaces the old static "المشاريع" crumb). -->
                        <Label Text="المشاريع /" VerticalOptions="Center" FontSize="13" FontFamily="Tajawal"
                               TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                        <Label Text="{Binding SourceNameAr}" VerticalOptions="Center" FontSize="13" FontFamily="TajawalBold"
                               TextColor="{DynamicResource BrandInk}" />
                    </HorizontalStackLayout>

                    <components:SourceLinkButton Grid.Column="2"
                                                 Command="{Binding OpenOnSourceCommand}"
                                                 Label="{Binding OpenOnSourceLabel}"
                                                 HorizontalOptions="End" VerticalOptions="Center"
                                                 AutomationId="Details_OpenOnSourceButton" />
                </Grid>
            </VerticalStackLayout>

            <Grid Grid.Row="1">
                <!-- Loading state -->
                <VerticalStackLayout Padding="28,24" Spacing="12" IsVisible="{Binding IsLoading}">
                    <design:ShimmerBox HeightRequest="32" />
                    <design:ShimmerBox HeightRequest="120" />
                    <design:ShimmerBox HeightRequest="60" />
                </VerticalStackLayout>

                <!-- Error state -->
                <design:LabelWithSubText IsVisible="{Binding HasError}"
                                         VerticalOptions="Center"
                                         Text="{Binding ErrorMessage}"
                                         SubText="تعذر تحميل تفاصيل المشروع." />

                <!-- Success state: continuous full-page surface (settings/details pattern) —
                     one column, section-head blocks divided by hairlines, NO floating cards, NO side gutters. -->
                <ScrollView AutomationId="Details_ScrollView" IsVisible="{Binding ShowDetails}"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}">
                    <VerticalStackLayout Spacing="0">

                        <!-- ===== DECISION STRIP: the 2-second go/no-go scan. Tiny label above a big value.
                             Each fact is emitted only when the project carries it (data-driven omission).
                             Mockup `grid grid-cols-5 gap-6 text-center`: equal 172px columns (1024 content
                             / 5) with 24px gaps and centre-aligned text, not a right-packed strip. ===== -->
                        <!-- Full-width decision strip (mockup `grid grid-cols-5 gap-6 text-center`): five
                             equal star columns; each fact binds its column index. A Grid (not a flex row)
                             measures to the page width, so the strip can never spill into the rail. -->
                        <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="24"
                              Padding="32,24" IsVisible="{Binding HasDecisionFacts}">
                            <BindableLayout.ItemsSource>
                                <Binding Path="DecisionFacts" />
                            </BindableLayout.ItemsSource>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:DecisionFact">
                                    <VerticalStackLayout Grid.Column="{Binding Column}" Spacing="4">
                                        <Label Text="{Binding LabelAr}" FontSize="11" FontFamily="Tajawal"
                                               HorizontalTextAlignment="Center"
                                               TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                        <!-- Accent (state-green) facts: الميزانية · الحالة. Never brand. -->
                                        <Label Text="{Binding Value}" FontSize="22" FontFamily="TajawalBold"
                                               IsVisible="{Binding IsAccent}"
                                               HorizontalTextAlignment="Center"
                                               FlowDirection="{Binding IsMoney, Converter={StaticResource BoolToFlowDirectionConverter}}"
                                               TextColor="{AppThemeBinding Light=#2E9E6B, Dark=#4FBF8C}" />
                                        <Label Text="{Binding Value}" FontSize="22" FontFamily="TajawalBold"
                                               IsVisible="{Binding IsAccent, Converter={StaticResource InvertedBoolConverter}}"
                                               HorizontalTextAlignment="Center"
                                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" />

                        <!-- ===== الوصف (description + skills chips) ===== -->
                        <Grid ColumnDefinitions="28,*,28" IsVisible="{Binding HasDescription}">
                            <VerticalStackLayout Grid.Column="1" Spacing="14" Padding="0,16">
                                <Label Text="الوصف" FontSize="15" FontFamily="TajawalBold"
                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                                <Label Text="{Binding Details.Description}" FontSize="15" FontFamily="Tajawal"
                                       LineBreakMode="{Binding DescriptionLineBreakMode}"
                                       MaxLines="{Binding DescriptionMaxLines}"
                                       TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}" />
                                <ds:PressableButton Text="{Binding DescriptionToggleText}"
                                                    Command="{Binding ToggleDescriptionCommand}"
                                                    BackgroundColor="Transparent" BorderWidth="0" Padding="0"
                                                    FontFamily="TajawalBold" FontSize="12" HorizontalOptions="Start"
                                                    TextColor="{DynamicResource BrandInk}"
                                                    IsVisible="{Binding ShowDescriptionToggle}" />

                                <!-- المهارات المطلوبة — reused chip treatment, brand-soft/brand-ink per v3. -->
                                <Label Text="المهارات المطلوبة" FontSize="14" FontFamily="TajawalBold"
                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}"
                                       Margin="0,8,0,0" IsVisible="{Binding HasSkills}" />
                                <FlexLayout BindableLayout.ItemsSource="{Binding Skills}" Wrap="Wrap" Direction="Row"
                                            IsVisible="{Binding HasSkills}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:ProjectSkill">
                                            <Border Padding="12,4" Margin="0,0,8,8"
                                                    BackgroundColor="{DynamicResource BrandSoft}" StrokeThickness="0">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                                                <Label Text="{Binding Name}" FontSize="12" FontFamily="Tajawal"
                                                       TextColor="{DynamicResource BrandInk}" />
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                                  IsVisible="{Binding HasSchemaSections}" />

                        <!-- ===== Remaining schema-driven sections (nafezly's معلومات المنفذ, gated on the
                             HasExecutorInfo capability + a present name; plus any future generic section). ===== -->
                        <Grid ColumnDefinitions="28,*,28" IsVisible="{Binding HasSchemaSections}">
                            <VerticalStackLayout Grid.Column="1" Spacing="16" Padding="0,16"
                                                 BindableLayout.ItemsSource="{Binding SchemaSections}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DetailSectionGroup">
                                        <VerticalStackLayout Spacing="14">
                                            <Label Text="{Binding HeaderAr}" FontSize="15" FontFamily="TajawalBold"
                                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}" Spacing="12">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:DetailMetaRow">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <Label Text="{Binding LabelAr}" FontSize="14" FontFamily="Tajawal"
                                                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                                            <Label Grid.Column="1" Text="{Binding Value}" FontSize="14" FontFamily="TajawalBold"
                                                                   FlowDirection="{Binding IsMoney, Converter={StaticResource BoolToFlowDirectionConverter}}"
                                                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#E2E8F0}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                                  IsVisible="{Binding ShowOwnerCard}" />

                        <!-- ===== صاحب المشروع — owner card: brand-avatar initials + name + sub line + stat cells.
                             No verified check (no verification field is scraped); lines with no data are omitted. ===== -->
                        <Grid ColumnDefinitions="28,*,28" IsVisible="{Binding ShowOwnerCard}">
                            <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="16" Padding="0,16">
                                <!-- Brand avatar (initials circle, brand fill + on-brand text). -->
                                <Border Grid.Column="0" WidthRequest="48" HeightRequest="48" StrokeThickness="0"
                                        BackgroundColor="{DynamicResource Brand}" VerticalOptions="Center">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                                    <Label Text="{Binding OwnerInitials}" FontSize="18" FontFamily="TajawalBold"
                                           TextColor="{DynamicResource OnBrand}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <Label Text="{Binding OwnerName}" FontSize="15" FontFamily="TajawalBold"
                                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                                    <Label Text="{Binding OwnerSubLine}" FontSize="12" FontFamily="Tajawal"
                                           IsVisible="{Binding HasOwnerSub}"
                                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                </VerticalStackLayout>
                            </Grid>
                            <!-- Inline stat cells (owner numeric fields with values; nafezly has none ⇒ nothing renders). -->
                            <HorizontalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="8" VerticalOptions="Center"
                                                   IsVisible="{Binding HasOwnerStats}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DetailMetaRow">
                                        <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#172032}"
                                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" StrokeThickness="1"
                                                Padding="14,8">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                                <Label Text="{Binding Value}" FontSize="14" FontFamily="TajawalBold"
                                                       FlowDirection="{Binding IsMoney, Converter={StaticResource BoolToFlowDirectionConverter}}"
                                                       HorizontalTextAlignment="Center"
                                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                                                <Label Text="{Binding LabelAr}" FontSize="11" FontFamily="Tajawal"
                                                       HorizontalTextAlignment="Center"
                                                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                                  IsVisible="{Binding HasAttachments}" />

                        <!-- ===== المرفقات — existing attachment rows kept intact (buttons + AutomationIds). ===== -->
                        <Grid ColumnDefinitions="28,*,28" IsVisible="{Binding HasAttachments}">
                            <VerticalStackLayout Grid.Column="1" Spacing="12" Padding="0,16">
                                <Label Text="المرفقات" FontSize="15" FontFamily="TajawalBold"
                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                                <CollectionView ItemsSource="{Binding Attachments}" AutomationId="Details_AttachmentsList">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AttachmentItemViewModel">
                                            <Grid ColumnDefinitions="*,Auto" Padding="0,8" RowDefinitions="Auto,Auto">
                                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding FileName}" FontSize="14" TextColor="{AppThemeBinding Light=#0F172A, Dark=#E2E8F0}" FontFamily="Tajawal" />
                                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding StatusMessage}" FontSize="11" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" LineBreakMode="WordWrap" FontFamily="Tajawal" />
                                                <HorizontalStackLayout Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                                    <components:AppButton Text="تصفح"
                                                                          AutomationId="Details_AttachmentBrowseButton"
                                                                          Command="{Binding BrowseCommand}"
                                                                          FontFamily="Tajawal"
                                                                          Style="{StaticResource GhostButtonStyle}" />

                                                    <components:AppButton Text="تحميل"
                                                                          AutomationId="Details_AttachmentResolveButton"
                                                                          Command="{Binding ResolveCommand}"
                                                                          FontFamily="Tajawal"
                                                                          IsVisible="{Binding IsDownloaded, Converter={StaticResource InvertedBoolConverter}}" />

                                                    <components:AppButton Text="إظهار في المجلد"
                                                                          AutomationId="Details_AttachmentRevealButton"
                                                                          Command="{Binding RevealCommand}"
                                                                          FontFamily="Tajawal"
                                                                          IsVisible="{Binding IsDownloaded}" />
                                                </HorizontalStackLayout>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                                  IsVisible="{Binding ShowRetryAffordance}" />

                        <!-- §9 retry affordance: only on a Failed enrichment row. Re-enqueues on the
                             ACTIVE pipeline's queue; absent otherwise (never rendered empty). -->
                        <Grid ColumnDefinitions="28,*,28" IsVisible="{Binding ShowRetryAffordance}">
                            <components:AppButton Grid.Column="1" Text="إعادة محاولة الإثراء"
                                                  AutomationId="Details_RetryButton"
                                                  Command="{Binding RetryEnrichmentCommand}"
                                                  FontFamily="Tajawal" HorizontalOptions="Start" Margin="0,16" />
                        </Grid>

                        <!-- ===== Footer actions row (border-top): نسخ الرابط (ghost) + تحديد كمقروء والعودة (brand). ===== -->
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" />
                        <Grid ColumnDefinitions="28,*,28">
                            <HorizontalStackLayout Grid.Column="1" Spacing="12" Padding="0,20" HorizontalOptions="End">
                                <components:AppButton Text="نسخ رابط المشروع" Clicked="OnCopyLinkClicked"
                                                      FontFamily="TajawalBold" Style="{StaticResource GhostButtonStyle}" />
                                <components:AppButton Text="تحديد كمقروء والعودة" Clicked="OnMarkAsReadClicked"
                                                      FontFamily="TajawalBold"
                                                      BackgroundColor="{DynamicResource Brand}"
                                                      TextColor="{DynamicResource OnBrand}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Grid>
    </Grid>

</ContentView>

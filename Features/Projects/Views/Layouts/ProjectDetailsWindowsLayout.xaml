<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:MostaqlK.UI.PlatformComponents"
             xmlns:design="clr-namespace:MostaqlK.UI.DesignSystem"
             xmlns:ds="clr-namespace:MostaqlK.UI.DesignSystem"
             xmlns:vm="clr-namespace:MostaqlK.Features.Projects.ViewModels"
             xmlns:models="clr-namespace:MostaqlK.Models"
             xmlns:converters="clr-namespace:MostaqlK.UI.DesignSystem.Converters"
             xmlns:sidebar="clr-namespace:MostaqlK.UI.PlatformComponents.AppSidebar"
             x:Class="MostaqlK.Features.Projects.Views.Layouts.ProjectDetailsWindowsLayout"
             x:DataType="vm:ProjectDetailsViewModel"
             FlowDirection="RightToLeft">

    <ContentView.Resources>
        <ResourceDictionary>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid ColumnDefinitions="Auto,*" BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#020617}">

        <sidebar:AppSidebar Grid.Column="0"
                             ActivePage="Projects"
                             StatValue="{Binding GlobalStatus.ProjectsAddedTodayText}"
                             ProjectsClicked="OnProjectsNavClicked"
                             AdvancedSearchClicked="OnAdvancedSearchNavClicked"
                             SettingsClicked="OnSettingsNavClicked"
                             AboutClicked="OnAboutNavClicked" />

        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" Padding="28,20,28,8" ColumnDefinitions="Auto,*,Auto">
                <ds:PressableButton Grid.Column="0" Text="رجوع" AutomationId="Details_BackButton" Clicked="OnProjectsNavClicked"
                        BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}" Padding="0"
                        FontFamily="Tajawal" />
                <Label Grid.Column="1" Text="تفاصيل المشروع" FontSize="22" FontFamily="TajawalBold"
                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" HorizontalOptions="Center" VerticalOptions="Center" />
                <Label Grid.Column="2" Text="المشاريع" FontSize="13" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                       VerticalOptions="Center"
                       FontFamily="Tajawal" />
            </Grid>

            <!-- Loading state -->
            <VerticalStackLayout Grid.Row="1" Padding="28,24" Spacing="12" IsVisible="{Binding IsLoading}">
                <design:ShimmerBox HeightRequest="32" />
                <design:ShimmerBox HeightRequest="120" />
                <design:ShimmerBox HeightRequest="60" />
            </VerticalStackLayout>

            <!-- Error state -->
            <design:LabelWithSubText IsVisible="{Binding HasError}"
                                      Grid.Row="1" VerticalOptions="Center"
                                      Text="{Binding ErrorMessage}"
                                      SubText="تعذر تحميل تفاصيل المشروع." />

            <!-- Success state -->
            <ScrollView Grid.Row="1" AutomationId="Details_ScrollView" IsVisible="{Binding ShowDetails}">
                <Grid Padding="28,16,28,28" ColumnDefinitions="2*,*" ColumnSpacing="20" x:DataType="vm:ProjectDetailsViewModel">
                    <VerticalStackLayout Grid.Column="0" Spacing="16">
                        <Border Padding="22" BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" StrokeThickness="1">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Details.Title}" FontSize="24" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                                    <!-- Enrichment badge mirrors ProjectCard's logic: leading icon + state-driven color/text. -->
                                    <Border Grid.Column="1"
                                            StrokeThickness="0"
                                            Padding="12,4"
                                            VerticalOptions="Start"
                                            BackgroundColor="{Binding EnrichmentBadgeBackground}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6" />
                                        </Border.StrokeShape>
                                        <HorizontalStackLayout Spacing="6">
                                            <components:AppIcon Icon="{Binding EnrichmentBadgeIcon}"
                                                                FontSize="12"
                                                                TextColor="{Binding EnrichmentBadgeForeground}"
                                                                VerticalOptions="Center" />
                                            <Label Text="{Binding EnrichmentBadgeText}"
                                                   FontSize="11"
                                                   FontFamily="TajawalBold"
                                                   VerticalOptions="Center"
                                                   TextColor="{Binding EnrichmentBadgeForeground}" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>
                                <Label Text="{Binding Details.EnrichedAt, StringFormat='آخر تحديث: {0:yyyy/MM/dd HH:mm}'}" FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontFamily="Tajawal" />
                                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" />
                                <Label Text="{Binding Details.Description}" FontSize="15" TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}" LineBreakMode="WordWrap" FontFamily="Tajawal" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Padding="22" BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" StrokeThickness="1">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="14">
                                <Label Text="تفاصيل المشروع" FontSize="18" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                                <Label Text="المهارات المطلوبة" FontSize="14" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}" />
                                <FlexLayout BindableLayout.ItemsSource="{Binding Skills}" Wrap="Wrap" Direction="Row">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:ProjectSkill">
                                            <Border Padding="10,5" Margin="0,0,8,8" BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#132239}" StrokeThickness="0">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                                <Label Text="{Binding Name}" FontSize="12" TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}" FontFamily="Tajawal" />
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                                <Label Text="المرفقات" FontSize="14" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}" />
                                <CollectionView ItemsSource="{Binding Attachments}" AutomationId="Details_AttachmentsList">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AttachmentItemViewModel">
                                            <Grid ColumnDefinitions="*,Auto" Padding="0,8" RowDefinitions="Auto,Auto">
                                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding FileName}" FontSize="14" TextColor="{AppThemeBinding Light=#0F172A, Dark=#E2E8F0}" FontFamily="Tajawal" />
                                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding StatusMessage}" FontSize="11" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" LineBreakMode="WordWrap" FontFamily="Tajawal" />
                                                <HorizontalStackLayout Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                                    <components:AppButton Text="تصفح"
                                                                           AutomationId="Details_AttachmentBrowseButton"
                                                                           Command="{Binding BrowseCommand}"
                                                                           FontFamily="Tajawal"
                                                                           Style="{StaticResource GhostButtonStyle}" />
                                                    
                                                    <components:AppButton Text="تحميل"
                                                                           AutomationId="Details_AttachmentResolveButton"
                                                                           Command="{Binding ResolveCommand}"
                                                                           FontFamily="Tajawal"
                                                                           IsVisible="{Binding IsDownloaded, Converter={StaticResource InvertedBoolConverter}}" />

                                                    <components:AppButton Text="إظهار في المجلد"
                                                                           AutomationId="Details_AttachmentRevealButton"
                                                                           Command="{Binding RevealCommand}"
                                                                           FontFamily="Tajawal"
                                                                           IsVisible="{Binding IsDownloaded}" />
                                                </HorizontalStackLayout>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                    <Border Grid.Column="1" Padding="22" BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" StrokeThickness="1" VerticalOptions="Start">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="18">
                            <Label Text="بطاقة المشروع" FontSize="18" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="16">
                                <Label Text="حالة المشروع" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontFamily="Tajawal" /><Label Grid.Column="1" Text="{Binding Details.ProjectStatus}" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#E2E8F0}" />
                                <Label Grid.Row="1" Text="تاريخ النشر" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontFamily="Tajawal" /><Label Grid.Row="1" Grid.Column="1" Text="{Binding PublishTimeText}" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#E2E8F0}" />
                                <Label Grid.Row="2" Text="الميزانية" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontFamily="Tajawal" /><Label Grid.Row="2" Grid.Column="1" Text="{Binding Budget}" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#E2E8F0}" />
                                <Label Grid.Row="3" Text="مدة التنفيذ" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontFamily="Tajawal" /><Label Grid.Row="3" Grid.Column="1" Text="{Binding Duration}" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#E2E8F0}" />
                            </Grid>
                            
                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" Margin="0,4" />

                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="16">
                                <Label Text="صاحب المشروع" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontFamily="Tajawal" /><Label Grid.Column="1" Text="{Binding OwnerName}" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#E2E8F0}" />
                                <Label Grid.Row="1" Text="تاريخ التسجيل" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontFamily="Tajawal" /><Label Grid.Row="1" Grid.Column="1" Text="{Binding OwnerRegisteredAt}" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#E2E8F0}" />
                                <Label Grid.Row="2" Text="معدل التوظيف" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontFamily="Tajawal" /><Label Grid.Row="2" Grid.Column="1" Text="{Binding OwnerHiringRateText}" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#E2E8F0}" />
                                <Label Grid.Row="3" Text="المشاريع المفتوحة" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontFamily="Tajawal" /><Label Grid.Row="3" Grid.Column="1" Text="{Binding OwnerOpenProjectsText}" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#E2E8F0}" />
                                <Label Grid.Row="4" Text="قيد التنفيذ" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontFamily="Tajawal" /><Label Grid.Row="4" Grid.Column="1" Text="{Binding OwnerInProgressProjectsText}" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#E2E8F0}" />
                                <Label Grid.Row="5" Text="التواصلات الجارية" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontFamily="Tajawal" /><Label Grid.Row="5" Grid.Column="1" Text="{Binding OwnerOngoingCommunicationsText}" FontFamily="TajawalBold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#E2E8F0}" />
                            </Grid>
                            
                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" />
                            
                            <components:MostaqlLinkButton 
                                Command="{Binding OpenOnMostaqlCommand}"
                                Margin="0,8,0,0"
                                AutomationId="Details_OpenOnMostaqlButton" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </ScrollView>

        </Grid>
    </Grid>

</ContentView>

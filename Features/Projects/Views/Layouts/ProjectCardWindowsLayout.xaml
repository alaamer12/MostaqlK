<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:MostaqlK.UI.PlatformComponents"
             xmlns:ds="clr-namespace:MostaqlK.UI.DesignSystem"
             xmlns:converters="clr-namespace:MostaqlK.UI.DesignSystem.Converters"
             xmlns:vm="clr-namespace:MostaqlK.Features.Projects.ViewModels"
             x:Class="MostaqlK.Features.Projects.Views.Layouts.ProjectCardWindowsLayout"
             x:DataType="vm:ProjectCardViewModel"
             FlowDirection="RightToLeft">

    <!-- v3 continuous feed row (projects.html `.project-card.section-row`): rows live on ONE surface,
         hairline-divided, faint brand wash when unread. NO rounded floating card, NO "جديد" ribbon,
         NO diagonal enrichment sweep — those v1 affordances are retired here; enrichment state now
         reads solely from the band-1 pill. Colours follow the mockup slate scale + the brand
         DynamicResource family only (no inline brand hex); ink/state pairs mirror
         ProjectDetailsWindowsLayout (dev23). RowState (dev29) drives the three lifecycle variants:
         Provisional → skeleton, Stale → dimmed content, Broken → red-ghost. -->

    <ContentView.Resources>
        <ResourceDictionary>
            <converters:BoolToFlowDirectionConverter x:Key="BoolToFlowDirectionConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid x:Name="ProjectCard_Root"
          AutomationId="ProjectCard_Root"
          SemanticProperties.Description="{Binding Title}"
          RowDefinitions="Auto"
          BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}">

        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding SelectCommand}" />
        </Grid.GestureRecognizers>

        <!-- Unread wash (mockup `color-mix(brand 6%, surface)`): the brand color at 6% opacity over
             the row surface reproduces the mockup's faint tint exactly (BrandSoft at full opacity
             was far heavier). -->
        <BoxView x:Name="UnreadWash"
                 Color="{DynamicResource Brand}"
                 Opacity="0.06"
                 IsVisible="{Binding IsUnread}" />

        <!-- Hover wash (mockup `.project-card:hover`): read rows → surface-2, unread rows → a 9%
             brand mix over the surface. A solid overlay (not the row's BackgroundColor) keeps the
             AppThemeBinding on the root intact; the divider renders above it. -->
        <BoxView x:Name="HoverLayer"
                 Grid.Row="0"
                 IsVisible="False"
                 InputTransparent="True" />

        <!-- Bottom hairline divider (continuous-row grammar, not a card border). -->
        <BoxView Grid.Row="0"
                 HeightRequest="1"
                 VerticalOptions="End"
                 Color="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" />

        <!-- ============ CONTENT — three lifecycle variants stacked, one visible ============ -->
        <Grid>

            <!-- Provisional → ShimmerBox skeleton mirroring the band geometry (title, description,
                 owner+facts rows). ContentSettle handles the mount; no new animation here. -->
            <VerticalStackLayout Spacing="14" Padding="32,24" IsVisible="{Binding IsProvisional}">
                <Grid ColumnDefinitions="*,Auto">
                    <ds:ShimmerBox Grid.Column="0" HeightRequest="22" WidthRequest="260" HorizontalOptions="Start" />
                    <ds:ShimmerBox Grid.Column="1" HeightRequest="22" WidthRequest="84" HorizontalOptions="End" />
                </Grid>
                <ds:ShimmerBox HeightRequest="14" />
                <ds:ShimmerBox HeightRequest="14" WidthRequest="200" HorizontalOptions="Start" />
                <ds:ShimmerBox HeightRequest="22" />
            </VerticalStackLayout>

            <!-- Broken → single-line red-ghost row with honest message + retry (RetryCommand). -->
            <Border Grid.Column="0"
                    IsVisible="{Binding IsBroken}"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#FECACA, Dark=#3F1D1D}"
                    BackgroundColor="{AppThemeBinding Light=#FEF2F2, Dark=#2A1414}"
                    Padding="16,12"
                    Margin="28,18">
                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label Grid.Column="0"
                           Text="{Binding BrokenMessage}"
                           FontSize="13"
                           FontFamily="Tajawal"
                           VerticalOptions="Center"
                           LineBreakMode="TailTruncation"
                           TextColor="{AppThemeBinding Light=#DC2626, Dark=#F87171}" />
                    <components:AppButton Grid.Column="1"
                                          Text="إعادة المحاولة"
                                          Command="{Binding RetryCommand}"
                                          FontFamily="TajawalBold"
                                          FontSize="13"
                                          Style="{StaticResource GhostButtonStyle}"
                                          VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Normal content (Confirmed / Stale). Stale dims to 55% (stale-while-revalidate).
                 Rhythm mirrors projects.html `.section-row { padding: 1.5rem 2rem }` → 24px block /
                 32px inline; the 4px edge column adds the mockup's inline-start border on top. -->
            <VerticalStackLayout Spacing="0" Padding="32,24" IsVisible="{Binding ShowsNormalContent}">
                <VerticalStackLayout.Triggers>
                    <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding IsStale}" Value="True">
                        <Setter Property="Opacity" Value="0.55" />
                    </DataTrigger>
                </VerticalStackLayout.Triggers>

                <!-- band 1: title (text-xl extrabold, title-link) + enrichment pill (right). -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,12">
                    <Label Grid.Column="0"
                           Text="{Binding Title}"
                           FontSize="19"
                           LineHeight="1.35"
                           FontFamily="TajawalBold"
                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}"
                           LineBreakMode="WordWrap" />

                    <Border Grid.Column="1"
                            StrokeThickness="0"
                            Padding="12,4"
                            VerticalOptions="Start"
                            BackgroundColor="{Binding EnrichmentBadgeSoftBackground}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                        <HorizontalStackLayout Spacing="6">
                            <components:AppIcon Icon="{Binding EnrichmentBadgeIcon}"
                                                FontSize="12"
                                                TextColor="{Binding EnrichmentBadgeForeground}"
                                                VerticalOptions="Center" />
                            <Label Text="{Binding EnrichmentBadgeText}"
                                   FontSize="11"
                                   FontFamily="TajawalBold"
                                   VerticalOptions="Center"
                                   TextColor="{Binding EnrichmentBadgeForeground}" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- band 2: description (text-sm leading-relaxed mb-4=16px, line-clamp-2). -->
                <Label Text="{Binding Description}"
                       FontSize="14"
                       LineHeight="1.6"
                       FontFamily="Tajawal"
                       TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}"
                       MaxLines="2"
                       LineBreakMode="TailTruncation"
                       Margin="0,0,0,16" />

                <!-- band 3: skill chips (BrandSoft/BrandInk, right-aligned wrap). gap-2=8px wrap
                     gap comes from each chip's 8px trailing/bottom margin; the flex box then carries
                     the remaining 8px so the mb-4=16px lands exactly under the last chip row. -->
                <FlexLayout BindableLayout.ItemsSource="{Binding SkillItems}"
                            Wrap="Wrap"
                            Direction="Row"
                            JustifyContent="Start"
                            Margin="0,0,0,8"
                            IsVisible="{Binding HasSkills}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:SkillTagItem">
                            <Border StrokeThickness="0"
                                    BackgroundColor="{DynamicResource BrandSoft}"
                                    Padding="12,4"
                                    Margin="0,0,8,8">
                                <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                                <Label Text="{Binding Name}"
                                       FontSize="12"
                                       FontFamily="Tajawal"
                                       TextColor="{DynamicResource BrandInk}" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <!-- band 4 (border-top): owner avatar + name + sub, relative time at far inline-end. -->
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" />
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,16,0,16">
                    <Border Grid.Column="0"
                            WidthRequest="44"
                            HeightRequest="44"
                            StrokeThickness="0"
                            BackgroundColor="{DynamicResource Brand}"
                            VerticalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
                        <Label Text="{Binding ClientInitials}"
                               TextColor="{DynamicResource OnBrand}"
                               FontFamily="TajawalBold"
                               FontSize="16"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding ClientName}"
                               FontSize="15"
                               FontFamily="TajawalBold"
                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                        <Label Text="{Binding ClientMeta}"
                               FontSize="12"
                               FontFamily="Tajawal"
                               TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                    </VerticalStackLayout>

                    <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center" HorizontalOptions="End">
                        <components:AppIcon Icon="Clock"
                                            FontSize="12"
                                            TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                                            VerticalOptions="Center" />
                        <Label Text="{Binding PublishTimeText}"
                               FontSize="12"
                               FontFamily="Tajawal"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- band 5 (border-top): 3 source-native fact minis + unread indicator inline-end. -->
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" />
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="0,16,0,0">
                    <HorizontalStackLayout Grid.Column="0" Spacing="24" VerticalOptions="Center">
                        <!-- الميزانية — accent state green (never brand), LTR-isolated only for "$". -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="الميزانية" FontSize="11" FontFamily="Tajawal"
                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                            <Label Text="{Binding Budget}"
                                   FontSize="13"
                                   FontFamily="TajawalBold"
                                   FlowDirection="{Binding BudgetIsForeignCurrency, Converter={StaticResource BoolToFlowDirectionConverter}}"
                                   TextColor="{AppThemeBinding Light=#2E9E6B, Dark=#4FBF8C}" />
                        </VerticalStackLayout>

                        <!-- مدة التسليم — Mostaql-trio only (Nafezly swaps it for the state row). -->
                        <VerticalStackLayout Spacing="4" IsVisible="{Binding ShowsDeliveryFact}">
                            <Label Text="مدة التسليم" FontSize="11" FontFamily="Tajawal"
                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                            <Label Text="{Binding Delivery}"
                                   AutomationId="ProjectCard_ExecutionLabel"
                                   FontSize="13"
                                   FontFamily="TajawalBold"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                        </VerticalStackLayout>

                        <!-- عدد المقترحات (mostaql) / العروض المقدمة (nafezly) — label is source-native. -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding ProposalFactLabel}" FontSize="11" FontFamily="Tajawal"
                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                            <Label Text="{Binding ProposalCountText}"
                                   FontSize="13"
                                   FontFamily="TajawalBold"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                        </VerticalStackLayout>

                        <!-- حالة المشروع — presence-by-data (nafezly listing carries a scraped state;
                             mostaql rows render no status block at all). Never a source-id check. -->
                        <VerticalStackLayout Spacing="4" IsVisible="{Binding HasStatusText}">
                            <Label Text="حالة المشروع" FontSize="11" FontFamily="Tajawal"
                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                            <Label Text="{Binding StatusText}"
                                   FontSize="13"
                                   FontFamily="TajawalBold"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Unread indicator inline-end: 8px brand dot + bold brand-ink "غير مقروء"; read → nothing. -->
                    <HorizontalStackLayout Grid.Column="2"
                                           Spacing="6"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center"
                                           IsVisible="{Binding IsUnread}">
                        <BoxView WidthRequest="8" HeightRequest="8"
                                 Color="{DynamicResource Brand}"
                                 CornerRadius="4"
                                 VerticalOptions="Center" />
                        <Label Text="غير مقروء" FontSize="12" FontFamily="TajawalBold"
                               VerticalOptions="Center"
                               TextColor="{DynamicResource BrandInk}" />
                    </HorizontalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentView>

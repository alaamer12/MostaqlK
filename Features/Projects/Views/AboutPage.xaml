<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sidebar="clr-namespace:MostaqlK.UI.PlatformComponents.AppSidebar"
             x:Class="MostaqlK.Features.Projects.Views.AboutPage"
             Title="حول التطبيق"
             FlowDirection="RightToLeft">

    <!-- Rebuilt to mirror about.html: shared sidebar (AppSidebar) + header bar + identity card
         (M logo, name, version pill, description) + "quick facts" list + "version scope"
         roadmap list (v1 current / v2 upcoming / v3 future). -->
    <Grid BackgroundColor="#F1F5F9" ColumnDefinitions="Auto,*">

        <sidebar:AppSidebar Grid.Column="0"
                             ActivePage="About"
                             ProjectsClicked="OnProjectsNavClicked"
                             AdvancedSearchClicked="OnAdvancedSearchNavClicked"
                             NotificationsClicked="OnNotificationsNavClicked"
                             SettingsClicked="OnSettingsNavClicked"
                             AboutClicked="OnAboutNavClicked" />

        <Grid Grid.Column="1" RowDefinitions="32,Auto,*" Padding="24,20,24,24" RowSpacing="16">
            <BoxView Grid.Row="0" BackgroundColor="Transparent" InputTransparent="True" />

            <Border Grid.Row="1" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="16,12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label Text="حول التطبيق" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />
            </Border>

            <ScrollView Grid.Row="2">
                <VerticalStackLayout Spacing="16">

                    <!-- Identity card -->
                    <Border Padding="24" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" HorizontalOptions="Fill">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Border WidthRequest="64" HeightRequest="64" StrokeThickness="0" BackgroundColor="#3B82F6" HorizontalOptions="Center">
                                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                                <Label Text="M" TextColor="White" FontAttributes="Bold" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="Mostaqlk" FontSize="20" FontAttributes="Bold" TextColor="#0F172A" HorizontalTextAlignment="Center" />
                            <Border Padding="12,4" BackgroundColor="#F1F5F9" StrokeThickness="0" HorizontalOptions="Center">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                <Label x:Name="VersionLabel" FontSize="11" TextColor="#94A3B8" />
                            </Border>
                            <Label Text="تطبيق سطح مكتب لنظام Windows يراقب صفحة المشاريع المفتوحة في مستقل وينبّهك خلال دقيقة تقريبًا من نشر مشروع جديد، مع حفظ كامل تفاصيله محليًا للرجوع إليها لاحقًا دون اتصال."
                                   FontSize="13" TextColor="#475569" HorizontalTextAlignment="Center" MaximumWidthRequest="420" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Quick facts -->
                    <Border Padding="0" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <VerticalStackLayout>
                            <Label Text="حقائق سريعة" FontSize="14" FontAttributes="Bold" TextColor="#0F172A" Padding="20,14,20,10" />
                            <BoxView HeightRequest="1" BackgroundColor="#F1F5F9" />

                            <Grid ColumnDefinitions="*,Auto" Padding="20,12">
                                <Label Text="المنصة" TextColor="#64748B" FontSize="13" />
                                <Label Grid.Column="1" Text="تطبيق سطح مكتب لنظام Windows (مقيم في شريط المهام)" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" />
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="#F1F5F9" />

                            <Grid ColumnDefinitions="*,Auto" Padding="20,12">
                                <Label Text="التخزين" TextColor="#64748B" FontSize="13" />
                                <Label Grid.Column="1" Text="قاعدة بيانات محلية مُضمَّنة — بلا خادم أو سحابة" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" />
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="#F1F5F9" />

                            <Grid ColumnDefinitions="*,Auto" Padding="20,12">
                                <Label Text="حد الطلبات" TextColor="#64748B" FontSize="13" />
                                <Label Grid.Column="1" Text="قابل للتعديل — الافتراضي ~2 طلب/دقيقة" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" />
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="#F1F5F9" />

                            <Grid ColumnDefinitions="*,Auto" Padding="20,12">
                                <Label Text="سياسة البيانات" TextColor="#64748B" FontSize="13" />
                                <Label Grid.Column="1" Text="يُجلب المشروع مرة واحدة ولا يُحدَّث لاحقًا" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" />
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="#F1F5F9" />

                            <Grid ColumnDefinitions="*,Auto" Padding="20,12">
                                <Label Text="اللغة" TextColor="#64748B" FontSize="13" />
                                <Label Grid.Column="1" Text="العربية أساسًا، مع دعم كامل للإنجليزية في البحث" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Version scope -->
                    <Border Padding="0" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <VerticalStackLayout>
                            <Label Text="نطاق الإصدارات" FontSize="14" FontAttributes="Bold" TextColor="#0F172A" Padding="20,14,20,10" />
                            <BoxView HeightRequest="1" BackgroundColor="#F1F5F9" />

                            <VerticalStackLayout Padding="20,14" Spacing="4">
                                <HorizontalStackLayout Spacing="8">
                                    <Ellipse Fill="#2E9E6B" WidthRequest="8" HeightRequest="8" VerticalOptions="Center" />
                                    <Label Text="v1 — الإصدار الحالي (MVP)" FontSize="13" FontAttributes="Bold" TextColor="#0F172A" />
                                </HorizontalStackLayout>
                                <Label Text="فحص ← اكتشاف ← إثراء ← تخزين ← تنبيه، مع نافذة أساسية وشريط مهام. الإعداد الوحيد المتاح حاليًا هو استعلام الفحص (query_params)."
                                       FontSize="11" TextColor="#64748B" Margin="16,0,0,0" />
                            </VerticalStackLayout>
                            <BoxView HeightRequest="1" BackgroundColor="#F1F5F9" />

                            <VerticalStackLayout Padding="20,14" Spacing="4">
                                <HorizontalStackLayout Spacing="8">
                                    <Ellipse Fill="#CBD5E1" WidthRequest="8" HeightRequest="8" VerticalOptions="Center" />
                                    <Label Text="v2 — قادم" FontSize="13" FontAttributes="Bold" TextColor="#94A3B8" />
                                </HorizontalStackLayout>
                                <Label Text="تنزيل المرفقات، تجميع التنبيهات، تمييز المقروء/غير المقروء، بحث نصي كامل، ومُنشئ استعلامات متقدم."
                                       FontSize="11" TextColor="#94A3B8" Margin="16,0,0,0" />
                            </VerticalStackLayout>
                            <BoxView HeightRequest="1" BackgroundColor="#F1F5F9" />

                            <VerticalStackLayout Padding="20,14" Spacing="4">
                                <HorizontalStackLayout Spacing="8">
                                    <Ellipse Fill="#CBD5E1" WidthRequest="8" HeightRequest="8" VerticalOptions="Center" />
                                    <Label Text="v3 — مستقبلي" FontSize="13" FontAttributes="Bold" TextColor="#94A3B8" />
                                </HorizontalStackLayout>
                                <Label Text="تطبيق مرافق للجوال، مزامنة عبر الشبكة المحلية، وتنبيهات push."
                                       FontSize="11" TextColor="#94A3B8" Margin="16,0,0,0" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="مستقل" FontSize="13" TextColor="#2386C8" TextDecorations="Underline" HorizontalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMostaqlLinkTapped" />
                        </Label.GestureRecognizers>
                    </Label>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>

</ContentPage>

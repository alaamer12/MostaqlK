<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:MostaqlK.UI.PlatformComponents"
             xmlns:design="clr-namespace:MostaqlK.UI.DesignSystem"
             xmlns:vm="clr-namespace:MostaqlK.Features.Projects.ViewModels"
             xmlns:models="clr-namespace:MostaqlK.Models"
             xmlns:sidebar="clr-namespace:MostaqlK.UI.PlatformComponents.AppSidebar"
             x:Class="MostaqlK.Features.Projects.Views.ProjectDetailsPage"
             x:DataType="vm:ProjectDetailsViewModel"
             Title="تفاصيل المشروع"
             FlowDirection="RightToLeft">

    <!-- Mirrors project-details.html: shared sidebar (AppSidebar) + title/description, skills
         chips, budget/duration/owner stats, and an attachments list with per-item download
         status/action wired to AssetDownloadService via ProjectDetailsViewModel. Uses
         Grid/ScrollView so it adapts across window sizes instead of fixed pixel widths. -->
    <Grid ColumnDefinitions="Auto,*" BackgroundColor="#F1F5F9">

        <sidebar:AppSidebar Grid.Column="0"
                             ActivePage="Projects"
                             ProjectsClicked="OnProjectsNavClicked"
                             AdvancedSearchClicked="OnAdvancedSearchNavClicked"
                             NotificationsClicked="OnNotificationsNavClicked"
                             SettingsClicked="OnSettingsNavClicked"
                             AboutClicked="OnAboutNavClicked" />

        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" Padding="28,20,28,8" ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Text="رجوع" Clicked="OnProjectsNavClicked"
                        BackgroundColor="Transparent" TextColor="#475569" Padding="0" />
                <Label Grid.Column="1" Text="تفاصيل المشروع" FontSize="22" FontAttributes="Bold"
                       TextColor="#0F172A" HorizontalOptions="Center" VerticalOptions="Center" />
                <Label Grid.Column="2" Text="المشاريع" FontSize="13" TextColor="#64748B"
                       VerticalOptions="Center" />
            </Grid>

        <!-- Loading state -->
        <VerticalStackLayout Grid.Row="1" Padding="28,24" Spacing="12" IsVisible="{Binding IsLoading}">
            <design:ShimmerBox HeightRequest="32" />
            <design:ShimmerBox HeightRequest="120" />
            <design:ShimmerBox HeightRequest="60" />
        </VerticalStackLayout>

        <!-- Error state -->
        <design:LabelWithSubText IsVisible="{Binding HasError}"
                                  Grid.Row="1" VerticalOptions="Center"
                                  Text="{Binding ErrorMessage}"
                                  SubText="تعذر تحميل تفاصيل المشروع." />

        <!-- Success state -->
        <ScrollView Grid.Row="1" IsVisible="{Binding ShowDetails}">
            <Grid Padding="28,16,28,28" ColumnDefinitions="2*,*" ColumnSpacing="20" x:DataType="vm:ProjectDetailsViewModel">
                <VerticalStackLayout Grid.Column="0" Spacing="16">
                    <Border Padding="22" BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Details.Title}" FontSize="24" FontAttributes="Bold" TextColor="#0F172A" />
                                <Border Grid.Column="1" BackgroundColor="#ECFDF5" Padding="10,5" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <Label Text="تم الإثراء" TextColor="#2E9E6B" FontSize="12" FontAttributes="Bold" />
                                </Border>
                            </Grid>
                            <Label Text="{Binding Details.EnrichedAt, StringFormat='آخر تحديث: {0:yyyy/MM/dd HH:mm}'}" FontSize="12" TextColor="#64748B" />
                            <BoxView HeightRequest="1" Color="#E2E8F0" />
                            <Label Text="{Binding Details.Description}" FontSize="15" TextColor="#334155" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Padding="22" BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="14">
                            <Label Text="تفاصيل المشروع" FontSize="18" FontAttributes="Bold" TextColor="#0F172A" />
                            <Label Text="المهارات المطلوبة" FontSize="14" FontAttributes="Bold" TextColor="#475569" />
                            <FlexLayout BindableLayout.ItemsSource="{Binding Skills}" Wrap="Wrap" Direction="Row">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ProjectSkill">
                            <Border Padding="10,5" Margin="0,0,8,8" BackgroundColor="#EFF6FF" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                <Label Text="{Binding Name}" FontSize="12" TextColor="#2563EB" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                            </FlexLayout>
                            <Label Text="المرفقات" FontSize="14" FontAttributes="Bold" TextColor="#475569" />
                <CollectionView ItemsSource="{Binding Attachments}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:AttachmentItemViewModel">
                            <Grid ColumnDefinitions="*,Auto" Padding="0,8" RowDefinitions="Auto,Auto">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding FileName}" FontSize="14" TextColor="#0F172A" />
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding StatusMessage}" FontSize="11" TextColor="#64748B" LineBreakMode="WordWrap" />
                                <components:AppButton Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                                       Text="تحميل"
                                                       Command="{Binding ResolveCommand}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
                <Border Grid.Column="1" Padding="22" BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" VerticalOptions="Start">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="18">
                        <Label Text="معلومات المشروع" FontSize="18" FontAttributes="Bold" TextColor="#0F172A" />
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
                            <Label Text="الميزانية" TextColor="#64748B" /><Label Grid.Column="1" Text="{Binding Details.Budget}" FontAttributes="Bold" TextColor="#0F172A" />
                            <Label Grid.Row="1" Text="مدة التسليم" TextColor="#64748B" /><Label Grid.Row="1" Grid.Column="1" Text="{Binding Details.DeliveryDays, StringFormat='{0} يوم'}" FontAttributes="Bold" TextColor="#0F172A" />
                            <Label Grid.Row="2" Text="العميل" TextColor="#64748B" /><Label Grid.Row="2" Grid.Column="1" Text="{Binding Details.Owner.Name}" FontAttributes="Bold" TextColor="#0F172A" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#E2E8F0" />
                        <Label Text="{Binding Details.Owner.HiringRatePercent, StringFormat='معدل التوظيف: {0}%'}" FontSize="13" TextColor="#64748B" />
                        <Label Text="{Binding Details.Owner.CompletedProjectsCount, StringFormat='{0} مشروع منجز'}" FontSize="13" TextColor="#64748B" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ScrollView>

        </Grid>
    </Grid>

</ContentPage>

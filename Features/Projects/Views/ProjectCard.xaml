<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:MostaqlK.UI.PlatformComponents"
             xmlns:vm="clr-namespace:MostaqlK.Features.Projects.ViewModels"
             x:Class="MostaqlK.Features.Projects.Views.ProjectCard"
             x:DataType="vm:ProjectCardViewModel"
             FlowDirection="RightToLeft">

    <!-- Dense project card matching projects.html structure. -->
    <components:AppCard IsUnread="{Binding IsUnread}" Margin="0,0,0,16" Padding="24">
        <VerticalStackLayout Spacing="0">

            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding SelectCommand}" />
            </VerticalStackLayout.GestureRecognizers>

            <!-- Title + enrichment badge -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,11">
                <Label Grid.Column="0"
                       Text="{Binding Title}"
                       FontSize="20"
                       LineHeight="1.6"
                       FontAttributes="Bold"
                       TextColor="#0F172A"
                       LineBreakMode="WordWrap" />

                <Border Grid.Column="1"
                        StrokeThickness="0"
                        Padding="10,4"
                        VerticalOptions="Start"
                        BackgroundColor="{Binding EnrichmentBadgeBackground}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <Label Text="{Binding EnrichmentBadgeText}"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{Binding EnrichmentBadgeForeground}" />
                </Border>
            </Grid>

            <!-- Description (2 lines) -->
            <Label Text="{Binding Description}"
                   FontSize="14"
                   LineHeight="1.45"
                   TextColor="#475569"
                   MaxLines="2"
                   LineBreakMode="TailTruncation"
                   Margin="0,0,0,13" />

            <!-- Skill pills -->
            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding SkillItems}"
                                   Spacing="0"
                                   Margin="0,0,0,13">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:SkillTagItem">
                        <Border StrokeThickness="0"
                                BackgroundColor="#EFF6FF"
                                Padding="10,4"
                                Margin="0,0,8,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="6" />
                            </Border.StrokeShape>
                            <Label Text="{Binding Name}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#2563EB" />
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>

            <!-- Divider -->
            <BoxView HeightRequest="1" Color="#F1F5F9" Margin="0,0,0,13" />

            <!-- Client info row -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,0,0,13">
                <Border Grid.Column="0"
                        WidthRequest="40"
                        HeightRequest="40"
                        StrokeThickness="0"
                        BackgroundColor="#3B82F6"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Label Text="{Binding ClientInitials}"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="13"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="{Binding ClientName}"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />
                    <Label Text="{Binding ClientMeta}"
                           FontSize="11"
                           TextColor="#64748B" />
                </VerticalStackLayout>

                <Label Grid.Column="2"
                       Text="{Binding PostedRelative}"
                       FontSize="11"
                       TextColor="#94A3B8"
                       VerticalOptions="Center" />
            </Grid>

            <!-- Divider -->
            <BoxView HeightRequest="1" Color="#F1F5F9" Margin="0,0,0,13" />

            <!-- Stats grid: 4 columns + unread -->
            <Grid ColumnDefinitions="*,*,*,*,Auto" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="الميزانية" FontSize="11" TextColor="#64748B" />
                    <Label Text="{Binding Budget}" FontSize="13" FontAttributes="Bold" TextColor="#16A34A" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="مدة التسليم" FontSize="11" TextColor="#64748B" />
                    <Label Text="{Binding Delivery}" FontSize="13" FontAttributes="Bold" TextColor="#0F172A" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" Spacing="2">
                    <Label Text="مدة التنفيذ" FontSize="11" TextColor="#64748B" />
                    <Label Text="{Binding Execution}" FontSize="13" FontAttributes="Bold" TextColor="#0F172A" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="3" Spacing="2">
                    <Label Text="عدد المقترحات" FontSize="11" TextColor="#64748B" />
                    <Label Text="{Binding ProposalCountText}" FontSize="13" FontAttributes="Bold" TextColor="#0F172A" />
                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Column="4"
                                       Spacing="6"
                                       VerticalOptions="End"
                                       IsVisible="{Binding IsUnread}">
                    <BoxView WidthRequest="8"
                             HeightRequest="8"
                             Color="#2386C8"
                             CornerRadius="4"
                             VerticalOptions="Center" />
                    <Label Text="غير مقروء" FontSize="11" FontAttributes="Bold" TextColor="#2386C8" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>

        </VerticalStackLayout>
    </components:AppCard>

</ContentView>

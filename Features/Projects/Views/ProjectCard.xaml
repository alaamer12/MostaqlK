<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:MostaqlK.UI.PlatformComponents"
             xmlns:vm="clr-namespace:MostaqlK.Features.Projects.ViewModels"
             x:Class="MostaqlK.Features.Projects.Views.ProjectCard"
             x:DataType="vm:ProjectCardViewModel"
             FlowDirection="RightToLeft">

    <!-- Reflects the unread/read project card from projects.html: AppCard's real IsUnread
         accent-border state, bold title while unread, muted style once read. Tapping the card
         marks it as read and navigates to ProjectDetailsPage via the feed's SelectProjectCommand
         (BindingContextChanged supplies the feed VM through the CollectionView item, so the
         command itself is bound from the page-level SelectProjectCommand target). -->
    <components:AppCard Padding="16" Margin="0,0,0,12" IsUnread="{Binding IsUnread}">
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding SelectCommand}" CommandParameter="{Binding .}" />
            </Grid.GestureRecognizers>

            <Label Grid.Row="0"
                    Text="{Binding Title}"
                    FontSize="16">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsUnread}" Value="True">
                        <Setter Property="FontAttributes" Value="Bold" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <Label Grid.Row="1"
                    Text="{Binding ClientName}"
                    FontSize="13"
                    TextColor="Gray" />

            <HorizontalStackLayout Grid.Row="2" Spacing="12">
                <Label Text="{Binding PostedRelative}" FontSize="12" TextColor="Gray" />
                <Label Text="{Binding ProposalCount, StringFormat='{0} عرض'}" FontSize="12" TextColor="Gray" />
            </HorizontalStackLayout>

        </Grid>
    </components:AppCard>

</ContentView>

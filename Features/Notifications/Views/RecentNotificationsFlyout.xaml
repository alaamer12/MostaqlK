<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MostaqlK.Features.Notifications.ViewModels"
             xmlns:models="clr-namespace:MostaqlK.Models"
             x:Class="MostaqlK.Features.Notifications.Views.RecentNotificationsFlyout"
             x:Name="RootView"
             x:DataType="vm:NotificationCenterViewModel"
             FlowDirection="RightToLeft">

    <!-- Flyout listing recently discovered projects, opened from the "التنبيهات" sidebar
         entry in projects.html (badge count = UnreadBadgeCount). -->
    <Border Padding="12" StrokeShape="RoundRectangle 8" WidthRequest="320">
        <Border.Shadow>
            <Shadow Brush="Black" Opacity="0.15" Radius="8" Offset="0,2" />
        </Border.Shadow>
        <VerticalStackLayout Spacing="8">
            <Label Text="التنبيهات" FontSize="16" FontAttributes="Bold" />

            <CollectionView ItemsSource="{Binding RecentNotifications}" HeightRequest="360">
                <CollectionView.EmptyView>
                    <Label Text="لا توجد إشعارات حديثة" FontSize="13" TextColor="Gray" HorizontalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ProjectSummary">
                        <VerticalStackLayout Padding="6" Spacing="2">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.OpenProjectCommand, Source={x:Reference RootView}}"
                                    CommandParameter="{Binding .}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="{Binding Title}" FontSize="14" />
                            <Label Text="{Binding PostedRelative}" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </Border>

</ContentView>
